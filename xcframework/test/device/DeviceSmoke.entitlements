<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A 2B model on the CPU holds its repacked weights and a 500 MiB
	     compute buffer in anonymous memory: past the default limit, the app
	     is killed with signal 9 on the first prompt (README, "Memory"). -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
