#!/bin/bash
# Starts two mock hubs (harness/server/mock_hub.py), one per side, over the
# files and repositories hub.cases downloads (Stage 10 step 7), and names
# them MOCK_REF and MOCK_PORT in $DATA/setup.env. Run by
# scripts/server-diff, which kills what $DATA/pids lists at the end.
set -eu
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
FIX="$ROOT/zig-out/arch-fixtures/llama-dense.gguf"
FIX2="$ROOT/zig-out/arch-fixtures/qwen3-dense.gguf"
MM="$ROOT/zig-out/mmproj-fixtures"

h="$DATA/hub"
mkdir -p "$h/files" "$h/repos/test/tiny" "$h/repos/test/vision" "$h/repos/test/split" \
         "$h/repos/test/empty" "$h/repos/test/preset" "$h/repos/test/nested/sub" "$h/repos/test/badref"
for n in tiny tiny2 tiny3 tiny4 tiny5 tiny6 tiny7 p1 p2 p3 p4 p5 p6 r1 r2 r3 lk; do cp "$FIX" "$h/files/$n.gguf"; done
cp "$MM/gemma3.gguf" "$h/files/mmproj.gguf"
cp "$FIX" "$h/files/parts-00001-of-00002.gguf"
cp "$FIX" "$h/files/parts-00002-of-00002.gguf"
cp "$FIX" "$h/repos/test/tiny/tiny-Q4_K_M.gguf"
cp "$FIX2" "$h/repos/test/tiny/tiny-Q8_0.gguf"
printf '# tiny\n' > "$h/repos/test/tiny/README.md"
cp "$FIX" "$h/repos/test/vision/model-Q4_K_M.gguf"
cp "$MM/gemma3.gguf" "$h/repos/test/vision/mmproj-model-f16.gguf"
cp "$FIX" "$h/repos/test/split/big-Q8_0-00001-of-00002.gguf"
cp "$FIX" "$h/repos/test/split/big-Q8_0-00002-of-00002.gguf"
printf '# nothing here\n' > "$h/repos/test/empty/README.md"
cp "$FIX" "$h/repos/test/nested/sub/deep-Q4_K_M.gguf"
mkdir -p "$h/repos/test/slowpoke"
cp "$FIX" "$h/repos/test/slowpoke/slow-Q4_K_M.gguf"
# v0.8.0: a repository with every sidecar kind, one tag's draft shared by
# name with no other, and two tags sharing a projector
mkdir -p "$h/repos/test/side" "$h/repos/test/slowside" "$h/repos/test/shared"
cp "$FIX" "$h/repos/test/side/side-Q4_K_M.gguf"
cp "$MM/gemma3.gguf" "$h/repos/test/side/mmproj-side-f16.gguf"
for k in mtp dflash eagle3 dspark; do cp "$FIX" "$h/repos/test/side/$k-side-Q4_K_M.gguf"; done
cp "$FIX" "$h/repos/test/slowside/slow-Q4_K_M.gguf"
cp "$MM/gemma3.gguf" "$h/repos/test/slowside/mmproj-slow-f16.gguf"
cp "$FIX" "$h/repos/test/shared/shared-Q4_K_M.gguf"
cp "$FIX2" "$h/repos/test/shared/shared-Q8_0.gguf"
cp "$MM/gemma3.gguf" "$h/repos/test/shared/mmproj-shared-f16.gguf"
cat > "$h/repos/test/preset/preset.ini" <<INI
[from-hub]
model = $FIX
ctx-size = 256
INI
# refs with nothing usable: a branch escaping refs/, a commit that is not one
cat > "$h/repos/test/badref.refs" <<JSON
{"branches": [{"name": "../escape", "targetCommit": "0123456789012345678901234567890123456789"},
              {"name": "dev", "targetCommit": "not-a-commit"},
              {"name": 7},
              {"name": "../both", "targetCommit": "neither"}]}
JSON

# a preset over a cached model, hiding its cache entry
cat > "$DATA/dedup.ini" <<INI
[tiny-preset]
hf-repo = test/tiny:Q4_K_M
dedup-cache-models = 1
[tiny-plain]
hf-repo = test/tiny:Q8_0
# v0.5.0: the draft model's repository is deduplicated too
[tiny-draft]
model = $FIX
spec-draft-hf = test/tiny:Q8_0
dedup-cache-models = 1
INI

# a repository whose only branch is nested: its ref is written to
# refs/release/v1, the directory made first (fs_write_atomic)
mkdir -p "$h/repos/test/nestedref"
cp "$FIX" "$h/repos/test/nestedref/nested-Q4_K_M.gguf"
cat > "$h/repos/test/nestedref.refs" <<JSON
{"branches": [{"name": "release/v1", "targetCommit": "89abcdef0123456789abcdef0123456789abcdef"}]}
JSON

# v0.6.0: a Hugging Face cache made by hand, read offline by the router's
# update_caps (server-models.cpp): a decision model's GGUF metadata makes
# its output modality "decisions", and a preset's hf-file now picks the
# file (LLAMA_ARG_HF_FILE). hub.cases copies it per side (!fresh hfcache)
GG="$ROOT/harness/server/router.gguf.py"
C=0123456789abcdef0123456789abcdef01234567
for r in judge vision; do
  mkdir -p "$DATA/hfcache/models--test--$r/refs" "$DATA/hfcache/models--test--$r/snapshots/$C"
  printf '%s' "$C" > "$DATA/hfcache/models--test--$r/refs/main"
done
cp "$FIX" "$DATA/hfcache/models--test--judge/snapshots/$C/judge-Q4_K_M.gguf"
python3 "$GG" "$FIX" "$DATA/hfcache/models--test--judge/snapshots/$C/judge-Q8_0.gguf" '{arch}.decision.type=arch-str:nimble'
cp "$FIX" "$DATA/hfcache/models--test--vision/snapshots/$C/model-Q4_K_M.gguf"
cp "$MM/gemma3.gguf" "$DATA/hfcache/models--test--vision/snapshots/$C/mmproj-model-f16.gguf"
cat > "$DATA/judge.ini" <<INI
[judge-q8]
hf-repo = test/judge
hf-file = judge-Q8_0.gguf
[judge-default]
hf-repo = test/judge
[vision-plain]
hf-repo = test/vision
no-mmproj = 1
INI
# v0.6.0: a model the router cannot resolve offline (update_caps logs it
# and keeps the text default) until its child has downloaded and loaded it
# -- with the projector, which the child reports (update_status)
cat > "$DATA/byurl.ini" <<INI
[byurl]
model = byurl.gguf
ctx-size = 256
INI

: > "$DATA/pids"
for side in ref port; do
  python3 "$ROOT/harness/server/mock_hub.py" "$h" "$DATA/mock_$side.port" "$DATA/mock_$side.log" &
  echo $! >> "$DATA/pids"
done
for side in ref port; do
  for i in $(seq 1 100); do [ -f "$DATA/mock_$side.port" ] && break; sleep 0.05; done
done
{
  echo "MOCK_REF=http://127.0.0.1:$(cat "$DATA/mock_ref.port")"
  echo "MOCK_PORT=http://127.0.0.1:$(cat "$DATA/mock_port.port")"
} > "$DATA/setup.env"
