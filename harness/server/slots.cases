# Slots, their save/restore/erase actions, metrics and props (Stage 10
# step 3c): scripts/server-diff slots. Qwen3-0.6B, two slots; each side saves
# into its own working directory (--slot-save-path ./).
!mask (seconds_total|tokens_seconds) [0-9.e+-]+
!mask-key Process-Start-Time-Unix
!mask Process-Start-Time-Unix: [0-9]+
!server -m $QWEN3 -c 2048 -np 2 --no-jinja --metrics --props --slot-save-path ./ -lv 4
!fulllog

GET /slots
GET /metrics
POST /completion {"prompt": "Hello there, my name is", "n_predict": 6, "temperature": 0}
POST /completion {"prompt": "The capital of Spain is", "n_predict": 6, "temperature": 0, "id_slot": 0}
GET /slots
GET /metrics
POST /props {"anything": 1}
POST /slots/0?action=save {"filename": "s0.bin"}
POST /slots/1?action=save {"filename": "s1.bin"}
POST /slots/0?action=save {"filename": "../escape.bin"}
POST /slots/0?action=save {"filename": ""}
POST /slots/0?action=save {"name": "s0.bin"}
POST /slots/0?action=save not json
POST /slots/abc?action=save {"filename": "x.bin"}
POST /slots/0?action=bogus {"filename": "x.bin"}
POST /slots/0
POST /slots/7?action=erase
GET /slots
POST /slots/0?action=restore {"filename": "s1.bin"}
GET /slots
POST /completion {"prompt": "Hello there, my name is", "n_predict": 6, "temperature": 0, "id_slot": 0}
POST /slots/1?action=restore {"filename": "missing.bin"}
POST /slots/1?action=restore {"filename": "s0.bin"}
POST /slots/0?action=erase
POST /slots/1?action=erase
GET /slots
POST /completion {"prompt": "The capital of Spain is", "n_predict": 6, "temperature": 0, "id_slot": 1}
GET /slots?fail_on_no_slot=1
GET /metrics
GET /props

# the endpoints off
!server -m $QWEN3 -c 2048 -np 2 --no-jinja --no-slots -lv 4
!fulllog
GET /slots
POST /slots/0?action=save {"filename": "s0.bin"}
POST /props {}
GET /metrics

# v0.7.0 (#30567): with no slot named, an empty slot is taken before the
# least recently used one; children of an n_cmpl request save the states
# they overwrite to the prompt cache. --slot-save-path from its environment
# variable (#30272)
!env LLAMA_ARG_SLOT_SAVE_PATH=./
!server -m $QWEN3 -c 2048 -np 3 --no-jinja --slot-prompt-similarity 0 -lv 4
!fulllog
POST /completion {"prompt": "Alpha beta gamma", "n_predict": 2, "temperature": 0}
POST /completion {"prompt": "One two three", "n_predict": 2, "temperature": 0}
GET /slots
POST /completion {"prompt": "Red green blue", "n_predict": 2, "temperature": 0}
POST /completion {"prompt": "North south east", "n_predict": 2, "temperature": 0}
GET /slots
POST /slots/1?action=erase
POST /completion {"prompt": "Monday Tuesday", "n_predict": 2, "temperature": 0}
GET /slots
POST /completion {"prompt": "Once upon a time", "n_predict": 4, "temperature": 0, "n_cmpl": 3}
GET /slots
POST /slots/0?action=save {"filename": "env.bin"}
!noenv
