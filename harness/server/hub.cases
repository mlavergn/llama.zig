# Model downloads (Stage 10 step 7, common/download.cpp and hf-cache.cpp)
# against a plain-HTTP mock hub, one per side (hub.setup): the reference is
# built without SSL, so only plain HTTP downloads. $MOCK is each side's
# hub; downloads land in each side's own cache ($CWD/cache), never shared.
# !mocklog compares the requests each hub saw: the paths, Range,
# Authorization, User-Agent and Accept.
!env LLAMA_CACHE=$CWD/cache
!env MODEL_ENDPOINT=$MOCK
!mask "--port",\s+"\d+"
!mask load:   \d+$

# --- -mu alone is router mode: the server decides it has no model before
# the downloader would fill -m in (server.cpp:135), so nothing downloads
!server -mu $MOCK/files/tiny.gguf -c 256 -np 1
GET /models
!mocklog

# --- a URL (-mu) to the -m path, then from there
!server -m $CWD/dl/tiny.gguf -mu $MOCK/files/tiny.gguf -c 256 -np 1 -lv 4
!fulllog
GET /props
!mocklog
!server -m $CWD/dl/tiny.gguf -mu $MOCK/files/tiny.gguf -c 256 -np 1 -lv 4
!fulllog
!mocklog
# the server's ETag changed: downloaded again
!server -m $CWD/dl/tiny.gguf -mu $MOCK/etag/v2/tiny.gguf -c 256 -np 1 -lv 4
!fulllog
!mocklog
# the same ETag as saved: kept
!server -m $CWD/dl/tiny.gguf -mu $MOCK/etag/v2/tiny.gguf -c 256 -np 1 -lv 4
!mocklog
# no ETag: whatever is cached is kept
!server -m $CWD/dl/tiny.gguf -mu $MOCK/noetag/tiny.gguf -c 256 -np 1 -lv 4
!mocklog
# a projector by URL (-mmu) without -mm: into the cache directory
!server -m $CWD/dl/tiny.gguf -mmu $MOCK/files/mmproj.gguf -c 256 -np 1 -lv 4
!mocklog
# to the path -m names
!server -m $CWD/named.gguf -mu $MOCK/files/tiny2.gguf -c 256 -np 1 -lv 4
!fulllog
GET /props
!mocklog
# redirects are followed; no ranges; a split model's parts, all of them
!server -m $CWD/dl/tiny5.gguf -mu $MOCK/redirect/tiny5.gguf -c 256 -np 1
!mocklog
# cpp-httplib 0.60: the redirect's Location is followed as written, not
# percent-decoded first
!server -m $CWD/dl/tiny5e.gguf -mu $MOCK/redirect-esc/tiny5.gguf -c 256 -np 1
!mocklog
!server -m $CWD/dl/tiny4.gguf -mu $MOCK/noranges/tiny4.gguf -c 256 -np 1
!mocklog
!server -m $CWD/dl/parts-00001-of-00002.gguf -mu $MOCK/files/parts-00001-of-00002.gguf -c 256 -np 1
GET /props
!mocklog
# the first GET is cut short; the retry resumes with a Range
!server -m $CWD/dl/tiny3.gguf -mu $MOCK/flaky/tiny3.gguf -c 256 -np 1 -lv 4
!fulllog
!mocklog

# --- v0.8.0: a partial is kept, and resumed only when it can be. /trunc
# leaves half of p1 and its ETag; a changed ETag discards it
!server -m $CWD/dl/p1.gguf -mu $MOCK/trunc/p1.gguf -c 256 -np 1 -lv 4
!mocklog
!tree $CWD/dl
!server -m $CWD/dl/p1.gguf -mu $MOCK/etag/w1/p1.gguf -c 256 -np 1 -lv 4
!fulllog
!mocklog
!tree $CWD/dl
# the same ETag: resumed, from where it stopped
!server -m $CWD/dl/p2.gguf -mu $MOCK/trunc/p2.gguf -c 256 -np 1
!mocklog
!server -m $CWD/dl/p2.gguf -mu $MOCK/files/p2.gguf -c 256 -np 1 -lv 4
!fulllog
!mocklog
!tree $CWD/dl
# a server that answers the resume with 416, then one that ignores it
!server -m $CWD/dl/r1.gguf -mu $MOCK/trunc/r1.gguf -c 256 -np 1
!mocklog
!server -m $CWD/dl/r1.gguf -mu $MOCK/r416/r1.gguf -c 256 -np 1 -lv 4
!fulllog
!mocklog
!server -m $CWD/dl/r2.gguf -mu $MOCK/trunc/r2.gguf -c 256 -np 1
!mocklog
!server -m $CWD/dl/r2.gguf -mu $MOCK/norange200/r2.gguf -c 256 -np 1 -lv 4
!fulllog
!mocklog
!tree $CWD/dl
# another process holds the file's lock: this one waits, then finds it
!lock $CWD/dl/lk.gguf.lock 12
!server -m $CWD/dl/lk.gguf -mu $MOCK/files/lk.gguf -c 256 -np 1 -lv 4
!fulllog
!mocklog

# --- v0.8.0: HTTP_PROXY, the absolute-form target; its credentials go to the
# proxy; loopback and NO_PROXY go direct; a malformed one is ignored
!env HTTP_PROXY=$MOCK
!server -m $CWD/dl/p3.gguf -mu http://example.invalid/files/p3.gguf -c 256 -np 1
!mocklog
# an HTTP_PROXY set empty would shadow the lower-case name, so it goes altogether
!noenv
!env LLAMA_CACHE=$CWD/cache
!env MODEL_ENDPOINT=$MOCK
!env http_proxy=http://user:secret@$MOCKADDR
!server -m $CWD/dl/p4.gguf -mu http://example.invalid:8080/files/p4.gguf -c 256 -np 1
!mocklog
!env http_proxy=
!env HTTP_PROXY=http://127.0.0.1:1
!server -m $CWD/dl/p5.gguf -mu $MOCK/files/p5.gguf -c 256 -np 1 -lv 4
!mocklog
!env NO_PROXY=example.invalid,.other
!server -m $CWD/dl/p6.gguf -mu http://a.example.invalid/files/p6.gguf -c 256 -np 1
!env HTTP_PROXY=notaurl
!env NO_PROXY=
!server -m $CWD/dl/p6.gguf -mu http://127.0.0.1:1/files/p6.gguf -c 256 -np 1
!server -m $CWD/dl/p6.gguf -mu http://x.invalid/files/p6.gguf -c 256 -np 1 -lv 4
!env HTTP_PROXY=
!mocklog

# --- downloads that fail
!server -m $CWD/dl/404 -mu $MOCK/status/404 -c 256 -np 1
!mocklog
!server -m $CWD/dl/tiny6.gguf -mu $MOCK/trunc/tiny6.gguf -c 256 -np 1 -lv 4
!mocklog
!server -m $CWD/dl/tiny7.gguf -mu $MOCK/headonly/tiny7.gguf -c 256 -np 1 -lv 4
!mocklog
!server -m $CWD/dl/model.gguf -mu https://example.invalid/model.gguf -c 256 -np 1
!server -m $CWD/dl/model.gguf -mu ftp://example.invalid/model.gguf -c 256 -np 1
!server -m $CWD/dl/notaurl -mu notaurl -c 256 -np 1
!server -m $CWD/dl/model.gguf -mu http://127.0.0.1:1/model.gguf -c 256 -np 1
!server -m $CWD/dl/model.gguf -mu http://[::1/model.gguf -c 256 -np 1
!server -m $CWD/dl/model.gguf -mu http://127.0.0.1:notaport/model.gguf -c 256 -np 1
!server -m $CWD/dl/never.gguf --offline -mu $MOCK/files/never.gguf -c 256 -np 1
!server -m $CWD/dl/tiny.gguf --offline -mu $MOCK/files/tiny.gguf -c 256 -np 1
!mocklog
!server -dr ai/smollm2 -c 256 -np 1

# --- a hub repository (-hf) through MODEL_ENDPOINT
!server -hf test/tiny -c 256 -np 1 -lv 4
!fulllog
GET /props
!mocklog
!server -hf test/tiny:Q8_0 -c 256 -np 1 -lv 4
!fulllog
GET /props
!mocklog
!server -hf test/tiny -hff tiny-Q8_0.gguf -c 256 -np 1
!mocklog
!server -hf test/tiny:q4_k_m --offline -c 256 -np 1 -lv 4
!fulllog
!mocklog
!server -hf test/split -c 256 -np 1
!mocklog
!server -hf test/nested -c 256 -np 1
!mocklog
!server -hf test/tiny:Q5_0 -c 256 -np 1
!server -hf test/tiny -hff nope.gguf -c 256 -np 1
!server -hf test/empty -c 256 -np 1
!server -hf test/nope -c 256 -np 1
!server -hf test/badref -c 256 -np 1 -lv 4
!server -hf test/nestedref -c 256 -np 1 -lv 4
!fulllog
GET /props
!mocklog
!server -hf notarepo -c 256 -np 1
!server -hf a/b/c -c 256 -np 1
!server -hf test/tiny -hft hf_short -c 256 -np 1
!mocklog
!server -hf test/tiny -hft hf_0123456789abcdefghijklmnopqrstuvwxyzABCD -c 256 -np 1
!mocklog
# the default endpoint is https://huggingface.co/, which needs SSL
!env MODEL_ENDPOINT=
!server -hf test/tiny:Q2_K -c 256 -np 1
!env HF_ENDPOINT=$MOCK
!server -hf test/tiny -c 256 -np 1
!mocklog
!env MODEL_ENDPOINT=$MOCK

# --- a preset repository: the server becomes a router over its preset.ini
!server -hf test/preset -lv 4
!fulllog
GET /models
GET /props
!mocklog

# --- the router over what the cache holds
!server -c 256 -np 1 -lv 4
!fulllog
GET /models
!sse /models/sse
POST /models {"model":"test/vision"}
!waitfor /models "id":"test/vision:Q4_K_M"
!sseend
GET /models
POST /models {"model":"test/vision"}
POST /models {"model":""}
POST /models {}
POST /models {"model":"notarepo"}
POST /models {"model":"test/nope"}
!sleep 2
GET /models
POST /models/load {"model":"test/tiny:Q8_0"}
!waitfor /models "id":"test/tiny:Q8_0"[^{]*\{"value":"loaded"
GET /models
GET /props?model=test/tiny:Q8_0
POST /models/unload {"model":"test/tiny:Q8_0"}
!waitfor /models "id":"test/tiny:Q8_0"[^{]*\{"value":"unloaded"
# a download cancelled by an unload while it runs
!sse /models/sse
POST /models {"model":"test/slowpoke"}
!waitfor /models "id":"test/slowpoke"[^{]*\{"value":"downloading"
# both sides' children well into their ~15 s download before either is
# cancelled (each request goes to one side, then the other)
!mockwait GET /test/slowpoke/resolve
!sleep 1
POST /models/unload {"model":"test/slowpoke"}
!sleep 1
!sseend
GET /models
DELETE /models?model=test/vision:Q4_K_M
GET /models
DELETE /models?model=test/vision:Q4_K_M
DELETE /models
DELETE /models?model=test/split:Q8_0
GET /models
!mocklog

# --- v0.8.0: POST /models takes the sidecars to pull, by kind; GET /models
# reports the ones on disk; DELETE takes one off
!server -c 256 -np 1 -lv 4
!fulllog
POST /models {"model":"test/side","sidecars":["nope"]}
POST /models {"model":"test/side","sidecars":["mmproj","mtp"]}
!waitfor /models "id":"test/side:Q4_K_M"(?:(?!"id":).)*"value":"unloaded"
!tree $CWD/cache/models--test--side
GET /models
!mocklog
POST /models {"model":"test/side:Q4_K_M","sidecars":["dflash"]}
!waitfor /models "id":"test/side:Q4_K_M"(?:(?!"id":).)*"value":"unloaded"(?:(?!"id":).)*"dflash"
GET /models
DELETE /models?model=test/side:Q4_K_M&sidecar=nope
DELETE /models?model=test/side:Q4_K_M&sidecar=mtp
GET /models
DELETE /models?model=test/side:Q4_K_M&sidecar=mtp
# a sidecars value of the wrong type falls back to the default list
POST /models {"model":"test/empty","sidecars":3}
POST /models/load {"model":"test/side:Q4_K_M"}
!waitfor /models "id":"test/side:Q4_K_M"[^{]*\{"value":"loaded"
DELETE /models?model=test/side:Q4_K_M&sidecar=dflash
POST /models {"model":"test/side:Q4_K_M"}
POST /models/unload {"model":"test/side:Q4_K_M"}
!waitfor /models "id":"test/side:Q4_K_M"[^{]*\{"value":"unloaded"
!tree $CWD/cache/models--test--side
DELETE /models?model=test/side:Q4_K_M
!tree $CWD/cache/models--test--side
# a sidecar another tag loads stays with it
POST /models {"model":"test/shared:Q4_K_M"}
!waitfor /models "id":"test/shared:Q4_K_M"(?:(?!"id":).)*"value":"unloaded"
POST /models {"model":"test/shared:Q8_0"}
!waitfor /models "id":"test/shared:Q8_0"(?:(?!"id":).)*"value":"unloaded"
DELETE /models?model=test/shared:Q4_K_M
!tree $CWD/cache/models--test--shared
GET /models
# a preset or local model is not a download; a cached one downloads again
!mocklog

# --- v0.8.0: a download cancelled leaves its record and its partial file. A
# restarted router lists it as incomplete, and a POST resumes it; a DELETE
# drops its record and partial. The model and its projector download at once,
# so their two threads' lines come in either order
!droplog common_pull_file: download failed: Connection handling canceled
!droplog common_download_file_single_online: download failed after 3 attempts
!server -c 256 -np 1 -lv 4
!fulllog
POST /models {"model":"test/slowside"}
!waitfor /models "id":"test/slowside"[^{]*\{"value":"downloading"
GET /models
# one tag asked twice, and the same file under another tag
POST /models {"model":"test/slowside"}
POST /models {"model":"test/slowside:Q4_K_M"}
!mockwait GET /test/slowside/resolve
!sleep 1
POST /models/unload {"model":"test/slowside"}
!sleep 1
!tree $CWD/cache/models--test--slowside
GET /models
!mask "progress":\{[^}]*\}
!server -c 256 -np 1 -lv 4
!fulllog
GET /models
DELETE /models?model=test/slowside&sidecar=mmproj
GET /models
DELETE /models?model=test/slowside
GET /models
DELETE /models?model=test/slowside
!tree $CWD/cache/models--test--slowside
!mocklog

# --- presets over cached models; one hides its cache entry
!server --models-preset $DATA/dedup.ini -c 256 -np 1 -lv 4
!fulllog
GET /models

# --- v0.6.0: the cache directory is a path. LLAMA_CACHE is taken as it is,
# so a file there fails without a separator added to its name
!env LLAMA_CACHE=$DATA/hub/files/tiny.gguf
!server -m $CWD/dl/tiny.gguf -mmu $MOCK/files/mmproj.gguf -c 256 -np 1
# and the platform's directory is joined as a path: a HOME ending in a
# separator does not double it
!env LLAMA_CACHE=
!env XDG_CACHE_HOME=
!env HOME=$CWD/home/
!server -m $CWD/dl/tiny.gguf -mmu $MOCK/files/mmproj.gguf -c 256 -np 1 -lv 4
!fulllog
GET /props
!mocklog
# a HOME that is a file: the cache directory cannot be made, and the
# message names the path as joined
!env HOME=$DATA/hub/files/tiny.gguf
!server -m $CWD/dl/tiny.gguf -mmu $MOCK/files/mmproj.gguf -c 256 -np 1

# --- v0.6.0: input and output modalities resolved offline from a cache
# (hub.setup's hfcache): a decision model's metadata, a preset's hf-file,
# a preset's no-mmproj, and the router's --no-mmproj for every child
!noenv
!fresh hfcache
!env LLAMA_CACHE=$WORK
!env MODEL_ENDPOINT=$MOCK
!server --models-preset $DATA/judge.ini -c 256 -np 1 -lv 4
!fulllog
GET /models
!server --models-preset $DATA/judge.ini -c 256 -np 1 --no-mmproj
GET /models
!mocklog

# --- v0.6.0: the router's own -mu and -mmu reach every model's offline
# resolution (update_caps copies its model), which cannot find them: the
# text default until a child has downloaded and loaded them, when the
# child's own modalities replace it (update_status)
!noenv
!env LLAMA_CACHE=$CWD/cache
!env MODEL_ENDPOINT=$MOCK
!server --models-preset $DATA/byurl.ini -mu $MOCK/files/tiny.gguf -mmu $MOCK/files/mmproj.gguf -c 256 -np 1 -lv 4
!fulllog
GET /models
POST /models/load {"model":"byurl"}
!waitfor /models "id":"byurl"[^{]*\{"value":"loaded"
GET /models
!mocklog
POST /models/unload {"model":"byurl"}
!waitfor /models "id":"byurl"[^{]*\{"value":"unloaded"
GET /models
