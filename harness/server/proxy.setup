#!/bin/bash
# Starts proxy.cases' target (harness/server/proxy_target.py) for the run:
# its port as $TPORT, its pid in $DATA/pids for scripts/server-diff to stop.
set -eu
nohup python3 "$PWD/harness/server/proxy_target.py" "$DATA/tport" 3600 > "$DATA/target.log" 2>&1 &
echo $! >> "$DATA/pids"
for _ in $(seq 1 100); do
    [ -s "$DATA/tport" ] && break
    sleep 0.05
done
echo "TPORT=$(cat "$DATA/tport")" >> "$DATA/setup.env"
printf 'file bytes\n' > "$DATA/upload.txt"
