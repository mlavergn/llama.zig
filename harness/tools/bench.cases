# llama-bench against upstream's: scripts/tools-diff bench.
# What it measures is time: the masks keep every row's parameters and
# shape and drop the speeds, the test time and the samples, in all five
# output formats. It decodes random tokens, so the arch fixtures run here
# without a vocabulary. Not a case: `-hf`, which downloads upstream and
# fails there on the reference build's missing HTTPS; no downloader is
# ported, so the port prints only the final error.
!mask s/^[0-9]+\.[0-9]{2}\.[0-9]{3}\.[0-9]{3} /T /
!mask /^(T . )?ggml_metal_/d
!mask s/ +[0-9.naif+-]+ ± [0-9.naif+-]+ \|/ X ± X |/g
!mask s/"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z","[0-9]+","[0-9]+","[^"]*","[^"]*"$/TIMES/
!mask s/"(test_time|avg_ns|stddev_ns|avg_ts|stddev_ts)": ("[^"]*"|[0-9.e+naif-]+)/"\1": X/g
!mask s/"samples_(ns|ts)": \[[^]]*\]/"samples_\1": X/g
!mask s/'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z', '[0-9]+', '[0-9]+', '[^']*', '[^']*'\);$/TIMES);/
!mask s/^(llama_perf_context_print: +[a-z ]+ = ).*/\1X/
!mask s/reserve took [0-9.]+ ms/reserve took X ms/
!mask s/(load time|sample time|prompt eval time|eval time|total time) += .*/\1 = X/

