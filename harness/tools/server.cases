!fail -ngld x
!fail --spec-draft-model
!fail --spec-type bogus
!fail --spec-type ngram-mod,
!fail --spec-type
!fail --spec-type none,bogus --bogus
!fail --spec-type draft-mtp,ngram-mod --bogus
!fail --spec-ngram-mod-n-min 2000
