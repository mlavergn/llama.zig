!fail -td x
!fail -tbd x
!fail -Crd
!fail --spec-draft-cpu-strict x
!fail --spec-draft-prio 9
!fail --prio-batch-draft -1
!fail --spec-draft-poll x
!fail --spec-draft-cpu-range-batch 0-1
!fail -otd "x=nosuchbuft"
!fail -ncmoed -1
!fail --spec-draft-n-cpu-moe x
