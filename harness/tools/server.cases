# The options the server takes from the shared table.
!fail -c x
!fail -m
!fail -ctk q9
!fail -ngl x
!fail -dev nosuchdevice
!fail -ot "x=nosuchbuft"
!fail -fa maybe
!fail --temp x
!fail --samplers
!fail -hft
!fail --mmproj-device nosuchdevice
!fail --image x.png

# The checks after the parse, reached through a template libllama refuses.
!fail --no-jinja --chat-template bogus
!fail --chat-template bogus --no-jinja -r 'a\nb' --in-prefix x
!fail -otd "x=CPU" --no-jinja --chat-template bogus
!fail -cmoed -ncmoed 2 --no-jinja --chat-template bogus
!fail --chat-template-file /etc/hosts --no-jinja
!fail -hf ggml-org/nothing --no-jinja --chat-template bogus
!fail -m /nonexistent/model.gguf --no-jinja --chat-template bogus

# The environment: each variable through its handler, and a variable that
# the command line overrides.
!env LLAMA_ARG_N_PARALLEL=0
!fail --bogus
!unenv LLAMA_ARG_N_PARALLEL
!env LLAMA_ARG_PORT=abc
!fail --bogus
!unenv LLAMA_ARG_PORT
!env LLAMA_ARG_CACHE_PROMPT=maybe
!fail --bogus
!unenv LLAMA_ARG_CACHE_PROMPT
!env LLAMA_ARG_NO_CACHE_PROMPT=1
!fail --cache-prompt --bogus
!unenv LLAMA_ARG_NO_CACHE_PROMPT
!env LLAMA_ARG_THINK=bogus
!fail --bogus
!unenv LLAMA_ARG_THINK
!env LLAMA_ARG_REASONING=maybe
!fail --bogus
!unenv LLAMA_ARG_REASONING
!env LLAMA_API_KEY=k1
!fail --api-key x --bogus
!unenv LLAMA_API_KEY
!env LLAMA_ARG_SPEC_TYPE=bogus
!fail --bogus
!unenv LLAMA_ARG_SPEC_TYPE
!env LLAMA_ARG_DRAFT_MAX=3
!fail --bogus
!unenv LLAMA_ARG_DRAFT_MAX
!env LLAMA_ARG_CHAT_TEMPLATE_KWARGS='{'
!fail --bogus
!unenv LLAMA_ARG_CHAT_TEMPLATE_KWARGS
!env LLAMA_ARG_SPEC_SYNTH_LEN=-1
!fail --bogus
!unenv LLAMA_ARG_SPEC_SYNTH_LEN
# v0.5.0: six sampling options gained a variable, and --host takes a list
!env LLAMA_ARG_TEMPERATURE=abc
!fail --bogus
!unenv LLAMA_ARG_TEMPERATURE
!env LLAMA_ARG_TOP_P=x
!fail --bogus
!unenv LLAMA_ARG_TOP_P
!env LLAMA_ARG_MIN_P=
!fail --bogus
!unenv LLAMA_ARG_MIN_P
!env LLAMA_ARG_REPEAT_PENALTY=0
!fail --bogus
!unenv LLAMA_ARG_REPEAT_PENALTY
!env LLAMA_ARG_PRESENCE_PENALTY=inf
!fail --bogus
!unenv LLAMA_ARG_PRESENCE_PENALTY
!env LLAMA_ARG_FREQUENCY_PENALTY=nan
!fail --bogus
!unenv LLAMA_ARG_FREQUENCY_PENALTY
!env LLAMA_ARG_HOST=' , '
!fail --bogus
!unenv LLAMA_ARG_HOST
!env LLAMA_ARG_HOST=192.0.2.1
!fail --host , --bogus
!unenv LLAMA_ARG_HOST
!fail --host ''
!fail --host ' ,, '
!fail --host '"",x'
!fail --host '127.0.0.1, ::1' --no-jinja --chat-template bogus
!env LLAMA_ARG_CHECKPOINT_MIN_SPACING_NT=-1
!fail --bogus
!unenv LLAMA_ARG_CHECKPOINT_MIN_SPACING_NT
!env LLAMA_ARG_KV_UNIFIED_PER_SLOT=x
!fail --bogus
!unenv LLAMA_ARG_KV_UNIFIED_PER_SLOT
!env LLAMA_ARG_EMBEDDINGS=1
!fail --embedding --bogus
!unenv LLAMA_ARG_EMBEDDINGS
!env LLAMA_ARG_UI_CONFIG_FILE=/nonexistent/ui.json
!fail --bogus
!unenv LLAMA_ARG_UI_CONFIG_FILE
!env LLAMA_ARG_SPEC_DRAFT_N_MAX=-1
!fail --bogus
!unenv LLAMA_ARG_SPEC_DRAFT_N_MAX
!env LLAMA_ARG_NO_UI=1
!fail --ui --bogus
!unenv LLAMA_ARG_NO_UI
!env LLAMA_ARG_HOST=0.0.0.0
!fail --host 1.2.3.4 --bogus
!unenv LLAMA_ARG_HOST

# The cases whose stderr carries both common_log's worker-thread output and
# the parser's direct fprintf. `~` sorts their lines, and the mask below
# drops each line's log prefix: upstream's worker writes the prefix and the
# message in separate writes, so the fprintf can land between them --
# measured, 3 runs in 600 under load put `error: invalid argument` after a
# `W ` prefix. The level letter is therefore not compared from here on --
!mask s/^(T )?[WIE] //
# ... but the verbosity threshold still is: at -lv 2 a warning shows and
# an info line does not, at -lv 1 neither does.
!fail ~ -lv 2 --tools all --no-jinja --chat-template bogus
!fail ~ -lv 1 --tools all --no-jinja --chat-template bogus
!fail ~ -lv 2 --chat-template-kwargs '{"enable_thinking":true}' --bogus

!fail ~ --chat-template-kwargs '[1,2]' --bogus
!fail ~ --chat-template-kwargs '{"enable_thinking":true,"preserve_reasoning":false}' --bogus
!fail ~ -Cd 0xZZ
!fail ~ -Crd 9999-
!fail ~ -Cbd 0xQQ
!fail ~ --tools all --no-jinja --chat-template bogus
!fail ~ --tools read_file --cors-origins '*' --no-jinja --chat-template bogus
!fail ~ --mcp-servers-json '{}' --no-jinja --chat-template bogus
!fail ~ -ag --no-jinja --chat-template bogus
!fail ~ -ag --no-agent --no-jinja --chat-template bogus
!fail ~ -C 0x1 -t 4 --no-jinja --chat-template bogus
!fail ~ -C 0x1 -t 4 -td 2 --no-jinja --chat-template bogus
!fail ~ -Cd 0x1 -td 3 --no-jinja --chat-template bogus
!env LLAMA_ARG_TOOLS=all
!fail ~ --no-jinja --chat-template bogus
!unenv LLAMA_ARG_TOOLS
!env LLAMA_ARG_AGENT=1
!fail ~ --no-jinja --chat-template bogus
!unenv LLAMA_ARG_AGENT
!env LLAMA_ARG_CORS_ORIGINS=http://x
!fail ~ --tools all --no-jinja --chat-template bogus
!unenv LLAMA_ARG_CORS_ORIGINS
# -j and -jf (Stage 10 step 3b): parsed and converted at parse time, so a
# bad schema fails before the post-parse checks
!fail -j '{"type":' --no-jinja --chat-template bogus
!fail -j '{"type": "integer"}' --no-jinja --chat-template bogus
!fail -j '{"oneOf": [{"type": "integer"}, {"$ref": "#/nowhere"}]}' --no-jinja --chat-template bogus
!fail -jf /nonexistent/schema.json --no-jinja --chat-template bogus
