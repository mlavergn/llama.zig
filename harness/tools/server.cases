!fail --spec-draft-n-min x
!fail --spec-synth-len abc
!fail --spec-synth-len -1
!fail --spec-synth-len 1.5x
!fail --spec-synth-len 1e999
!fail --spec-synth-rates 0.5,x
!fail --spec-synth-rates "0.5, 1e999"
!fail --spec-draft-p-split x
!fail --spec-draft-p-min x
!fail --no-spec-draft-backend-sampling x
