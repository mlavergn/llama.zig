# llama-server against upstream's: scripts/tools-diff server (Stage 10 step 1).
# Only what happens before the server starts: --help, --version, the parse
# errors and the environment. Every case must fail at parse time on both
# sides -- a command line that parses starts upstream's server, which never
# exits. The cases that need the post-parse checks to run end on a chat
# template libllama does not know (`--no-jinja --chat-template bogus`),
# which both sides refuse after every other post-processing step.
# --help prints the whole of common_params_parse's table for the server,
# so it holds every option's spelling, hint, help text, env and section.
# common_init turns on log timestamps, which differ run to run.
!mask s/^[0-9]+\.[0-9]{2}\.[0-9]{3}\.[0-9]{3} /T /
!mask /^ggml_metal_/d

--help
--usage
-h
--version
--list-devices

# The parser's errors. `~`: the parser logs some of these through
# common_log's worker thread, which races its direct fprintf.
!fail --bogus
!fail -np 0
!fail -np x
!fail -np
!fail --parallel 99999999999
!fail -p hello
!fail -f /nonexistent/prompt.txt
!fail -bf /nonexistent/prompt.bin
!fail -cms -1
!fail --checkpoint-min-step x
!fail -ctxcp x
!fail --swa-checkpoints
!fail -cram x
!fail --kv-unified-per-slot abc
!fail --no-cache-idle-slots x
!fail -r
!fail --pooling sideways
!fail -cb --bogus
!fail -nocb --bogus
!fail --mtmd-batch-max-tokens x
!fail -a "x, ,y" --bogus
!fail --tags
!fail --embd-normalize x
!fail --port x
!fail --port 99999999999
!fail --reuse-port --bogus
!fail --cors-credentials x
!fail --ui-config-file /nonexistent/ui.json
!fail --webui-config-file
!fail --api-key-file /nonexistent/keys.txt
!fail --chat-template-kwargs notjson
!fail --chat-template-kwargs '{"a":'
!fail --chat-template-kwargs '{"a":1,}'
!fail -to x
!fail --timeout
!fail --sse-ping-interval x
!fail --threads-http x
!fail --cache-reuse x
!fail --metrics --bogus
!fail --slot-save-path /nonexistent/dir
!fail --slot-save-path /etc/hosts
!fail --media-path /nonexistent/dir
!fail --media-path /etc/hosts
!fail --models-max x
!fail --no-models-autoload x
!fail --reasoning-format bogus
!fail --reasoning-format
!fail -rea maybe
!fail --reasoning maybe
!fail --reasoning-effort high --bogus
!fail --reasoning-budget -2
!fail --reasoning-budget x
!fail --chat-template-file /nonexistent/template.jinja
!fail -sps x
!fail --slot-prompt-similarity
!fail --sleep-idle-seconds 0
!fail --sleep-idle-seconds -5
!fail --sleep-idle-seconds x
!fail --sleep-idle-seconds -1 --bogus
!fail --log-prompts-dir /dev/null/x --bogus
!fail --log-prompts-dir /etc/hosts --bogus
!fail --log-prompts-dir "" --bogus
!fail --log-prompts-dir a/b/c --bogus
!fail --spm-infill --bogus
!fail -sp --bogus
!fail --embedding --rerank --bogus

