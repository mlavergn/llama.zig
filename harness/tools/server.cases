!fail --spec-ngram-map-k4v-size-n 0
!fail --spec-ngram-map-k4v-size-m 1025
!fail --spec-ngram-map-k4v-min-hits 0
!fail --draft 5
!fail --draft x
!fail --draft-max 3
!fail --draft-min 1
