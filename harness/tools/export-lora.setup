#!/bin/bash
# Writes LoRA adapters for export-lora's cases into $DATA: harness/tools/make_lora.c
# over two arch fixtures. Run by scripts/tools-diff.
set -eu
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
bin="$DATA/make_lora"
# The system libraries beside libggml.a: Metal on macOS, CUDA on Linux.
. "$ROOT/scripts/platform-libs"
platform_libs cc "$ROOT/zig-out/lib/libggml.a"
zig cc -O2 -w -I "$ROOT/llama.cpp/ggml/include" "$ROOT/harness/tools/make_lora.c" \
    "$ROOT/zig-out/lib/libggml.a" -lc++ "${PLATFORM_LIBS[@]}" -o "$bin"
for m in qwen3-dense llama-dense; do
    mkdir -p "$DATA/$m"
    "$bin" "$ROOT/zig-out/arch-fixtures/$m.gguf" "$DATA/$m" >/dev/null
done
# v0.8.0's read check: an adapter and a base model missing their last 4 KiB
head -c "$(($(wc -c <"$DATA/qwen3-dense/good.gguf") - 4096))" "$DATA/qwen3-dense/good.gguf" >"$DATA/qwen3-dense/trunc.gguf"
head -c "$(($(wc -c <"$ROOT/zig-out/arch-fixtures/qwen3-dense.gguf") - 4096))" "$ROOT/zig-out/arch-fixtures/qwen3-dense.gguf" >"$DATA/qwen3-dense/trunc-base.gguf"
# v0.9.0: a BF16 base tensor merges to BF16 where it used to become F16
"$ROOT/zig-out/tools-ref/bin/llama-quantize" "$ROOT/zig-out/arch-fixtures/qwen3-dense.gguf" "$DATA/qwen3-dense-bf16.gguf" BF16 >/dev/null 2>&1
