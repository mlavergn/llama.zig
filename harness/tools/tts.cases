# llama-tts against upstream's: scripts/tools-diff tts.
# The backbones and mmprojs are scripts/gen-mmproj-fixtures's: random
# Qwen3-TTS and pocket-tts pipelines; every run writes a WAV, whose hash is
# compared. --help holds the whole of common_params_parse's table for this
# example. Timings and log timestamps differ run to run. `!fail` marks the
# runs upstream itself ends nonzero: the refusals, and the random Qwen3-TTS
# backbone sampling a token below <|codec_0|> after a few frames
# ("clip_encode: code0 out of range"), which upstream stops on -- every
# frame before it is still compared.
!mask s/^[0-9]+\.[0-9]{2}\.[0-9]{3}\.[0-9]{3} /T /
!mask s/[0-9]+\.[0-9]{2}\.[0-9]{3}\.[0-9]{3} ([IWED]) /T \1 /g
!mask /^(T . )?ggml_metal_/d
!mask /frames generated: [0-9]+, speed/d
!mask s/(prompt eval|generation|vocoder|total) [0-9.]+s/\1 Xs/g
!mask s/audio time = [0-9.]+x process time/audio time = Xx process time/
!mask s/reserve took [0-9.]+ ms/reserve took X ms/
!mask s/took [0-9.]+ seconds/took X seconds/
!mask s/^[A-Za-z0-9_.\/-]+:[0-9]+: terminating due to uncaught/libc++abi: terminating due to uncaught/

--help
--usage
--version
!fail --bogus
!fail --tts-lang
!fail --tts-speaker-file

# what main refuses before loading anything
!fail -m $MM/text-qwen3tts.gguf
!fail -m $MM/text-qwen3tts.gguf -p "hello"
!fail -m $MM/text-qwen3tts.gguf -mm /nonexistent/mmproj.gguf -p "hello"
!fail -m $MM/text-qwen3tts.gguf -mm $MM/gemma3.gguf -p "hello"

# Qwen3-TTS: languages, seeds, lengths, an output name, a speaker
-m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "hello world" -n 8 --seed 42
-m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "hello world" -n 8 --seed 43 -o other.wav
!fail -m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "bonjour tout le monde" -n 20 --seed 1 --tts-lang fr
!fail -m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "x" -n 4 --seed 1 --tts-lang klingon
!fail -m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "a longer prompt that runs for a while" -n 90 --seed 5 --top-k 5 --top-p 0.9
# a strong repeat penalty, so the sampler's accepted history decides tokens
!fail -m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "penalised" -n 40 --seed 4 --repeat-penalty 4 --repeat-last-n 64 --temp 1.5 -o penalised.wav
# no -n: the tool's own cap of 512 frames, unless end-of-speech comes first
!fail -m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "uncapped" --seed 9 -o uncapped.wav -c 1024
-m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "speaker" -n 6 --seed 2 --tts-speaker-file $DATA/tone16k.wav
# a code predictor that shares the talker's hidden size has no proj_in (v0.4.0)
-m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts_shared.gguf -p "shared width" -n 8 --seed 6 -o shared.wav
-m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts_shared.gguf -p "speaker" -n 6 --seed 2 --tts-speaker-file $DATA/tone16k.wav -o shared-spk.wav
-m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "speaker" -n 6 --seed 2 --tts-speaker-file $DATA/tone44k.wav
!fail -m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "speaker" -n 6 --seed 2 --tts-speaker-file /nonexistent.wav
-m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "cpu" -n 6 --seed 3 --no-mmproj-offload
-m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "cpu" -n 6 --seed 3 -ngl 0
!fail -m $MM/text-qwen3tts.gguf -mm $MM/qwen3tts.gguf -p "unwritable" -n 2 --seed 3 -o /nonexistent/dir/out.wav

# pocket-tts: chunking, the end-of-speech head, the pack settings fallback
-m $MM/text-pockettts.gguf -mm $MM/pockettts.gguf -p "hello there, how are you" -n 12 --seed 7
-m $MM/text-pockettts.gguf -mm $MM/pockettts.gguf -p "hello there, how are you" -n 12 --seed 7 --no-mmproj-offload -ngl 0
-m $MM/text-pockettts.gguf -mm $MM/pockettts.gguf -p "one two. three four five; six seven eight nine ten eleven twelve thirteen fourteen fifteen. sixteen seventeen eighteen nineteen twenty, twenty one twenty two twenty three twenty four twenty five twenty six. end" -n 60 --seed 11
-m $MM/text-pockettts.gguf -mm $MM/pockettts.gguf -p "voice" -n 6 --seed 2 --tts-speaker-file $DATA/tone16k.wav
!fail -m $MM/text-pockettts.gguf -mm $MM/pockettts.gguf -p "   " -n 6 --seed 2

# Soprano and LFM3-Audio (v0.8.0): the decoder alone over sampled tokens, and
# MaskGIT frames fed back into the backbone; the LFM3 text model carries a
# "tts" chat template, which the prompt is rendered through
-m $MM/text-qwen3-soprano.gguf -mm $MM/soprano.gguf -p "hello world" -n 6 --seed 7
-m $MM/text-qwen3-soprano.gguf -mm $MM/soprano-linear.gguf -p "hello world" -n 6 --seed 8 -o linear.wav
-m $MM/text-qwen3-soprano.gguf -mm $MM/soprano.gguf -p "cpu" -n 4 --seed 3 --no-mmproj-offload -ngl 0
!fail -m $MM/text-qwen3-soprano.gguf -mm $MM/soprano.gguf -p "speaker" -n 6 --seed 2 --tts-speaker-file $DATA/tone16k.wav
-m $MM/text-qwen3-lfm3.gguf -mm $MM/lfm3a_gen.gguf -p "hello" -n 8 --seed 3
# v0.9.0: LFM3-Audio has predefined voices now, and "alice" is not one of them
!fail -m $MM/text-qwen3-lfm3.gguf -mm $MM/lfm3a_gen.gguf -p "bonjour" -n 6 --seed 4 --tts-lang fr --tts-voice alice -o voice.wav
-m $MM/text-qwen3-lfm3.gguf -mm $MM/lfm3a_gen.gguf -p "bonjour" -n 6 --seed 4 --tts-lang fr --tts-voice Male -o voice.wav
-m $MM/text-qwen3-lfm3.gguf -mm $MM/lfm3a_gen.gguf -p "speaker" -n 4 --seed 5 --tts-speaker-file $DATA/tone16k.wav
-m $MM/text-qwen3-lfm3.gguf -mm $MM/lfm3a_gen.gguf -p "cpu" -n 4 --seed 3 --no-mmproj-offload -ngl 0
-m $MM/text-qwen3-lfm3.gguf -mm $MM/lfm3a_gen-eos.gguf -p "ends" -n 20 --seed 6

# v0.9.0: predefined voices (pocket-tts and Chatterbox carry voice.alba and
# voice.Bob): the first by default, with a warning; one by name, any case; an
# unknown name lists them; a voice and a speaker file together are refused.
# n_parallel is doubled and the KV cache unified for every model.
-m $MM/text-pockettts.gguf -mm $MM/pockettts.gguf -p "a named voice" -n 6 --seed 2 --tts-voice alba -o alba.wav
-m $MM/text-pockettts.gguf -mm $MM/pockettts.gguf -p "a named voice" -n 6 --seed 2 --tts-voice BOB -o bob.wav
!fail -m $MM/text-pockettts.gguf -mm $MM/pockettts.gguf -p "x" -n 4 --seed 2 --tts-voice nobody
!fail -m $MM/text-pockettts.gguf -mm $MM/pockettts.gguf -p "x" -n 4 --seed 2 --tts-voice alba --tts-speaker-file $DATA/tone16k.wav
-m $MM/text-qwen3-cbx.gguf -mm $MM/chatterbox.gguf -p "hello" -n 6 --seed 3 -o cbx.wav
-m $MM/text-qwen3-cbx.gguf -mm $MM/chatterbox.gguf -p "hello" -n 6 --seed 3 --tts-voice alba -o cbx-alba.wav
-m $MM/text-qwen3-cbx.gguf -mm $MM/chatterbox-mtl.gguf -p "hello" -n 6 --seed 3 --tts-voice alba -o cbx-mtl.wav
