# llama-imatrix against upstream's: scripts/tools-diff imatrix.
# Collection runs on $PLAIN (dense, a real vocabulary), and on two arch
# fixtures harness/tools/add_vocab.c gave an SPM vocabulary -- the MoE one is
# the only way to reach MUL_MAT_ID's per-expert counts with text. Later
# cases merge and inspect the files earlier ones wrote.
!mask s/^[0-9]+\.[0-9]{2}\.[0-9]{3}\.[0-9]{3} /T /
# On CUDA a log line follows the loader's progress dots on the same line.
!mask s/^(\.+)[0-9]+\.[0-9]{2}\.[0-9]{3}\.[0-9]{3} /\1T /
!mask /^(T . )?ggml_metal_/d
!mask /^[0-9]+ +[A-Za-z_.-]+ +0x[0-9a-f]+ /d
!mask s/^llama\.cpp\/([a-z-]+\/)*//
!mask s/tokenization took [0-9.e+-]+ ms/tokenization took X ms/
!mask s/[0-9]+\.[0-9]+ seconds per pass - ETA /X seconds per pass - ETA /
!mask s/^([0-9]+ hours )?[0-9]+\.[0-9]+ minutes$/X minutes/
!mask s/^(T I )?(llama_perf_context_print: +[a-z ]+ = ).*/\1\2X/
!mask s/ETA [0-9]+\.[0-9]{2}\.[0-9]{3}\.[0-9]{3} /ETA T /
!mask s/reserve took [0-9.]+ ms/reserve took X ms/
# An exception escaping libllama: the port terminates through ggml_abort,
# with a file:line prefix and a backtrace, where libc++abi prints neither
# (src/llama/impl.zig, Exception.terminate). Library-wide, not this tool's.
!mask s/^[A-Za-z0-9_.\/-]+:[0-9]+: terminating due to uncaught/libc++abi: terminating due to uncaught/

--help
-m $PLAIN -f $DATA/text.txt -c 64 --chunks 3
-m $PLAIN -f $DATA/text.txt -c 64 --chunks 4 -o x.dat --output-format dat
-m $PLAIN -f $DATA/text.txt -c 64 -b 128 --chunks 4 --process-output -o p.gguf
-m $PLAIN -f $DATA/text.txt -c 64 --chunk 2 --chunks 2 --no-ppl -o c.gguf
-m $PLAIN -f $DATA/text.txt -c 32 --chunks 5 --save-frequency 2 --output-frequency 2 -o s.gguf
-m $PLAIN -f $DATA/text.txt -c 64 --chunks 2 -o out.bin
-m $PLAIN -f $DATA/text.txt -c 64 --chunks 2 --output-format gguf -o out2.bin
-m $DATA/moe.gguf -f $DATA/ascii.txt -c 32 --chunks 4 -o moe.gguf
-m $DATA/moe.gguf -f $DATA/ascii.txt -c 32 -b 64 --chunks 3 --output-format dat -o moe.dat
-m $DATA/moe.gguf -f $DATA/text.txt -c 32 --chunks 2 -o crash.gguf
-m $DATA/dense.gguf -f $DATA/ascii.txt -c 32 --chunks 3 --process-output --parse-special -o dense.gguf -lv 5
-m $PLAIN -f $DATA/text.txt -c 64 --chunks 2 --in-file imatrix.gguf -o cont.gguf
-m $PLAIN --in-file imatrix.gguf,p.gguf -o comb.gguf
-m $PLAIN --in-file x.dat -o fromdat.gguf
-m $PLAIN --in-file imatrix.gguf,x.dat -o mixed.dat --output-format dat
-m $PLAIN --in-file moe.gguf,moe.dat -o moe2.gguf
-m $PLAIN --in-file moe.gguf,moe.dat,c.gguf -o moe3.dat --output-format dat
-m $PLAIN --show-statistics --in-file imatrix.gguf
-m $PLAIN --show-statistics --in-file p.gguf
-m $PLAIN --show-statistics --in-file moe.gguf
-m $PLAIN --show-statistics --in-file moe2.gguf
-m $PLAIN --show-statistics --in-file x.dat
-m $PLAIN --show-statistics --in-file s.gguf.at_5
-m $PLAIN --show-statistics --in-file dense.gguf
-m $PLAIN --show-statistics
-m $PLAIN --show-statistics --in-file imatrix.gguf,p.gguf
-m $PLAIN --show-statistics --in-file /nonexistent.gguf
-m $PLAIN --in-file /nonexistent.gguf
-m $PLAIN -o nothing.gguf
--in-file imatrix.gguf -o nomodel.gguf
-m $PLAIN -f $DATA/short.txt -c 64
-m $PLAIN -f $DATA/text.txt -c 64 --chunk 1000
-m $PLAIN -f $DATA/text.txt -c 0
--in-file moe.gguf -m $PLAIN -f $DATA/text.txt -c 64 --chunks 1 -o bad.gguf
