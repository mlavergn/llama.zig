#!/usr/bin/env python3
"""Generate `llama_layer` and its five member structs as Zig structs.

`llama_layer` (llama-model.h) has one tensor pointer for every tensor any
architecture names -- 244 of them, plus `posnet`, `convnext`, `shortconv`,
`nextn` and `switch_lora`. Qwen3.5 needed 75. Porting the other
architectures one at a time and adding each one's members by hand would
leave a struct that differs from upstream's in an order nobody chose, and a
member spelled differently from the C++ is a citation that leads nowhere.
So the whole set is generated, in upstream's order, and every architecture
finds its members already there.

These are plain Zig structs, not extern: nothing reads them by offset. The
generator refuses to drop a member the existing block has, so a pin move
that renames one fails here rather than as a compile error far away.

Writes the block between the GENERATED markers in src/llama/model.zig.
Run after moving the upstream pin.
"""
import re
import sys

HDR = "llama.cpp/src/llama-model.h"
from upstream_pin import COMMIT, TAG
OUT = "src/llama/model.zig"
BEGIN = "// BEGIN GENERATED by scripts/gen-layer -- do not edit"
END = "// END GENERATED by scripts/gen-layer"

# C++ struct name -> Zig type name, in the order they are emitted.
STRUCTS = [
    ("llama_layer_posnet", "LayerPosnet"),
    ("llama_layer_convnext", "LayerConvnext"),
    ("llama_layer_shortconv", "LayerShortconv"),
    ("llama_layer_nextn", "LayerNextn"),
    ("llama_layer_switch_lora", "LayerSwitchLora"),
    ("llama_layer", "Layer"),
]
ZIG_NAME = dict(STRUCTS)

lines = open(HDR).read().split("\n")


def parse(name, lenient=False):
    """(first line, [(kind, value)]) of `struct name { ... };`.

    kind is "tensor" (value: member name), "struct" (value: (cxx type,
    member name)), "comment" (value: the comment text) or "blank".
    """
    start = next(i for i, l in enumerate(lines) if l.strip() == f"struct {name} {{")
    out = []
    for l in lines[start + 1:]:
        s = l.strip()
        # Lenient: the struct's own brace is the one at column 0, since a
        # member function's body may close a brace of its own.
        if (l == "};") if lenient else (s == "};"):
            return start + 1, out
        if not s:
            out.append(("blank", None))
            continue
        m = re.fullmatch(r"struct ggml_tensor \*\s*(\w+)\s*=\s*nullptr;\s*(//.*)?", s)
        if m:
            out.append(("tensor", (m.group(1), m.group(2))))
            continue
        m = re.fullmatch(r"struct (\w+) (\w+);", s)
        if m:
            out.append(("struct", (m.group(1), m.group(2))))
            continue
        if s.startswith("//"):
            out.append(("comment", s))
            continue
        if lenient:
            # Not a tensor: ends whatever comment run preceded it.
            out.append(("blank", None))
            continue
        sys.exit(f"gen-layer: cannot parse {name} member: {s!r}")
    sys.exit(f"gen-layer: {name} has no closing brace")


def emit(cxx, zig):
    line, members = parse(cxx)
    what = "Ports" if cxx != "llama_layer" else "Ports"
    out = [f"/// {what} `{cxx}` (llama-model.h:{line} @{COMMIT})."]
    if cxx == "llama_layer":
        out[0] = (f"/// Ports `{cxx}` (llama-model.h:{line} @{COMMIT}): one member for\n"
                  "/// every tensor any architecture names, in the C++'s order.")
    out.append(f"pub const {zig} = struct {{")
    prev_blank = True
    for kind, v in members:
        if kind == "blank":
            if not prev_blank:
                out.append("")
            prev_blank = True
            continue
        prev_blank = False
        if kind == "comment":
            out.append("    " + v)
        elif kind == "tensor":
            name, comment = v
            out.append(f"    {name}: ?*c.ggml_tensor = null," + (f" {comment}" if comment else ""))
        else:
            ty, name = v
            out.append(f"    {name}: {ZIG_NAME[ty]} = .{{}},")
    while out[-1] == "":
        out.pop()
    out.append("};")
    return "\n".join(out), {v[0] if k == "tensor" else v[1] for k, v in members if k in ("tensor", "struct")}


src = open(OUT).read()
if BEGIN not in src or END not in src:
    sys.exit(f"gen-layer: {OUT} has no GENERATED markers")
head, rest = src.split(BEGIN, 1)
old, tail = rest.split(END, 1)

blocks = []
new_names = {}
for cxx, zig in STRUCTS:
    text, names = emit(cxx, zig)
    blocks.append(text)
    new_names[zig] = names

# Every member the existing block declares must still exist.
for zig in new_names:
    m = re.search(rf"pub const {zig} = struct \{{(.*?)\n\}};", old, re.S)
    if not m:
        continue
    for name in re.findall(r"^\s+(\w+):", m.group(1), re.M):
        if name not in new_names[zig]:
            sys.exit(f"gen-layer: {zig}.{name} exists in {OUT} but not in {HDR}")

src = head + BEGIN + "\n" + "\n\n".join(blocks) + "\n" + END + tail

# `llama_model`'s own tensors: its other members are not pointers to
# tensors and stay hand-written in `Model`.
MBEGIN = "    // BEGIN GENERATED by scripts/gen-layer (llama_model) -- do not edit"
MEND = "    // END GENERATED by scripts/gen-layer (llama_model)"
if MBEGIN not in src or MEND not in src:
    sys.exit(f"gen-layer: {OUT} has no llama_model GENERATED markers")
mhead, mrest = src.split(MBEGIN, 1)
mold, mtail = mrest.split(MEND, 1)
mline, members = parse("llama_model", lenient=True)
out = [f"    // The tensors of `llama_model` (llama-model.h:{mline} @{COMMIT}), in its order."]
pending = []
mnames = set()
morder = []
for kind, v in members:
    if kind == "comment":
        pending.append("    " + v)
    elif kind == "blank":
        pending = []
    elif kind == "tensor":
        name, comment = v
        if pending:
            out.append("")
            out.extend(pending)
            pending = []
        out.append(f"    {name}: ?*c.ggml_tensor = null," + (f" {comment}" if comment else ""))
        mnames.add(name)
        morder.append(name)
for name in re.findall(r"^\s+(\w+): \?\*c\.ggml_tensor", mold, re.M):
    if name not in mnames:
        sys.exit(f"gen-layer: Model.{name} exists in {OUT} but not in {HDR}")
src = mhead + MBEGIN + "\n" + "\n".join(out) + "\n" + MEND + mtail

open(OUT, "w").write(src)

# The C++ side of `make loader-diff`: every `llama_layer` member by its path
# (nested ones as `posnet.norm1`, which `offsetof` accepts), and every
# `llama_model` tensor, so the harness can read the reference model's
# tensor behind each of the port's fields. Generated beside the Zig so the
# two cannot list different members.
def layer_paths(cxx):
    _, members = parse(cxx)
    out = []
    for kind, v in members:
        if kind == "tensor":
            out.append(v[0])
        elif kind == "struct":
            ty, name = v
            out.extend(f"{name}.{p}" for p in layer_paths(ty))
    return out

hdr_note = "// Generated by scripts/gen-layer from llama-model.h -- do not edit.\n"
open("harness/layer_fields.inc", "w").write(hdr_note + "".join(f"F({p})\n" for p in layer_paths("llama_layer")))
open("harness/model_fields.inc", "w").write(hdr_note + "".join(f"M({n})\n" for n in morder))
print(f"gen-layer: {sum(len(v) for v in new_names.values())} members in {len(STRUCTS)} structs, "
      f"{len(mnames)} in llama_model")
