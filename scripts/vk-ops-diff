#!/bin/bash
# The Vulkan op oracle: every op configuration of upstream's test-backend-ops,
# run on the ported Vulkan backend and on the reference Vulkan backend in one
# process, compared on bits -- `cuda-ops-diff` for Vulkan (PLAN.md,
# "Stage 7 — Vulkan").
#
# What it compares
# ----------------
# `test-backend-ops` normally runs each case on a GPU backend and on the CPU
# and accepts an NMSE below a threshold. Here it is compiled with
# `ggml_backend_compare_graph_backend` and `ggml_backend_supports_op`
# renamed to the hooks in `harness/vk_ops_diff.c`: the CPU's place is taken
# by upstream's own Vulkan backend -- `ggml-vulkan.cpp` and the generated
# shaders, its nine `ggml-vulkan.h` exports renamed `ref_*` -- and every
# node is compared byte for byte. Both sides run the reference generator's
# SPIR-V, so a difference is the host code.
#
# What it cannot see
# ------------------
# `graph_optimize`: test-backend-ops computes graphs directly and never
# reorders them. `vk-backend-diff` compares the reorder and `vk-node-diff`
# a real decode through it. Shapes upstream's list lacks need extra cases
# (`harness/vk_ops_diff.c`, `extra_cases`): the misaligned set_rows leaf,
# split-k and large-tile matmuls, a second fused bias in `src[0]`.
# `supports_op` must agree both ways; before the swap a refusal was only
# counted.
#
# Usage: scripts/vk-ops-diff [test-backend-ops args, e.g. -o ADD]
#   With no arguments: every op, FLASH_ATTN_EXT split by head size (below).
# Requires:
#   zig build reference vk-ref --release=fast -Dvulkan -Dcuda=false --prefix zig-out/vk-port
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

# Both overridable, so a second checkout can test its own port against one
# reference archive: the renamed reference is upstream's code and does not
# change with the port.
PREFIX=${VK_PORT_PREFIX:-zig-out/vk-port}
PORT_LIB=$PREFIX/lib/libggml.a
REF_LIB=${VK_REF_LIB:-$PREFIX/lib/libggml-vulkan-ref.a}
for lib in "$PORT_LIB" "$REF_LIB"; do
    [ -f "$lib" ] || { echo "missing $lib -- see the Requires lines in $0" >&2; exit 2; }
done

# The ported library must really be the port: no upstream Vulkan object.
# The reference archive must carry the renamed exports.
if nm -A "$PORT_LIB" 2>/dev/null | grep -q '/ggml-vulkan\.o:'; then
    echo "FAIL: $PORT_LIB contains upstream's ggml-vulkan.o -- build it with -Dvulkan-port" >&2; exit 1
fi
n=$(nm -g --defined-only "$REF_LIB" 2>/dev/null | grep -cE ' [TD] ref_(ggml_backend_|vk_conv_block_sizes)')
[ "$n" -eq 9 ] || { echo "FAIL: expected 9 renamed reference exports, got $n" >&2; exit 1; }

. "$ROOT/scripts/platform-libs"
platform_libs cc "$PORT_LIB" "$REF_LIB"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

zig c++ -c llama.cpp/tests/test-backend-ops.cpp -o "$tmp/tbo.o" -std=c++17 -O2 -w \
    -I llama.cpp/ggml/include -I llama.cpp/ggml/src \
    -Dggml_backend_compare_graph_backend=vk_diff_compare_graph_backend \
    -Dggml_backend_supports_op=vk_diff_supports_op -Dmain=test_backend_ops_main 2>"$tmp/cc.log" \
    || { echo "FAIL: could not compile test-backend-ops" >&2; tail -5 "$tmp/cc.log" >&2; exit 1; }
zig cc -c harness/vk_ops_diff.c -o "$tmp/hooks.o" -std=c11 -O2 -I llama.cpp/ggml/include 2>"$tmp/cc.log" \
    || { echo "FAIL: could not compile the hooks" >&2; tail -5 "$tmp/cc.log" >&2; exit 1; }
zig c++ "$tmp/tbo.o" "$tmp/hooks.o" -o "$tmp/vk_ops_diff" \
    "$PORT_LIB" "$REF_LIB" ${PLATFORM_LIBS[@]+"${PLATFORM_LIBS[@]}"} 2>"$tmp/ld.log" \
    || { echo "FAIL: could not link the harness" >&2; grep -m5 error "$tmp/ld.log" >&2; exit 1; }

# VK_OPS_DIFF_BIN=<path> keeps the linked harness, to run it by hand.
[ -n "${VK_OPS_DIFF_BIN:-}" ] && cp "$tmp/vk_ops_diff" "$VK_OPS_DIFF_BIN"

# A side that aborts must abort the same way; gdb's backtrace would differ.
export GGML_NO_BACKTRACE=1

# One run of the harness over `args`; adds its verdict to the totals.
# A run that outlives VK_OPS_DIFF_TIMEOUT seconds (5400) is killed; with
# `fallback` set, the cases it had not finished then run one per process
# (`run_rest`), and otherwise the part fails. `quiet` prints failures only.
total_ok=0
total_fail=0
total_hung=0
[ -n "${VK_OPS_DIFF_OUT:-}" ] && : > "$VK_OPS_DIFF_OUT"
run_part() {
    local label="$1" limit="$2" mode="$3"; shift 3
    local log="$tmp/out.$label.log"
    timeout "$limit" "$tmp/vk_ops_diff" test -b Vulkan0 "$@" > "$log" 2>&1
    local rc=$?
    [ -n "${VK_OPS_DIFF_OUT:-}" ] && cat "$log" >> "$VK_OPS_DIFF_OUT"

    if [ "$rc" -eq 124 ] && [ "$mode" = fallback ]; then
        run_rest "$label" "$log" "$@"
        return
    fi
    judge "$label" "$log" "$rc" "$limit" "$mode"
}

# The verdict on one run's log, added to the totals.
judge() {
    local label="$1" log="$2" rc="$3" limit="$4" mode="$5"
    grep -E '^(BITDIFF|SUPPORTS|NONDET)|EXTRA .*FAIL' "$log" | head -20
    local passed ok nsupp bit sup
    passed=$(grep -E '^  [0-9]+/[0-9]+ tests passed' "$log" | tail -1 | sed 's/^ *//')
    ok=$(echo "$passed" | cut -d/ -f1)
    nsupp=$(grep -cE 'not supported' "$log")
    # Cases, not lines: a case the reference fails to reproduce against
    # itself prints BITDIFF lines too, and is reported NONDET rather than
    # failed.
    bit=$(sed -nE 's/^vk_ops_diff: .* differing in ([0-9]+) cases.*/\1/p' "$log")
    bit=${bit:-1}
    sup=$(grep -cE '^SUPPORTS' "$log")
    [ "$mode" = quiet ] || echo "  $label: ${passed:-0/0 tests passed}, bit-identical; $nsupp cases not supported by the port"
    if [ "$rc" -ne 0 ] || [ "$bit" -ne 0 ] || [ "$sup" -ne 0 ]; then
        [ "$mode" = quiet ] && echo "  $label: ${passed:-0/0 tests passed}"
        [ "$rc" -eq 124 ] && echo "  $label: killed after $limit s"
        [ "$rc" -ne 0 ] && { echo "  $label: test-backend-ops exited $rc"; grep -E 'GGML_ASSERT|FAIL|Assert|error|not ported' "$log" | head -10; }
        total_fail=$((total_fail + 1))
    fi
    total_ok=$((total_ok + ${ok:-0}))
}

# The rest of a part whose run stalled: what it finished is counted from its
# log, and every case from the one it stalled on runs in its own process.
# `support` mode lists the part's cases without computing them, and `-o`
# takes a whole case string as an exact name.
run_rest() {
    local label="$1" log="$2"; shift 2
    local clean="$tmp/rest.$label.log" cases="$tmp/rest.$label.cases"
    sed $'s/\x1b\\[[0-9;]*m//g' "$log" > "$clean"
    grep -E '^(BITDIFF|SUPPORTS|NONDET)' "$clean" | head -20
    local early_bad early_ok stalled
    early_bad=$(grep -cE '^(BITDIFF|SUPPORTS)' "$clean")
    early_ok=$(grep -cE '^  [A-Z_0-9]+\(.*\): OK$' "$clean")
    stalled=$(grep -E '^  [A-Z_0-9]+\(' "$clean" | tail -1 | sed -E 's/^  //; s/: *$//')
    "$tmp/vk_ops_diff" support -b Vulkan0 "$@" 2>/dev/null | sed $'s/\x1b\\[[0-9;]*m//g' \
        | grep -E '^  [A-Z_0-9]+\(' | sed -E 's/^  //; s/: [A-Z ]+$//' > "$cases"
    local rest
    rest=$(awk -v s="$stalled" '$0 == s { f = 1 } f' "$cases")
    if [ -z "$rest" ]; then
        echo "  $label: stalled on a case support mode does not list -- $stalled"
        total_fail=$((total_fail + 1))
        return
    fi
    total_ok=$((total_ok + early_ok))
    [ "$early_bad" -ne 0 ] && total_fail=$((total_fail + 1))
    local n=0 before=$total_fail before_ok=$total_ok hung=0
    while IFS= read -r c; do
        n=$((n + 1))
        # A case that hangs alone is run again with the reference in the
        # port's place: if the reference hangs against itself too, the case
        # cannot be compared and is reported, not failed -- the counterpart
        # of NONDET. Measured on the KHR arm: the two MLA decode cases
        # (`hsk=576, hsv=512, nh=1, nr23=[20,1]`, q8_0, nb=1) hang on their
        # own in the reference, with the GPU idle.
        local one="$tmp/out.$label.$n.log" rc self
        timeout 120 "$tmp/vk_ops_diff" test -b Vulkan0 -o "$c" > "$one" 2>&1
        rc=$?
        [ -n "${VK_OPS_DIFF_OUT:-}" ] && cat "$one" >> "$VK_OPS_DIFF_OUT"
        if [ "$rc" -eq 124 ]; then
            VK_DIFF_SELF=1 timeout 120 "$tmp/vk_ops_diff" test -b Vulkan0 -o "$c" > /dev/null 2>&1
            self=$?
            if [ "$self" -eq 124 ]; then
                echo "REFHANG $c"
                hung=$((hung + 1))
                total_hung=$((total_hung + 1))
                continue
            fi
            echo "  $label.$n: the port hangs where the reference does not -- $c"
        fi
        judge "$label.$n" "$one" "$rc" 120 quiet
    done <<< "$rest"
    echo "  $label: stalled after $early_ok cases; the other $n ran one per process," \
         "$((total_ok - before_ok)) bit-identical, $hung hung in the reference alone$([ "$total_fail" -ne "$before" ] && echo ", SOME DIFFER")"
}

if [ $# -gt 0 ]; then
    run_part run "${VK_OPS_DIFF_TIMEOUT:-5400}" plain "$@"
else
    # FLASH_ATTN_EXT runs in its own processes, one per head size. In one
    # process with the rest, the KHR-coopmat and no-coopmat arms stall at
    # `hsk=256, kv=16384, q8_0` with the GPU idle and a fence that never
    # signals -- and the reference stalls there against itself -- while each
    # case alone finishes in a second (NOTES.md, "The Vulkan arms,
    # completed"). A head size can still stall on its own (KHR, hsk=576), so
    # a part that outlives VK_OPS_DIFF_FA_TIMEOUT (600 s) finishes one case
    # per process. The head sizes are test-backend-ops' own list; every
    # FLASH_ATTN_EXT case it makes uses one of them.
    # The rest is every case whose vars are not test_flash_attn_ext's, which
    # alone begin `hsk=N,hsv=`. Not `-o` over a list of names: a fused case
    # is named for its fusion (ROPE_SET_ROWS, RMS_NORM_MUL_ADD, GELU_MUL),
    # which `--list-ops` does not print and `support` mode drops, so that ran
    # none of them (NOTES.md, "The v0.4.1 pickup").
    run_part ops "${VK_OPS_DIFF_TIMEOUT:-5400}" plain -p '^(?!hsk=[0-9]+,hsv=)'
    for hsk in 40 64 72 80 96 128 192 256 320 512 576; do
        run_part "fa-hsk$hsk" "${VK_OPS_DIFF_FA_TIMEOUT:-600}" fallback -o FLASH_ATTN_EXT -p "hsk=$hsk,"
    done
fi
# Every run repeats the extra cases; count each once.
nextra=$(cat "$tmp"/out.*.log | grep -E '^  EXTRA ' | sed 's/: [A-Z]*$//' | sort -u | grep -c '')
[ "$nextra" -gt 0 ] && echo "  $nextra extra cases run in each part; $(cat "$tmp"/out.*.log | grep -cE '^  EXTRA .*: OK$') of $(cat "$tmp"/out.*.log | grep -cE '^  EXTRA ') runs bit-identical"

if [ "$total_fail" -ne 0 ]; then
    echo "FAIL: the ported Vulkan backend differs from the reference ($total_fail runs)"
    exit 1
fi
[ "$total_ok" -gt 0 ] || { echo "FAIL: no case ran -- the gate compared nothing"; exit 1; }
[ "$total_hung" -gt 0 ] && echo "  $total_hung cases not compared: the reference hangs on them against itself (REFHANG above)"
echo "PASS: every supported case bit-identical to the reference Vulkan backend ($total_ok cases)"
