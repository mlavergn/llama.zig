#!/bin/bash
# Compare src/llama/adapter.zig, src/llama/api/adapter.zig and the context's
# adapter setters with llama.cpp's llama-adapter.cpp and llama-context.cpp,
# in one process.
#
# Writes LoRA files for the model under test -- good ones over every kind of
# weight Qwen3.5 adapts, an aLoRA, and one bad file per error the loader can
# throw -- loads the model through the C++ in libllama-ref.a and through the
# port, loads every adapter on both sides, and runs one script of LoRA sets,
# control vectors and decodes through llama.h and through the port's api
# functions of the same names. The transcripts -- everything logged, every
# adapter API result, every graph node with a hash of its data, every logit
# row's bits -- must be identical. See harness/adapter_diff.zig.
#
# Usage: scripts/adapter-diff [model.gguf] [--quick]
#   Requires: zig build reference --release=fast
#   The model defaults to the first Qwen3.5 model in the repository root.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

for lib in zig-out/lib/libllama-ref.a zig-out/lib/libggml.a; do
    [ -f "$lib" ] || { echo "missing $lib -- run 'zig build reference --release=fast'" >&2; exit 2; }
done

model=""
if [ $# -gt 0 ] && [ "${1%.gguf}" != "$1" ]; then
    model="$1"
    shift
fi
if [ -z "$model" ]; then
    for m in Qwen3.5-*.gguf; do
        [ -f "$m" ] && { model="$m"; break; }
    done
fi
[ -n "$model" ] || { echo "no Qwen3.5 model -- run 'make qwen35'" >&2; exit 2; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

SDK="$(xcrun --sdk macosx --show-sdk-path)"

zig c++ -mcpu=baseline -c harness/adapter_ref.cpp -o "$tmp/adapter_ref.o" -std=c++17 -O2 -w \
    -I llama.cpp/src -I llama.cpp/include -I llama.cpp/ggml/include 2>"$tmp/cerr" \
    || { echo "FAIL: cannot compile harness/adapter_ref.cpp" >&2; head -20 "$tmp/cerr" >&2; exit 1; }

zig translate-c -lc -I llama.cpp/include -I llama.cpp/ggml/include \
    src/llama/c_import.h >"$tmp/llama_c.zig" 2>"$tmp/terr" \
    || { echo "FAIL: cannot translate llama.h" >&2; head -10 "$tmp/terr" >&2; exit 1; }

zig build-exe -mcpu baseline -femit-bin="$tmp/adapter_diff" -Ofast -lc \
    --dep staged -Mroot=harness/adapter_diff.zig \
    --dep llama_c -Mstaged=src/llama/staged.zig -Mllama_c="$tmp/llama_c.zig" \
    "$tmp/adapter_ref.o" zig-out/lib/libllama-ref.a zig-out/lib/libggml.a -lc++ \
    -framework Foundation -framework Metal -framework MetalKit -framework Accelerate \
    -F "$SDK/System/Library/Frameworks" 2>"$tmp/berr" \
    || { echo "FAIL: could not build the harness" >&2; head -40 "$tmp/berr" >&2; exit 1; }

"$tmp/adapter_diff" "$tmp" "$model" "$@"
