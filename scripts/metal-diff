#!/bin/bash
# Compare the ported Metal vtables against the reference's, directly.
#
# **The gate `ggml-metal.cpp` was missing.** `make node-diff ARGS=--gpu`
# runs the graph and hashes every node, which proves the backend computes
# the right values -- and sees almost none of this file. Measured by
# injection: dropping the four FLASH_ATTN_EXT scratch terms from
# `get_alloc_size` passed node-diff, and those terms are non-zero on that
# graph, so the fault was real and invisible. `get_alignment` 32 -> 16 and
# 32 -> 64 passed too, though a probe shows the function is reached.
#
# The reference's six exports are renamed with -D so both registries live
# in one process; the buffer-type and device vtables are then asked the
# same questions. As in `tuning-diff`, the renames go to the reference
# translation unit **only** -- applying them to the harness would rename
# its declarations of our names too, and both sides would answer from the
# reference.
#
# Usage: scripts/metal-diff
#   METAL_DIFF_LIB names another port library, for a private build.
#   Requires: zig build reference --release=fast
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

LIB="${METAL_DIFF_LIB:-zig-out/lib/libggml.a}"
[ -f "$LIB" ] || { echo "missing $LIB -- run 'zig build reference --release=fast'" >&2; exit 2; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

SDK="$(xcrun --sdk macosx --show-sdk-path)"
CXX=(zig c++ -mcpu=baseline -std=c++17 -w -O2
     -I llama.cpp/ggml/include -I llama.cpp/ggml/src -I llama.cpp/ggml/src/ggml-cpu
     -I llama.cpp/ggml/src/ggml-metal
     -DNDEBUG -DGGML_USE_CPU -DGGML_USE_METAL -DGGML_METAL_EMBED_LIBRARY
     -DGGML_SCHED_MAX_COPIES=4 -DGGML_USE_ACCELERATE -DGGML_USE_LLAMAFILE)

RENAME=(-Dggml_backend_metal_reg=ref_ggml_backend_metal_reg
        -Dggml_backend_metal_init=ref_ggml_backend_metal_init
        -Dggml_backend_is_metal=ref_ggml_backend_is_metal
        -Dggml_backend_metal_set_abort_callback=ref_ggml_backend_metal_set_abort_callback
        -Dggml_backend_metal_supports_family=ref_ggml_backend_metal_supports_family
        -Dggml_backend_metal_capture_next_compute=ref_ggml_backend_metal_capture_next_compute)

"${CXX[@]}" "${RENAME[@]}" -c llama.cpp/ggml/src/ggml-metal/ggml-metal.cpp \
    -o "$tmp/ref_metal.o" 2>"$tmp/err" \
    || { echo "FAIL: cannot compile the renamed reference ggml-metal.cpp" >&2; head -10 "$tmp/err" >&2; exit 1; }

n=$(nm -gUj "$tmp/ref_metal.o" | sed 's/^_//' | grep -c '^ref_ggml_backend')
echo "reference: $n exports renamed to ref_*"
[ "$n" -eq 6 ] || { echo "FAIL: expected 6 renamed exports, got $n" >&2; exit 1; }

# The reordering pass (v0.5.0) and the mat-mul dispatch predicates:
# `ggml-metal-common.cpp` with its fourteen exports renamed (v0.6.0 added
# the five few-row MMA ones), so `graph_optimize`'s order can be compared on
# the fusion probes and each predicate asked directly. Its
# `ggml_metal_fusion_max` stays ours, compared on its own below.
#
# The renames go to the reference fusion table too: since v0.6.0 its
# MUL_MAT + ADD check asks `ggml_metal_op_mul_mat_use_mma` and
# `_may_use_mma`, and without them it would ask ours, and a fault in those
# would move both sides of the fusion comparison together.
CRENAME=()
for f in ggml_metal_op_mul_mat_use_fwht ggml_metal_op_mul_mat_use_mm ggml_metal_op_mul_mat_id_use_mm \
         ggml_metal_op_mul_mat_use_mma ggml_metal_op_mul_mat_may_use_mma ggml_metal_mul_mv_mma_kind \
         ggml_metal_mul_mv_mma_rt ggml_metal_mul_mv_mma_k_step \
         ggml_mem_ranges_init ggml_mem_ranges_free ggml_mem_ranges_reset ggml_mem_ranges_add \
         ggml_mem_ranges_check ggml_graph_optimize; do
    CRENAME+=(-D$f=ref_$f)
done

# The fusion table (v0.4.1): the reference `ggml-metal-fusion.cpp` with all
# 18 of its exports renamed, beside ours (v0.5.0 dropped `_all` and added
# `_get_id` and `_add_alloc_deps`). Its helpers -- ggml.c's
# `ggml_can_fuse_subgraph_ext`, the `.m`'s `ggml_metal_buffer_get_id` --
# are shared, so the comparison is of the table and the matching alone.
FRENAME=()
for f in get_id add_alloc_deps info_init info_free info_enabled info_stats info_debug \
         info_n_fusions info_label info_count info_count_fusion info_set_enabled \
         info_stats_init info_stats_reset info_stats_get info_labels_init next max; do
    FRENAME+=(-Dggml_metal_fusion_$f=ref_ggml_metal_fusion_$f)
done
"${CXX[@]}" "${FRENAME[@]}" "${CRENAME[@]}" -c llama.cpp/ggml/src/ggml-metal/ggml-metal-fusion.cpp \
    -o "$tmp/ref_fusion.o" 2>"$tmp/err" \
    || { echo "FAIL: cannot compile the renamed reference ggml-metal-fusion.cpp" >&2; head -10 "$tmp/err" >&2; exit 1; }
n=$(nm -gUj "$tmp/ref_fusion.o" | sed 's/^_//' | grep -c '^ref_ggml_metal_fusion_')
nplain=$(nm -gUj "$tmp/ref_fusion.o" | sed 's/^_//' | grep -c '^ggml_metal_fusion_')
echo "reference: $n fusion exports renamed to ref_*"
[ "$n" -eq 18 ] && [ "$nplain" -eq 0 ] || { echo "FAIL: expected 18 renamed fusion exports and none left, got $n and $nplain" >&2; exit 1; }

"${CXX[@]}" "${CRENAME[@]}" -c llama.cpp/ggml/src/ggml-metal/ggml-metal-common.cpp \
    -o "$tmp/ref_common.o" 2>"$tmp/err" \
    || { echo "FAIL: cannot compile the renamed reference ggml-metal-common.cpp" >&2; head -10 "$tmp/err" >&2; exit 1; }
n=$(nm -gUj "$tmp/ref_common.o" | sed 's/^_//' | grep -v '^_Z' | grep -c '^ref_')
nplain=$(nm -gUj "$tmp/ref_common.o" | sed 's/^_//' | grep -v '^_Z\|^ref_' | grep -c .)
echo "reference: $n common exports renamed to ref_*"
[ "$n" -eq 14 ] && [ "$nplain" -eq 0 ] || { echo "FAIL: expected 14 renamed common exports and none left, got $n and $nplain" >&2; exit 1; }

# The reference fusion table must call the renamed predicates, not ours.
for f in ggml_metal_op_mul_mat_use_mma ggml_metal_op_mul_mat_may_use_mma; do
    nm -uj "$tmp/ref_fusion.o" | sed 's/^_//' | grep -qx "ref_$f" \
        || { echo "FAIL: the reference fusion table does not call ref_$f" >&2; exit 1; }
done

# The op encoders (v0.5.0): `ggml-metal-ops.cpp` with **all** of its exports
# renamed -- read off a first compile, so the list cannot drift -- for the
# scratch-size queries `get_alloc_size` adds up. The reference
# `ggml-metal.cpp` above calls ours for those, so only this can compare them.
"${CXX[@]}" -c llama.cpp/ggml/src/ggml-metal/ggml-metal-ops.cpp -o "$tmp/ops_plain.o" 2>"$tmp/err" \
    || { echo "FAIL: cannot compile the reference ggml-metal-ops.cpp" >&2; head -10 "$tmp/err" >&2; exit 1; }
ORENAME=()
for f in $(nm -gUj "$tmp/ops_plain.o" | sed 's/^_//' | grep -v '^_Z\|__clang'); do
    ORENAME+=(-D$f=ref_$f)
done
"${CXX[@]}" "${ORENAME[@]}" -c llama.cpp/ggml/src/ggml-metal/ggml-metal-ops.cpp \
    -o "$tmp/ref_ops.o" 2>"$tmp/err" \
    || { echo "FAIL: cannot compile the renamed reference ggml-metal-ops.cpp" >&2; head -10 "$tmp/err" >&2; exit 1; }
n=$(nm -gUj "$tmp/ref_ops.o" | sed 's/^_//' | grep -v '^_Z' | grep -c '^ref_')
nplain=$(nm -gUj "$tmp/ref_ops.o" | sed 's/^_//' | grep -v '^_Z\|^ref_\|__clang' | grep -c .)
echo "reference: $n ops exports renamed to ref_*"
[ "$n" -eq ${#ORENAME[@]} ] && [ "$n" -gt 60 ] && [ "$nplain" -eq 0 ] || { echo "FAIL: ops renames: $n of ${#ORENAME[@]}, $nplain left" >&2; exit 1; }

# No "${RENAME[@]}" here: see the note above.
zig cc -mcpu=baseline harness/metal_diff.c -o "$tmp/metal_diff" -std=c11 -O2 \
    -I llama.cpp/ggml/include -I llama.cpp/ggml/src -I llama.cpp/ggml/src/ggml-metal \
    "$tmp/ref_metal.o" "$tmp/ref_fusion.o" "$tmp/ref_common.o" "$tmp/ref_ops.o" "$LIB" \
    -lc++ \
    -framework Foundation -framework Metal -framework MetalKit -framework Accelerate \
    -F "$SDK/System/Library/Frameworks" 2>"$tmp/berr" \
    || { echo "FAIL: could not build the harness" >&2; head -30 "$tmp/berr" >&2; exit 1; }

"$tmp/metal_diff" || exit 1

# The batched buffer slots again (v0.9.0), through the private buffer iface:
# the device decides shared or private once per process, from this variable.
echo
echo "=== batched buffer slots, private buffers ==="
GGML_METAL_SHARED_BUFFERS_DISABLE=1 METAL_DIFF_TENSOR_N_ONLY=1 "$tmp/metal_diff"
