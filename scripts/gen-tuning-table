#!/usr/bin/env python3
"""Regenerate the generated parts of `src/ggml/metal/tuning_table.zig`.

**Not a port.** The table is upstream's `fa_vec_tuned_table`, which its own
comment calls generated ("do not hand-edit"); v0.4.0 added 2,630 rows to
the 936 v0.3.0 had, which is past the point where copying by hand is
honest work. This splices these into the existing files and leaves their
prose alone:

- the rows of `fa_vec_tuned_table`, every `{ { ... }, { ... } },` line
  between the array's opening and closing lines, none skipped;
- the row-count assertion, so a dropped row fails to compile;
- the commit each citation and the provenance line name;
- `DeviceId` in `device_c.zig`, from `enum ggml_metal_device_id` in
  `ggml-metal-device.h`, in the enum's order.

**The key's first field changed meaning at v0.5.0.** Until v0.4.1 it was a
`GGML_METAL_DEVICE_*` enumerator and the table indexed the SKU enum by
ordinal; since v0.5.0 it is the Apple GPU family as a bare integer (7 to
10), and the rows carry `// AppleN - <SKUs>` comment lines between
families. A row in the old form now stops the script rather than being
read as something else, and so does any family outside `FAMILIES`: a new
one is a new family to sweep in `harness/tuning_diff.cpp`.

The count is cross-checked against an independent count of the C's rows
(the same lesson as `gen-kargs`: a generator must not check itself with
its own parse). `make tuning-diff` then proves the transcription by
comparing every lookup against the reference's.

Usage: scripts/gen-tuning-table
"""
import os
import re
import sys

from upstream_pin import COMMIT, TAG

ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
TUNING = os.path.join(ROOT, "llama.cpp/ggml/src/ggml-metal/ggml-metal-tuning.cpp")
DEVICE_H = os.path.join(ROOT, "llama.cpp/ggml/src/ggml-metal/ggml-metal-device.h")
OUT = os.path.join(ROOT, "src/ggml/metal/tuning_table.zig")
OUT_DEV = os.path.join(ROOT, "src/ggml/metal/device_c.zig")

# The families the table may name. `harness/tuning_diff.cpp` sweeps around
# them; a family outside this set must be added there too.
FAMILIES = {7, 8, 9, 10}

# ---------------------------------------------------------------- the enum
dev = open(DEVICE_H).read().split("\n")
enum_line = next(i for i, l in enumerate(dev, 1) if l.startswith("enum ggml_metal_device_id"))
names = []
for l in dev[enum_line:]:
    if l.strip().startswith("};"):
        break
    m = re.match(r"\s*GGML_METAL_DEVICE_(\w+)", l)
    if m:
        names.append(m.group(1).lower())
if names[0] != "generic":
    sys.exit("gen-tuning-table: the device enum no longer starts at GENERIC")

# ---------------------------------------------------------------- the rows
src = open(TUNING).read().split("\n")
table_line = next(i for i, l in enumerate(src, 1) if "fa_vec_tuned_table[]" in l)
row_re = re.compile(
    r"^\s*\{\s*\{\s*(\d+)\s*,\s*GGML_TYPE_(\w+)\s*,\s*(-?\d+)\s*,\s*(-?\d+)\s*,"
    r"\s*(-?\d+)\s*,\s*(-?\d+)\s*\}\s*,\s*\{\s*(-?\d+)\s*,\s*(-?\d+)\s*\}\s*\}\s*,\s*$")
fam_re = re.compile(r"^\s*// Apple(\d+) - [A-Z0-9_, ]+$")
rows = []
seen_fams = []
for l in src[table_line:]:
    if l.strip().startswith("};"):
        break
    m = row_re.match(l)
    if m:
        rows.append(m.groups())
    elif fam_re.match(l):
        seen_fams.append(int(fam_re.match(l).group(1)))
    elif l.strip():
        # Anything else in the array -- a row in another form, a comment of
        # another shape -- stops the script rather than being skipped.
        sys.exit("gen-tuning-table: a table line did not parse: %r" % l)

# An independent count: every line in the array that opens a row.
end = next(i for i in range(table_line, len(src)) if src[i].strip().startswith("};"))
independent = sum(1 for l in src[table_line:end] if l.strip().startswith("{ {"))
if independent != len(rows):
    sys.exit("gen-tuning-table: parsed %d rows, the array holds %d" % (len(rows), independent))
for r in rows:
    if int(r[0]) not in FAMILIES:
        sys.exit("gen-tuning-table: row names family %s, outside %s" % (r[0], sorted(FAMILIES)))
# Each family's rows sit under its own `// AppleN` comment.
fam_of_rows = []
for r in rows:
    if not fam_of_rows or fam_of_rows[-1] != int(r[0]):
        fam_of_rows.append(int(r[0]))
if fam_of_rows != seen_fams:
    sys.exit("gen-tuning-table: the rows' families %s do not follow the comments %s" % (fam_of_rows, seen_fams))

# ---------------------------------------------------------------- splice
z = open(OUT).read()

def splice(text, start_pat, end_pat, body, what):
    m = re.search(start_pat, text, re.M)
    if not m:
        sys.exit("gen-tuning-table: cannot find the start of " + what)
    e = text.find(end_pat, m.end())
    if e < 0:
        sys.exit("gen-tuning-table: cannot find the end of " + what)
    return text[: m.end()] + body + text[e:]

d = open(OUT_DEV).read()
d = splice(d, r"^pub const DeviceId = enum\(c_uint\) \{\n", "};",
           "".join("    %s%s,\n" % (n, " = 0" if i == 0 else "") for i, n in enumerate(names)), "DeviceId")
d = re.sub(r"/// Mirrors `enum ggml_metal_device_id` \(ggml-metal-device\.h:\d+ @\w+\)",
           "/// Mirrors `enum ggml_metal_device_id` (ggml-metal-device.h:%d @%s)" % (enum_line, COMMIT), d)
open(OUT_DEV, "w").write(d)
z = re.sub(r"/// Mirrors `fa_vec_tuned_table` \(ggml-metal-tuning\.cpp:\d+ @\w+\)",
           "/// Mirrors `fa_vec_tuned_table` (ggml-metal-tuning.cpp:%d @%s)" % (table_line, COMMIT), z)
z = splice(z, r"^pub const fa_vec_tuned_table = \[_\]Entry\{\n", "};",
           "".join("    .{ .key = .{ .family = %s, .dtype = c.GGML_TYPE_%s, .dk = %s, .dv = %s,"
                   " .ne11_b = %s, .ne01_b = %s }, .cfg = .{ .Q = %s, .NE = %s } },\n"
                   % (f, t, dk, dv, a, b, q, ne) for f, t, dk, dv, a, b, q, ne in rows), "the table")
z = re.sub(r"std\.debug\.assert\(fa_vec_tuned_table\.len == \d+\);",
           "std.debug.assert(fa_vec_tuned_table.len == %d);" % len(rows), z)
z = re.sub(r"//! all at v[\d.]+ \(`\w+`\)\.", "//! all at %s (`%s`)." % (TAG, COMMIT), z)
open(OUT, "w").write(z)
print("%d device ids; %d rows over GPU families %s" % (len(names), len(rows), ", ".join("Apple%d" % f for f in seen_fams)))
