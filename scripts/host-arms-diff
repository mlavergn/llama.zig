#!/bin/bash
# Diff the CPU backend's host arms -- thread priority, CPU affinity, NUMA and
# the sampler's default seed -- ported against reference.
#
# harness/host_arms.c is built twice, against the stock libraries from
# `llama.cpp.zmake` and against ours, and every scenario it lists runs once
# per side, each in a fresh process. What is compared is what the OS says each
# thread ended up with -- policy, priority, affinity -- and every message
# either side printed: stdout exactly, stderr sorted, because worker threads
# print their warnings in whatever order they run.
#
# Why this exists
# ---------------
# The Linux host arms of `ggml-cpu.c` and `llama-sampler.cpp` were ported on a
# Mac that cannot run them (PLAN.md, Stage 5 step 3). Nothing that compares
# results can see them: a thread at the wrong priority or on the wrong CPU
# computes the same bits. On macOS this still runs, and covers the Apple arms
# -- `SCHED_FIFO` priorities, no affinity, no NUMA, `arc4random` seeds; on
# Linux it is the gate for the `__linux__` and `__gnu_linux__` arms.
#
# One normalisation, and it is the C's: "failed to set affinity mask 0x%llx"
# prints the *address* of the mask, not the mask, so the hex value is
# replaced before comparing.
#
# Usage: scripts/host-arms-diff
#   Requires: make -C llama.cpp.zmake lib, zig build reference
#   HOST_ARMS_OUT=<dir> keeps both transcripts.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

. "$ROOT/scripts/check-reference-pin"
. "$ROOT/scripts/platform-libs"
platform_libs cc

REF_LIBS=(llama.cpp.zmake/zig-out/lib/libllama.a llama.cpp.zmake/zig-out/lib/libggml.a)
PORT_LIBS=(zig-out/lib/libllama.a zig-out/lib/libggml.a)
for lib in "${REF_LIBS[@]}" "${PORT_LIBS[@]}"; do
    [ -f "$lib" ] || { echo "missing $lib -- run 'make host-arms-diff'" >&2; exit 2; }
done

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

INC=(-I llama.cpp/include -I llama.cpp/ggml/include)
for side in ref port; do
    if [ "$side" = ref ]; then libs=("${REF_LIBS[@]}"); else libs=("${PORT_LIBS[@]}"); fi
    zig cc harness/host_arms.c -o "$tmp/$side" -std=c11 -O2 "${INC[@]}" "${libs[@]}" -lc++ \
        ${PLATFORM_LIBS[@]+"${PLATFORM_LIBS[@]}"} 2>"$tmp/$side.log" \
        || { echo "FAIL: could not link against the $side libraries" >&2; tail -5 "$tmp/$side.log" >&2; exit 1; }
done

normalise() { sed -E 's/(failed to set affinity mask )0x[0-9a-f]+/\10xADDR/'; }

scenarios="$("$tmp/ref" list)" || { echo "FAIL: the reference could not list its scenarios" >&2; exit 1; }
[ -n "$scenarios" ] || { echo "FAIL: no scenarios" >&2; exit 1; }

fail=0
n=0
for s in $scenarios; do
    for side in ref port; do
        "$tmp/$side" run "$s" > "$tmp/$side.$s.out" 2> "$tmp/$side.$s.err.raw"
        echo "exit=$?" >> "$tmp/$side.$s.out"
        normalise < "$tmp/$side.$s.out" > "$tmp/$side.$s.txt"
        { echo "-- stderr, sorted"; normalise < "$tmp/$side.$s.err.raw" | sort; } >> "$tmp/$side.$s.txt"
    done
    n=$((n + 1))
    if diff -q "$tmp/ref.$s.txt" "$tmp/port.$s.txt" > /dev/null; then
        printf '  %-20s identical\n' "$s"
    else
        printf '  %-20s DIFFERS\n' "$s"
        diff "$tmp/ref.$s.txt" "$tmp/port.$s.txt" | head -20 | sed 's/^/      /'
        fail=1
    fi
done

if [ -n "${HOST_ARMS_OUT:-}" ]; then
    mkdir -p "$HOST_ARMS_OUT" && cp "$tmp"/ref.*.txt "$tmp"/port.*.txt "$HOST_ARMS_OUT/"
fi

if [ "$fail" -eq 0 ]; then
    echo "PASS: $n host-arm scenarios identical, ported vs reference ($(uname -s))"
    exit 0
fi
echo "FAIL: host-arm behaviour differs between ported and reference builds"
exit 1
