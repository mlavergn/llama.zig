#!/bin/bash
# Compare src/llama/batch.zig with llama.cpp's llama-batch.cpp, in one process.
#
# The batch allocator is ported ahead of libllama's single swap (PLAN.md,
# Decision 42), so nothing downstream can see it yet. This drives the C++
# llama_batch_allocr in libllama-ref.a (harness/batch_ref.cpp) and the port side
# by side on hand-built and random batches, and compares what init logs and
# answers, the sanitized batch, and every ubatch of every split mode. See
# harness/batch_diff.zig for what is compared.
#
# Usage: scripts/batch-diff [seed]
#   Requires: zig build reference --release=fast
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

for lib in zig-out/lib/libllama-ref.a zig-out/lib/libggml.a; do
    [ -f "$lib" ] || { echo "missing $lib -- run 'zig build reference --release=fast'" >&2; exit 2; }
done

VOCAB=llama.cpp/models/ggml-vocab-qwen35.gguf
[ -f "$VOCAB" ] || { echo "missing $VOCAB" >&2; exit 2; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

SDK="$(xcrun --sdk macosx --show-sdk-path)"

zig c++ -mcpu=baseline -c harness/batch_ref.cpp -o "$tmp/batch_ref.o" -std=c++17 -O2 -w \
    -I llama.cpp/src -I llama.cpp/include -I llama.cpp/ggml/include -I llama.cpp/ggml/src 2>"$tmp/cerr" \
    || { echo "FAIL: cannot compile harness/batch_ref.cpp" >&2; head -20 "$tmp/cerr" >&2; exit 1; }

# Zig 0.17 has no `@cImport`: `impl.zig` imports llama.h and gguf.h as the module
# `llama_c`, translated from `src/llama/c_import.h` as build/llamacpp.zig does.
zig translate-c -lc -I llama.cpp/include -I llama.cpp/ggml/include \
    src/llama/c_import.h >"$tmp/llama_c.zig" 2>"$tmp/terr" \
    || { echo "FAIL: cannot translate llama.h" >&2; head -10 "$tmp/terr" >&2; exit 1; }

# ReleaseSafe, not ReleaseFast: nothing here is compared on float arithmetic,
# and the port's integer narrowing and bounds are checked.
zig build-exe -mcpu baseline -femit-bin="$tmp/batch_diff" -OReleaseSafe -lc \
    --dep harness_root -Mroot=harness/batch_diff.zig \
    --dep llama_c -Mharness_root=src/llama/harness_root.zig -Mllama_c="$tmp/llama_c.zig" \
    "$tmp/batch_ref.o" zig-out/lib/libllama-ref.a zig-out/lib/libggml.a -lc++ \
    -framework Foundation -framework Metal -framework MetalKit -framework Accelerate \
    -F "$SDK/System/Library/Frameworks" 2>"$tmp/berr" \
    || { echo "FAIL: could not build the harness" >&2; head -40 "$tmp/berr" >&2; exit 1; }

shasum "$tmp/batch_diff" | sed 's/ .*//; s/^/  harness binary sha1 /'
"$tmp/batch_diff" "$VOCAB" "$@"
