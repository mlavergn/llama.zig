#!/bin/bash
# Compare src/llama/chat.zig with llama.cpp's llama-chat.cpp, in one process.
#
# The built-in chat templates are ported ahead of libllama's single swap
# (PLAN.md, Decision 42), so nothing downstream can see them yet. This links
# the C++ in libllama-ref.a (harness/chat_ref.cpp for the C++-linkage functions)
# beside the port and compares template names, detection on every built-in
# name, every marker llm_chat_detect_template tests and every chat template
# upstream ships, and the formatted output of every template over fixed and
# random conversations. See harness/chat_diff.zig for what is compared.
#
# Usage: scripts/chat-diff [extra.gguf|extra.jinja...]
#   Requires: zig build reference --release=fast
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

for lib in zig-out/lib/libllama-ref.a zig-out/lib/libggml.a; do
    [ -f "$lib" ] || { echo "missing $lib -- run 'zig build reference --release=fast'" >&2; exit 2; }
done

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

SDK="$(xcrun --sdk macosx --show-sdk-path)"

zig c++ -mcpu=baseline -c harness/chat_ref.cpp -o "$tmp/chat_ref.o" -std=c++17 -O2 -w \
    -I llama.cpp/src -I llama.cpp/include -I llama.cpp/ggml/include 2>"$tmp/cerr" \
    || { echo "FAIL: cannot compile harness/chat_ref.cpp" >&2; head -20 "$tmp/cerr" >&2; exit 1; }

# Zig 0.17 has no `@cImport`: `impl.zig` imports llama.h and gguf.h as the module
# `llama_c`, translated from `src/llama/c_import.h` as build/llamacpp.zig does.
zig translate-c -lc -I llama.cpp/include -I llama.cpp/ggml/include \
    src/llama/c_import.h >"$tmp/llama_c.zig" 2>"$tmp/terr" \
    || { echo "FAIL: cannot translate llama.h" >&2; head -10 "$tmp/terr" >&2; exit 1; }

zig build-exe -mcpu baseline -femit-bin="$tmp/chat_diff" -Ofast -lc \
    --dep harness_root -Mroot=harness/chat_diff.zig \
    --dep llama_c -Mharness_root=src/llama/harness_root.zig -Mllama_c="$tmp/llama_c.zig" \
    "$tmp/chat_ref.o" zig-out/lib/libllama-ref.a zig-out/lib/libggml.a -lc++ \
    -framework Foundation -framework Metal -framework MetalKit -framework Accelerate \
    -F "$SDK/System/Library/Frameworks" 2>"$tmp/berr" \
    || { echo "FAIL: could not build the harness" >&2; head -40 "$tmp/berr" >&2; exit 1; }

sources=(llama.cpp/models/ggml-vocab-*.gguf llama.cpp/models/templates/*.jinja)
for m in Qwen3.5-*.gguf; do
    [ -f "$m" ] && sources+=("$m")
done

"$tmp/chat_diff" llama.cpp/src/llama-chat.cpp "${sources[@]}" "$@"
