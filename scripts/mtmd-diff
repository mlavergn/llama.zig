#!/bin/bash
# Compare libmtmd's port (src/mtmd/) with upstream's, through mtmd.h and
# mtmd-helper.h, on every mmproj fixture: each fixture runs once per side in
# its own process, on the CPU and on the GPU, with every encoder node hashed
# (`nodes`) and without (`fused`, so the scheduler fuses as it would), and
# the two transcripts must be identical. See harness/mtmd_diff.zig.
#
# Usage: scripts/mtmd-diff [cpu|gpu|both] [type-filter]
#   MTMD_DIFF_OUT=<dir>   keep every transcript
#   MTMD_DIFF_O=safe      build the harness ReleaseSafe (the libraries stay
#                         as built)
#   Requires: zig build reference mtmd-ref --release=fast and
#             scripts/gen-mmproj-fixtures
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

DEVS="${1:-both}"
FILTER="${2:-}"
MANIFEST=zig-out/mmproj-fixtures/manifest.txt

for f in zig-out/lib/libmtmd-ref.a zig-out/lib/libllama-ref.a zig-out/lib/libggml.a "$MANIFEST"; do
    [ -f "$f" ] || { echo "missing $f -- run 'zig build reference mtmd-ref --release=fast' and scripts/gen-mmproj-fixtures" >&2; exit 2; }
done

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
OUT="${MTMD_DIFF_OUT:-$tmp/out}"
mkdir -p "$OUT"

. scripts/platform-libs
platform_libs exe

zig translate-c -lc -I llama.cpp/include -I llama.cpp/ggml/include \
    src/llama/c_import.h >"$tmp/llama_c.zig" 2>"$tmp/terr" \
    || { echo "FAIL: cannot translate llama.h" >&2; head -10 "$tmp/terr" >&2; exit 1; }
printf '#include "mtmd.h"\n#include "mtmd-helper.h"\n' >"$tmp/mtmd_c.h"
zig translate-c -lc -I llama.cpp/include -I llama.cpp/ggml/include -I llama.cpp/tools/mtmd \
    "$tmp/mtmd_c.h" >"$tmp/mtmd_c.zig" 2>"$tmp/terr" \
    || { echo "FAIL: cannot translate mtmd.h" >&2; head -10 "$tmp/terr" >&2; exit 1; }

OPT=-OReleaseFast
[ "${MTMD_DIFF_O:-}" = safe ] && OPT=-OReleaseSafe
zig build-exe -mcpu baseline -femit-bin="$tmp/mtmd_diff" "$OPT" -lc \
    --dep harness_root --dep mtmd_port --dep llama_c --dep mtmd_c -Mroot=harness/mtmd_diff.zig \
    --dep llama_c -Mharness_root=src/llama/harness_root.zig \
    --dep llama=harness_root -Mmtmd_port=src/mtmd/harness_root.zig \
    -Mllama_c="$tmp/llama_c.zig" -Mmtmd_c="$tmp/mtmd_c.zig" \
    zig-out/lib/libmtmd-ref.a zig-out/lib/libllama-ref.a zig-out/lib/libggml.a -lc++ \
    "${PLATFORM_LIBS[@]}" 2>"$tmp/berr" \
    || { echo "FAIL: could not build the harness" >&2; head -60 "$tmp/berr" >&2; exit 1; }

case "$DEVS" in
    both) devs="cpu gpu" ;;
    *) devs="$DEVS" ;;
esac

# timings and addresses vary run to run; nothing else may
mask() {
    # an abort names its source as the compiler saw it: upstream's C++ by
    # path, the port by file name
    sed -E -e 's/[0-9]+(\.[0-9]+)? ?(ms|sec|s)([^a-zA-Z0-9]|$)/N\2\3/g' -e 's/0x[0-9a-f]{6,}/0xADDR/g' \
        -e 's#[^ :]*/([^/ :]+\.(cpp|c|h|zig)):([0-9]+):#\1:\3:#g' "$1"
}

n_ok=0
n_abort=0
n_fail=0
failed=()
while IFS=$'\t' read -r proj mmproj text modality inputs; do
    [ -n "$proj" ] || continue
    if [ -n "$FILTER" ] && [[ "$proj" != *"$FILTER"* ]]; then continue; fi
    for dev in $devs; do
        for mode in nodes fused; do
            tag="$proj.$dev.$mode"
            for side in ref port; do
                d="$tmp/run.$side"
                mkdir -p "$d"
                "$tmp/mtmd_diff" "$side" "$dev" "$mode" "$d" "$proj" "$mmproj" "$text" "$modality" "$inputs" \
                    >"$OUT/$tag.$side.raw" 2>"$OUT/$tag.$side.err"
                rc=$?
                mask "$OUT/$tag.$side.raw" >"$OUT/$tag.$side"
                # an abort's message must match; its backtrace is the
                # threads' and interleaves differently run to run
                grep -v -E '^[0-9]+ +[A-Za-z_.]+ +0x' "$OUT/$tag.$side.err" | mask /dev/stdin >>"$OUT/$tag.$side"
                echo "[exit $rc]" >>"$OUT/$tag.$side"
            done
            if cmp -s "$OUT/$tag.ref" "$OUT/$tag.port"; then
                n_ok=$((n_ok + 1))
                grep -q '^\[exit 0\]$' "$OUT/$tag.ref" || n_abort=$((n_abort + 1))
            else
                n_fail=$((n_fail + 1))
                failed+=("$tag")
                echo "FAIL $tag ($(wc -l <"$OUT/$tag.ref") ref lines)"
                diff "$OUT/$tag.ref" "$OUT/$tag.port" | head -8
            fi
        done
    done
done <"$MANIFEST"

echo "mtmd-diff: $n_ok identical ($n_abort of them aborting alike on both sides), $n_fail different"
[ "$n_fail" -eq 0 ] || { printf '  %s\n' "${failed[@]}"; exit 1; }
