#!/bin/bash
# Compare cli/chat.zig's chat-template rendering with upstream's Jinja engine.
#
# Our llama-cli renders a model's chat template through `zigjinja`
# (PLAN.md, Decisions 25 and 27); upstream's renders it through
# `llama.cpp/common/jinja`. Nothing else checks that the two engines agree on
# the templates models actually ship, so this compiles upstream's engine
# unmodified beside `chat.zig` and renders every template in
# `llama.cpp/models/templates/` over a fixed set of conversations through
# both: the text, which side raises, and that ours never trusts a byte
# upstream marks as input. See harness/jinja_diff.zig.
#
# Usage: scripts/jinja-diff [template name substring]
#   Requires: zig build reference --release=fast (for libggml.a, which
#   common/json.cpp reaches for GGML_ASSERT)
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

. scripts/win-target

# llama.cpp.zmake's include paths for common/ (`addCommonIncludes`), less
# `src`, whose unicode.h would shadow common/unicode.h.
CXX=(zig c++ "${GATE_CC[@]}" -std=c++17 -O2 -w
     -I llama.cpp -I llama.cpp/include -I llama.cpp/common
     -I llama.cpp/ggml/include -I llama.cpp/ggml/src -I llama.cpp/vendor)
SRCS=(llama.cpp/common/jinja/{lexer,parser,runtime,value,string,caps}.cpp
      llama.cpp/common/json.cpp llama.cpp/common/unicode.cpp harness/jinja_ref.cpp)
OBJS=()
for src in "${SRCS[@]}"; do
    o="$tmp/$(basename "$(dirname "$src")")_$(basename "$src" .cpp).o"
    "${CXX[@]}" -c "$src" -o "$o" 2>"$tmp/err" &
    OBJS+=("$o")
done
wait
for o in "${OBJS[@]}"; do
    [ -f "$o" ] || { echo "FAIL: cannot compile the reference ($o)" >&2; head -10 "$tmp/err" >&2; exit 1; }
done

# The templates, compiled into the harness as the `inputs` module.
mkdir "$tmp/inputs"
{
    echo '//! Generated by scripts/jinja-diff: the templates, embedded.'
    echo 'pub const Template = struct { name: []const u8, source: []const u8 };'
    echo 'pub const templates = [_]Template{'
    for f in llama.cpp/models/templates/*.jinja; do
        b="$(basename "$f")"
        cp "$f" "$tmp/inputs/$b"
        echo "    .{ .name = \"${b%.jinja}\", .source = @embedFile(\"$b\") },"
    done
    echo '};'
} > "$tmp/inputs/inputs.zig"

[ -f "$GATE_GGML" ] || { echo "missing $GATE_GGML -- run 'zig build reference --release=fast'" >&2; exit 2; }

# `chat.zig` imports llama.h through `c.zig`; nothing here calls into it.
zig translate-c "${GATE_TC[@]}" -I llama.cpp/include -I llama.cpp/ggml/include \
    src/llama/c_import.h >"$tmp/llama_h.zig" 2>"$tmp/terr" \
    || { echo "FAIL: cannot translate llama.h" >&2; head -10 "$tmp/terr" >&2; exit 1; }

# zigjinja as build.zig.zon takes it: the sibling checkout, by path.
zig build-exe "${GATE_EXE[@]}" -femit-bin="$tmp/jinja_diff$GATE_SUFFIX" -Ofast -lc \
    --dep chat --dep zigjinja --dep inputs -Mroot=harness/jinja_diff.zig \
    --dep zigjinja --dep llama_h -Mchat=cli/chat.zig \
    -Mzigjinja=../zigjinja/src/root.zig -Mllama_h="$tmp/llama_h.zig" \
    -Minputs="$tmp/inputs/inputs.zig" \
    "${OBJS[@]}" "$GATE_GGML" -lc++ \
    ${PLATFORM_LIBS[@]+"${PLATFORM_LIBS[@]}"} 2>"$tmp/berr" \
    || { echo "FAIL: could not build the harness" >&2; head -30 "$tmp/berr" >&2; exit 1; }

# Upstream's `strftime_now` formats local time and zigjinja's formats UTC,
# so a template that prints today's date (Llama 3.x) agrees only while the
# two dates coincide. UTC makes the verdict independent of when it runs; the
# divergence itself is recorded in NOTES.md, "jinja-diff".
export TZ=UTC
gate_run "$tmp/jinja_diff$GATE_SUFFIX" llamazig-jinja-diff "$@"
