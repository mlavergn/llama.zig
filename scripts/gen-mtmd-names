#!/usr/bin/env python3
"""Generate `clip-impl.h`'s name tables as Zig: `src/mtmd/names.zig`.

`clip-impl.h` holds ~340 `#define KEY_*` / `TN_*` string macros -- the GGUF
metadata keys and tensor-name formats `clip.cpp` reads -- and the
`projector_type` enum with its `PROJECTOR_TYPE_NAMES` map. All of it is
transcription, so it is generated rather than typed. A `%s` / `%d` in a
format stays as the C wrote it: the port formats with the C's `snprintf`.

Two things about the source honoured rather than smoothed over:

- **Enum order is the C's**, so a projector compared by ordinal is the same
  projector on both sides.
- **Two macros are defined twice**, identically (`TN_MM_GATE`,
  `TN_A_DOWNSAMPLE_CONV`); the generator asserts the texts agree.
- **The name map is a `std::map` keyed on the enum**, so
  `clip_projector_type_from_string` walks it in enum order and returns the
  first match; a type the map omits has no name (`PROJECTOR_TYPE_UNKNOWN`
  among them).

Usage: scripts/gen-mtmd-names > src/mtmd/names.zig
"""
import re, sys, os

root = os.path.join(os.path.dirname(__file__), '..')
src = open(os.path.join(root, 'llama.cpp/tools/mtmd/clip-impl.h')).read()
lines = src.split('\n')

defs = []
seen = {}
for i, l in enumerate(lines, 1):
    m = re.match(r'#define\s+((?:KEY|TN)_\w+)\s+"((?:[^"\\]|\\.)*)"', l)
    if m:
        # a macro the header defines twice: the preprocessor accepts an
        # identical redefinition, and the first line is the one cited
        if m.group(1) in seen:
            assert seen[m.group(1)] == m.group(2), m.group(1)
            continue
        seen[m.group(1)] = m.group(2)
        defs.append((m.group(1), m.group(2), i))

enum_start = next(i for i, l in enumerate(lines) if l.startswith('enum projector_type'))
types = []
for i in range(enum_start + 1, len(lines)):
    l = lines[i].strip()
    if l.startswith('};'):
        break
    m = re.match(r'(PROJECTOR_TYPE_\w+)', l)
    if m:
        types.append((m.group(1), i + 1))

map_start = next(i for i, l in enumerate(lines) if 'PROJECTOR_TYPE_NAMES' in l and 'std::map' in l)
names = {}
for i in range(map_start + 1, len(lines)):
    l = lines[i]
    if l.strip().startswith('};'):
        break
    m = re.search(r'\{\s*(PROJECTOR_TYPE_\w+)\s*,\s*"([^"]*)"\s*\}', l)
    if m and m.group(1) not in names:  # a map keeps the first of a repeated key
        names[m.group(1)] = m.group(2)

out = []
w = out.append
w('//! The metadata keys, tensor-name formats and projector types of')
w('//! `llama.cpp/tools/mtmd/clip-impl.h` (v0.3.0, `c1d0e7a00`), generated by')
w('//! `scripts/gen-mtmd-names`. Do not edit: regenerate when the pin moves.')
w('')
w('const std = @import("std");')
w('')
for name, val, line in defs:
    w(f'/// `{name}` (clip-impl.h:{line} @c1d0e7a00).')
    w(f'pub const {name} = "{val}";')
w('')
w(f'/// Ports `projector_type` (clip-impl.h:{enum_start + 1} @c1d0e7a00), in the C\'s order.')
w('pub const ProjectorType = enum(c_int) {')
for t, line in types:
    w(f'    {t[len("PROJECTOR_TYPE_"):].lower()},')
w('};')
w('')
w(f'/// `PROJECTOR_TYPE_NAMES` (clip-impl.h:{map_start + 1} @c1d0e7a00), indexed by')
w('/// ordinal; null where the map has no entry.')
w('pub const projector_type_names = [_]?[:0]const u8{')
for t, line in types:
    v = names.get(t)
    w(f'    "{v}",' if v is not None else '    null,')
w('};')
w('')
w('/// Ports `clip_projector_type_from_string` (clip-impl.h:569 @c1d0e7a00): the')
w('/// first type, in enum order, whose name is `s`.')
w('pub fn projectorTypeFromString(s: []const u8) ProjectorType {')
w('    for (projector_type_names, 0..) |n, i| {')
w('        if (n) |name| {')
w('            if (std.mem.eql(u8, name, s)) return @enumFromInt(i);')
w('        }')
w('    }')
w('    return .unknown;')
w('}')
w('')
w('/// The name `PROJECTOR_TYPE_NAMES[t]` gives, or null.')
w('pub fn projectorTypeName(t: ProjectorType) ?[:0]const u8 {')
w('    const i: usize = @intCast(@intFromEnum(t));')
w('    return if (i < projector_type_names.len) projector_type_names[i] else null;')
w('}')
w('')
w('// ' + '-' * 77)
w('// Unit Tests')
w('')
w('test {')
w('    std.testing.refAllDecls(@This());')
w('}')
print('\n'.join(out))
