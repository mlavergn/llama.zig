#!/bin/bash
# Compare cli/peg/ and cli/common_chat/chat_peg.zig with upstream's
# peg-parser.cpp and chat-peg-parser.cpp.
#
# Upstream's libllama-common (`zig build common-ref`, which this runs) holds
# the C++ unmodified; harness/peg_ref.cpp interprets a bytecode of builder
# calls over it, and harness/peg_diff.zig the same bytecode over the port,
# and every record -- the build, the arena's dump, JSON form and GBNF, every
# parse complete, lenient and of every prefix with its AST, the three chat
# mappers' messages, the tagged parser, the debug trace, the class and
# what() of every exception -- must be identical. The cases are upstream's
# own: its PEG tests are compiled with harness/peg_rec.h force-included,
# which records every parser they build and every input they parse, and
# must still pass; then random descriptions, chat grammars over random
# tools, and Gemma 4- and MiniMax-M3-shaped grammars (upstream removed the
# arena's save and load at v0.7.0, and with them the mutated saved arenas).
# See harness/peg_diff.zig.
#
# Usage: scripts/peg-diff [case label substring]
#   PEG_DIFF_SEED=n, PEG_DIFF_SCALE=n, PEG_DIFF_STATS=1 as the harness
#   takes them; PEG_DIFF_O=ReleaseFast|ReleaseSafe|Debug (default
#   ReleaseSafe); PEG_DIFF_KEEP=<path> keeps the harness binary
#   Requires: zig build reference --release=fast (libllama-ref.a, libggml.a)
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

. scripts/win-target
PLATFORM_LIBS_EXE=(${PLATFORM_LIBS[@]+"${PLATFORM_LIBS[@]}"})
PLATFORM_LIBS_CC=()
if [ -z "${WIN_X86:-}" ]; then
    platform_libs cc
    PLATFORM_LIBS_CC=(${PLATFORM_LIBS[@]+"${PLATFORM_LIBS[@]}"})
    PLATFORM_LIBS=(${PLATFORM_LIBS_EXE[@]+"${PLATFORM_LIBS_EXE[@]}"})
fi

if [ -z "${PEG_DIFF_NO_TOOLS_REF:-}" ]; then
    zig build common-ref --release=fast ${GATE_BUILD[@]+"${GATE_BUILD[@]}"} >"$tmp/tref" 2>&1 \
        || { echo "FAIL: could not build the reference library (zig build common-ref)" >&2; tail -20 "$tmp/tref" >&2; exit 2; }
fi
COMMON="$GATE_COMMON_REF"
for lib in "$COMMON" "$GATE_LLAMA_REF" "$GATE_GGML"; do
    [ -f "$lib" ] || { echo "missing $lib -- run 'zig build reference common-ref --release=fast'" >&2; exit 2; }
done

CXX=(zig c++ "${GATE_CC[@]}" -std=c++17 -O2 -DNDEBUG -w
     -I llama.cpp -I llama.cpp/include -I llama.cpp/common
     -I llama.cpp/ggml/include -I llama.cpp/ggml/src -I llama.cpp/vendor)
TESTS=(llama.cpp/tests/peg-parser/test-basic.cpp llama.cpp/tests/peg-parser/test-gbnf-generation.cpp
       llama.cpp/tests/peg-parser/test-json-parser.cpp
       llama.cpp/tests/peg-parser/test-python-dict-parser.cpp llama.cpp/tests/peg-parser/test-unicode.cpp
       llama.cpp/tests/peg-parser/simple-tokenize.cpp)

# Upstream's own tests, as upstream builds them, must pass on the reference
# before the reference is used to judge anything.
UOBJS=()
for src in "${TESTS[@]}"; do
    o="$tmp/u-$(basename "$src" .cpp).o"
    "${CXX[@]}" -c "$src" -o "$o" 2>"$o.err" &
    UOBJS+=("$o")
done
"${CXX[@]}" -c llama.cpp/tests/test-peg-parser.cpp -o "$tmp/u-main.o" 2>"$tmp/u-main.err" &
"${CXX[@]}" -c llama.cpp/tests/test-chat-peg-parser.cpp -o "$tmp/u-chat.o" 2>"$tmp/u-chat.err" &
# ... and with the recorder force-included, for the harness
ROBJS=()
for src in "${TESTS[@]}"; do
    o="$tmp/r-$(basename "$src" .cpp).o"
    "${CXX[@]}" -include harness/peg_rec.h -c "$src" -o "$o" 2>"$o.err" &
    ROBJS+=("$o")
done
"${CXX[@]}" -include harness/peg_rec.h -Dmain=peg_test_main -c llama.cpp/tests/test-peg-parser.cpp -o "$tmp/r-main.o" 2>"$tmp/r-main.err" &
"${CXX[@]}" -include harness/peg_rec.h -Dmain=peg_chat_test_main -c llama.cpp/tests/test-chat-peg-parser.cpp -o "$tmp/r-chat.o" 2>"$tmp/r-chat.err" &
"${CXX[@]}" -c harness/peg_ref.cpp -o "$tmp/peg_ref.o" 2>"$tmp/peg_ref.err" &
wait
for o in "${UOBJS[@]}" "$tmp/u-main.o" "$tmp/u-chat.o" "${ROBJS[@]}" "$tmp/r-main.o" "$tmp/r-chat.o" "$tmp/peg_ref.o"; do
    [ -f "$o" ] || { echo "FAIL: cannot compile ($o)" >&2; head -10 "${o%.o}.err" "$o.err" 2>/dev/null >&2; exit 1; }
done

LIBS=("$COMMON" "$GATE_LLAMA_REF" "$GATE_GGML")
for t in main chat; do
    objs=("$tmp/u-$t.o")
    [ "$t" = main ] && objs+=("${UOBJS[@]}") || objs+=("$tmp/u-simple-tokenize.o")
    "${CXX[@]}" -o "$tmp/upstream-$t$GATE_SUFFIX" "${objs[@]}" "${LIBS[@]}" ${PLATFORM_LIBS_CC[@]+"${PLATFORM_LIBS_CC[@]}"} 2>"$tmp/uerr" \
        || { echo "FAIL: cannot build upstream's PEG test ($t)" >&2; head -10 "$tmp/uerr" >&2; exit 1; }
    if [ -z "${WIN_X86:-}" ]; then
        "$tmp/upstream-$t" >"$tmp/ulog" 2>&1 \
            || { echo "FAIL: upstream's PEG test ($t) fails on the reference" >&2; tail -20 "$tmp/ulog" >&2; exit 1; }
    fi
done
[ -z "${WIN_X86:-}" ] && echo "upstream's test-peg-parser and test-chat-peg-parser: pass on the reference"

# regex.zig and libcxx.zig are reached through libllama's harness root.
zig translate-c "${GATE_TC[@]}" -I llama.cpp/include -I llama.cpp/ggml/include \
    src/llama/c_import.h >"$tmp/llama_c.zig" 2>"$tmp/terr" \
    || { echo "FAIL: cannot translate llama.h" >&2; head -10 "$tmp/terr" >&2; exit 1; }

# The port's own unit tests first: all of cli/common_chat, whose templates
# render through zigjinja.
# For Windows they are only compiled: they cannot run here.
zig test "${GATE_EXE[@]}" ${WIN_X86:+--test-no-exec} -lc \
    --dep json --dep peg --dep llama --dep zigjinja -Mroot=cli/common_chat/module.zig \
    --dep json --dep llama -Mpeg=cli/peg/module.zig \
    --dep llama -Mjson=cli/json/module.zig -Mzigjinja=../zigjinja/src/root.zig \
    --dep llama_c -Mllama=src/llama/harness_root.zig -Mllama_c="$tmp/llama_c.zig" \
    "$GATE_GGML" -lc++ ${PLATFORM_LIBS[@]+"${PLATFORM_LIBS[@]}"} >"$tmp/zt" 2>&1 \
    || { echo "FAIL: the unit tests of cli/peg and cli/common_chat" >&2; tail -30 "$tmp/zt" >&2; exit 1; }

zig build-exe "${GATE_EXE[@]}" --gc-sections -femit-bin="$tmp/peg_diff$GATE_SUFFIX" -O"${PEG_DIFF_O:-ReleaseSafe}" -lc \
    --dep json --dep peg --dep common_chat -Mroot=harness/peg_diff.zig \
    --dep json --dep peg --dep llama --dep zigjinja -Mcommon_chat=cli/common_chat/module.zig \
    --dep json --dep llama -Mpeg=cli/peg/module.zig \
    --dep llama -Mjson=cli/json/module.zig -Mzigjinja=../zigjinja/src/root.zig \
    --dep llama_c -Mllama=src/llama/harness_root.zig -Mllama_c="$tmp/llama_c.zig" \
    "$tmp/peg_ref.o" "${ROBJS[@]}" "$tmp/r-main.o" "$tmp/r-chat.o" "${LIBS[@]}" -lc++ \
    ${PLATFORM_LIBS[@]+"${PLATFORM_LIBS[@]}"} 2>"$tmp/berr" \
    || { echo "FAIL: could not build the harness" >&2; head -40 "$tmp/berr" >&2; exit 1; }

[ -n "${PEG_DIFF_KEEP:-}" ] && cp "$tmp/peg_diff$GATE_SUFFIX" "$PEG_DIFF_KEEP"

start=$SECONDS
gate_run "$tmp/peg_diff$GATE_SUFFIX" llamazig-peg-diff "$@"
rc=$?
echo "peg-diff: $((SECONDS - start)) s"
exit $rc
