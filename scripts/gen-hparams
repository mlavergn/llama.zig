#!/usr/bin/env python3
"""Generate the fields of `llama_hparams` as a Zig extern struct.

`llama_hparams` (llama-hparams.h) is 160-odd scalars and per-layer arrays,
trivially copyable by `static_assert`, with defaults spread over member
initializers. The port keeps it field for field, in the same layout, for
two reasons: the C++ reads many of these fields at sites that will be
ported one by one, and a layout-identical struct lets `make loader-diff`
compare the port's hyperparameters against the C++ object's **field by
field**, reading the reference model's `hparams` through the same type.
That only holds if the layout is right, so the loader diff checks every
field's offset and size against `offsetof`, and `sizeof` closes the hole
a dropped field would leave.

Writes:
  src/llama/hparams.zig          the block between the GENERATED markers
  harness/hparams_fields.inc     F(name) per field, for the C++ side

Run after moving the upstream pin.
"""
import re
import sys

HDR = "llama.cpp/src/llama-hparams.h"
LLAMA_H = "llama.cpp/include/llama.h"
COMMIT = "c1d0e7a00"
OUT = "src/llama/hparams.zig"
INC = "harness/hparams_fields.inc"
BEGIN = "    // BEGIN GENERATED by scripts/gen-hparams -- do not edit"
END = "    // END GENERATED"

hdr = open(HDR).read()
llama_h = open(LLAMA_H).read()

defines = dict(re.findall(r"^#define\s+(\w+)\s+(-?\d+)\b", hdr, re.M))
defines.update(re.findall(r"^\s*#\s*define\s+(\w+)\s+(-?\d+)\b", llama_h, re.M))


def enum_values(text):
    """Every `NAME = value` and implicit enumerator in `text`'s enums."""
    vals = {}
    for body in re.findall(r"enum\s+\w+\s*(?::\s*\w+)?\s*\{(.*?)\}", text, re.S):
        nxt = 0
        for name, init in re.findall(r"^\s*([A-Z][A-Z0-9_]*)\s*(?:=\s*(-?\d+))?\s*,?", re.sub(r"//[^\n]*", "", body), re.M):
            nxt = int(init) if init else nxt
            vals[name] = nxt
            nxt += 1
    return vals


enums = enum_values(hdr)
enums.update(enum_values(llama_h))

head = re.search(r"^struct llama_hparams \{", hdr, re.M)
struct_line = hdr.count("\n", 0, head.start()) + 1
end = hdr.index("\n};", head.end())
lines = hdr[head.end():end].split("\n")

SCALAR = {
    "bool": "bool", "uint32_t": "u32", "int32_t": "i32", "float": "f32", "int": "c_int",
    "llama_token": "i32",
    # Unscoped enums. `llm_ffn_op_type` is declared `: int`; the others have
    # no fixed type, and the layout check is what says 4 bytes is right.
    "llama_swa_type": "c_int", "enum llama_pooling_type": "c_int", "enum llama_rope_type": "c_int",
    "enum llama_rope_scaling_type": "c_int", "enum llm_ffn_op_type": "c_int",
    "struct llama_hparams_posnet": "Posnet", "struct llama_hparams_convnext": "Convnext",
}

fields = []
for i, raw in enumerate(lines):
    code = raw.split("//", 1)[0].strip()
    if not code:
        continue
    if "(" in code:
        break  # the member functions follow the data members
    m = re.fullmatch(r"(.+?)\s+([A-Za-z_]\w*)\s*(?:=\s*(.+?))?\s*;", code)
    if not m:
        sys.exit(f"gen-hparams: unparsed member at {HDR}:{struct_line + 1 + i}: {raw!r}")
    ctype, name, init = m.group(1), m.group(2), m.group(3)
    arr = re.fullmatch(r"std::array<\s*(\w+)\s*,\s*(\w+)\s*>", ctype)
    if arr:
        elem = SCALAR.get(arr.group(1))
        n = defines.get(arr.group(2), arr.group(2))
        if elem is None or not str(n).isdigit():
            sys.exit(f"gen-hparams: unmapped array {ctype!r}")
        ztype = f"[{n}]{elem}"
    else:
        ztype = SCALAR.get(ctype)
        if ztype is None:
            sys.exit(f"gen-hparams: unmapped type {ctype!r} for {name}")
    fields.append((name, ctype, ztype, init, struct_line + 1 + i))

# An independent count: every line of the struct body that ends a data
# member, before the first member function. Must agree with the parse.
independent = 0
for raw in lines:
    code = raw.split("//", 1)[0].strip()
    if "(" in code:
        break
    independent += code.endswith(";")
if independent != len(fields):
    sys.exit(f"gen-hparams: parsed {len(fields)} members, the struct body ends {independent}")


def zig_default(ztype, init):
    """The member initializer as a Zig default; zero where there is none,
    as `llama_hparams hparams = {}` value-initializes."""
    if ztype.startswith("["):
        n, elem = re.fullmatch(r"\[(\d+)\](\w+)", ztype).groups()
        if init is not None:
            sys.exit("gen-hparams: an array with an initializer")
        zero = {"bool": "false", "f32": "0"}.get(elem, "0")
        return f"@splat({zero})"
    if ztype in ("Posnet", "Convnext"):
        if init is not None:
            sys.exit("gen-hparams: a nested struct with an initializer")
        return ".{}"
    if init is None:
        return {"bool": "false"}.get(ztype, "0")
    v = init.strip()
    if ztype == "bool":
        if v not in ("true", "false"):
            sys.exit(f"gen-hparams: bool initializer {v!r}")
        return v
    if v == "-INFINITY":
        return "-std.math.inf(f32)"
    if v in enums:
        return str(enums[v])
    if v in defines:
        return defines[v]
    m = re.fullmatch(r"(-?\d+(?:\.\d+)?)f?", v)
    if not m:
        sys.exit(f"gen-hparams: initializer {v!r}")
    num = m.group(1)
    if ztype == "f32" and "." not in num:
        num += ".0"
    return num


block = [BEGIN]
for name, ctype, ztype, init, line in fields:
    safe = f'@"{name}"' if re.fullmatch(r"[iu]\d+", name) else name
    block.append(f"    {safe}: {ztype} = {zig_default(ztype, init)},")
block.append(END)

src = open(OUT).read()
if BEGIN not in src or END not in src:
    sys.exit(f"gen-hparams: {OUT} has no GENERATED markers")
pre, rest = src.split(BEGIN, 1)
_, post = rest.split(END, 1)
open(OUT, "w").write(pre + "\n".join(block) + post)

open(INC, "w").write(
    "// Generated by scripts/gen-hparams from llama-hparams.h @" + COMMIT + " -- do not edit.\n"
    "// One F(name) per llama_hparams data member, in declaration order.\n"
    + "".join(f"F({name})\n" for name, *_ in fields))

print(f"{len(fields)} llama_hparams members -> {OUT}, {INC}")
