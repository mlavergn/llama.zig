#!/bin/bash
# Compare src/llama/loader.zig and src/llama/model.zig with llama.cpp's
# llama-model-loader.cpp and llama-model.cpp, in one process.
#
# The loader, the hyperparameters and the model's metadata are ported ahead
# of libllama's single swap (PLAN.md, Decision 42), so nothing downstream can
# see them yet. This runs the metadata half of llama_model_load through the
# C++ in libllama.a (harness/loader_ref.cpp) and through the port, on every
# vocabulary file upstream ships, the local Qwen3.5 model, and synthesized
# files. See harness/loader_diff.zig for what is compared.
#
# Usage: scripts/loader-diff [extra.gguf...]
#   Requires: zig build reference --release=fast
#   Any Qwen3.5 model in the repository root is added automatically.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

for lib in zig-out/lib/libllama.a zig-out/lib/libggml.a; do
    [ -f "$lib" ] || { echo "missing $lib -- run 'zig build reference --release=fast'" >&2; exit 2; }
done

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

SDK="$(xcrun --sdk macosx --show-sdk-path)"

zig c++ -mcpu=baseline -c harness/loader_ref.cpp -o "$tmp/loader_ref.o" -std=c++17 -O2 -w \
    -I harness -I llama.cpp/src -I llama.cpp/include -I llama.cpp/ggml/include 2>"$tmp/cerr" \
    || { echo "FAIL: cannot compile harness/loader_ref.cpp" >&2; head -20 "$tmp/cerr" >&2; exit 1; }

# Zig 0.17 has no `@cImport`: `impl.zig` imports llama.h and gguf.h as the module
# `llama_c`, translated from `src/llama/c_import.h` as build/llamacpp.zig does.
zig translate-c -lc -I llama.cpp/include -I llama.cpp/ggml/include \
    src/llama/c_import.h >"$tmp/llama_c.zig" 2>"$tmp/terr" \
    || { echo "FAIL: cannot translate llama.h" >&2; head -10 "$tmp/terr" >&2; exit 1; }

zig build-exe -mcpu baseline -femit-bin="$tmp/loader_diff" -Ofast -lc \
    --dep staged -Mroot=harness/loader_diff.zig \
    --dep llama_c -Mstaged=src/llama/staged.zig -Mllama_c="$tmp/llama_c.zig" \
    "$tmp/loader_ref.o" zig-out/lib/libllama.a zig-out/lib/libggml.a -lc++ \
    -framework Foundation -framework Metal -framework MetalKit -framework Accelerate \
    -F "$SDK/System/Library/Frameworks" 2>"$tmp/berr" \
    || { echo "FAIL: could not build the harness" >&2; head -40 "$tmp/berr" >&2; exit 1; }

models=(llama.cpp/models/ggml-vocab-*.gguf)
for m in Qwen3.5-*.gguf; do
    [ -f "$m" ] && { models+=("$m"); break; }
done

"$tmp/loader_diff" "$tmp" "${models[@]}" "$@"
