#!/usr/bin/env python3
"""Compare tools/common's sampler and speculative decoding with upstream's.

`harness/spec_ref.cpp` drives upstream's `common/` -- sampling.cpp,
reasoning-budget.cpp, speculative.cpp, ngram-cache/-map/-mod.cpp, compiled
unmodified into libllama-common-ref over libllama-ref -- and
`harness/spec_diff.zig` the port, through the same script. Each case runs
both, one process each, and requires the same exit code, the same stdout
byte for byte (every draft, accepted run, the target sampler's candidates on
bits, the n-gram stores' iteration order and saved bytes, the reasoning
budget's states) and the same stderr -- common_log's every line -- after
masking what differs by design: timings, pointers, an abort's backtrace.

Two decoders over real models: Qwen3-0.6B as target and draft, and the arch
fixtures' draft architectures (EAGLE3 over a 128-wide Gemma 4, DFlash and
DSpark over Nemotron-H). Both sides decode through their own libllama over
the one libggml.a; context-diff holds those to the same bits.

Every phrase in PHRASES must appear in some reference transcript, so a case
list that drifted away from an arm fails instead of passing on nothing.

Usage: scripts/spec-diff [case-substring ...]
  SPEC_DIFF_OUT=<dir>   keep every case's transcripts there
  SPEC_DIFF_NOBUILD=1   use the binaries already in zig-out/spec-diff
"""

import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)

Q = "Qwen3-0.6B-Q8_0.gguf"
Q35 = "Qwen3.5-2B-Q4_K_M.gguf"
F = "zig-out/arch-fixtures"

T1 = "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick"
T2 = "def fib(n):\n    if n < 2:\n        return n\n    return fib(n - 1) + fib(n - 2)\n\ndef fib2(n):\n"
