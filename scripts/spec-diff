              "eagle3-dense", "eagle3-d2t"]

GGUFS = ":".join([f"{F}/dflash-dense.gguf", f"{F}/dflash-dspark.gguf", f"{F}/dflash2.gguf", f"{F}/eagle3-dense.gguf",
                  Q, f"{F}/qwen35-dense.gguf", f"{F}/step35-moe.gguf", "/nonexistent.gguf"])


def case(name, args, env=None, mode="run"):
    return (name, mode, args, env or {})


