                                 "--spec-draft-n-max", "4"] + FIX),
    case("dspark-noconf", ["-m", f"{F}/nemotron_h-dense.gguf", "-md", f"{FX}/dflash-dspark-noconf.gguf", "--spec-type",
                           "draft-dspark", "-p", IDS, "-n", "8", "--temp", "0", "--spec-draft-p-min", "0.5"] + FIXV),
]

# Cases where upstream itself aborts, and the port must abort alike.
EXPECT_ABORT = {"ngram-cache-missing"}

# Each must appear in some reference transcript (stdout or stderr).
PHRASES = [
    "from_names 'bogus' -> invalid_argument: unknown speculative type: bogus",
    "invalid_argument: synthetic acceptance rates must contain",
    "invalid_argument: synthetic acceptance length must be finite",
    "auto-detected speculative type 'draft-dspark'",
    "from_gguf " + Q + " -> ''",
    "load missing: Unable to open file",
    "budget exhausted, forcing end sequence",
    "budget exhausted, waiting for UTF-8 completion",
    "UTF-8 complete, now forcing end sequence",
    "re-activated on new start tag",
    "budget=0, forcing immediately",
    "forced into forcing state (manual transition)",
    "deactivated (natural end)",
    "forced sequence complete, done",
    "found matching pattern at pos",
    "refresh map:",
    "shrink cleanup begin",
    "unable to match sampler by name 'bogus'",
    "unable to match sampler by char '?'",
    "adding speculative implementation 'draft-simple'",
    "adding speculative implementation 'ngram-simple'",
    "adding speculative implementation 'ngram-map-k'",
    "adding speculative implementation 'ngram-map-k4v'",
    "adding speculative implementation 'ngram-mod'",
    "adding speculative implementation 'ngram-cache'",
    "adding speculative implementation 'draft-eagle3'",
    "adding speculative implementation 'draft-dflash'",
    "adding speculative implementation 'draft-dspark'",
    "adding speculative implementation 'draft-mtp'",
    "is too small - poor quality is possible",
    "ngram_mod occupancy =",
    "low acceptance streak",
    "draft candidate",
    "truncating draft to",
    "called impl ngram-mod",
    "called impl draft-simple",
    "called impl draft-eagle3",
    "called impl draft-dflash",
    "called impl draft-dspark",
    "called impl ngram-cache",
    "called impl ngram-map-k4v",
    "called impl ngram-simple",
    "statistics ",
    "#mean acc len",
    "synthetic speculative acceptance is enabled for benchmarking",
    "synthetic acceptance draft limit was reduced",
    "synthetic acceptance: n_max",
    "exception: draft-simple requires a draft context",
    "exception: draft model vocab type must match target model to use speculation",
    "the target and draft vocabs are not compatible",
    "exceeds the trained block size",
    "failed to open static lookup cache",
    "Couldn't read static lookup cache",
    "reasoning-budget accepted prefill token",
    "grammar accepted prefill token",
    "prefill token:",
    "backend sampling is not compatible with grammar",
    "loading draft model",
    "getting device memory data for the extra model",
    "rb force 1",
]

MASKS = [
    (re.compile(r"took [0-9.]+ (ms|seconds)"), "took T"),
    (re.compile(r"0x[0-9a-f]+"), "0xP"),
    (re.compile(r"dur\(b,g,a\) = [0-9., ]+ ms"), "dur(b,g,a) = T ms"),
    (re.compile(r"\d+\.\d+ ms(?: per token)?"), "T ms"),
    # A unified-memory GPU's free memory (the GB10's CUDA0) is read live as
    # each side runs, one after the other; on the Mac these never moved.
    (re.compile(r"final available_memory_kb: \d+"), "final available_memory_kb: N"),
    (re.compile(r" - \d+ MiB free$"), " - N MiB free"),
    (re.compile(r"vs\. \d+ MiB of free device memory"), "vs. N MiB of free device memory"),
    (re.compile(r"will leave -?\d+ ([<>]=?) \d+ MiB"), r"will leave N \1 M MiB"),
    (re.compile(r"= +\d+ \+ \("), "= N + ("), (re.compile(r"\) \+ +\d+ \|"), ") + N |"),
]
BACKTRACE = re.compile(r"^\d+\s+\S+\s+0x")
# On Linux ggml_print_backtrace attaches gdb, whose lines -- a thread list,
# frames and their source lines (`2093<TAB>...`, a different source on each
# side), a missing-source warning glued to whatever the process wrote last
# -- land in both streams and differ every run. GGML_NO_BACKTRACE would
# silence them, but the attach is also what gives upstream's log worker time
# to write the lines queued before the abort: without it the GB10 lost
# ngram-cache-missing's last three. So they are dropped here instead.
GDB_LINE = re.compile(r"^\[New LWP \d+\]$|^\[New Thread |^\[Thread debugging |^Using host libthread_db|"
                      r"^\[Inferior \d+ |^#\d+ |^0x[0-9a-f]+ in |^\d+\t|^warning: \d+\t")
GDB_TAIL = re.compile(r"warning: \d+\t\S+: No such file or directory$")
# a backtrace glued to a log line that had no newline when the process died
TRACE_TAIL = re.compile(r"\d+\s+spec_(?:ref|diff)\s+0x.*$")
# GGML_ABORT's text: upstream passes __FILE__, the port a file name; and the
# abort races the C++'s asynchronous log worker, so it is compared as a set
ABORT = re.compile(r"(?:[\w./-]*/)?((?:speculative|sampling|ngram-cache|ngram-map|ngram-mod|reasoning-budget|common|"
                   r"llama-[a-z-]+|ggml[a-z-]*)\.(?:cpp|c)):(\d+): (.*)$")


# v0.5.0: llama_graph_n_input_tensors (llama-context.cpp) logs each input
# tensor's users from an unordered_map keyed by tensor address, so the order
# of a run of those lines is the allocator's, run to run, on either side;
# each run is compared sorted.
GRAPH_INPUT = "llama_graph_n_input_tensors: input tensor "


def sort_graph_inputs(lines):
    out, run = [], []
    for line in lines + [None]:
        if line is not None and GRAPH_INPUT in line:
            run.append(line)
            continue
        out.extend(sorted(run))
        run = []
        if line is not None:
            out.append(line)
    return out


def mask(text):
    out, aborts = [], []
    for line in text.splitlines():
        line = GDB_TAIL.sub("", TRACE_TAIL.sub("", line))
        if BACKTRACE.match(line) or GDB_LINE.match(line):
            continue
        m = ABORT.search(line)
        if m:
            aborts.append(f"ABORT {m.group(1)}:{m.group(2)}: {m.group(3)}")
            line = line[:m.start()]
            if not line:
                continue
        for rx, rep in MASKS:
            line = rx.sub(rep, line)
        if line.strip():
            out.append(line)
    return sort_graph_inputs(out) + sorted(aborts)


def run(cmd, what):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        print(f"FAIL: {what}\n{r.stderr[-3000:]}", file=sys.stderr)
        sys.exit(2)


def main():
    picks = sys.argv[1:]
    if not os.environ.get("SPEC_DIFF_NOBUILD"):
        run(["zig", "build", "spec-diff", "--release=fast"], "could not build the harnesses (zig build spec-diff)")
    for p in ["zig-out/spec-diff/spec_ref", "zig-out/spec-diff/spec_diff", "zig-out/spec-diff/spec_fixtures", Q]:
        if not os.path.exists(p):
            print(f"FAIL: missing {p}", file=sys.stderr)
            sys.exit(2)
    if not os.path.exists(f"{F}/eagle3-dense.gguf"):
        print(f"FAIL: missing {F}; run 'make arch-fixtures'", file=sys.stderr)
        sys.exit(2)

    out = os.environ.get("SPEC_DIFF_OUT") or tempfile.mkdtemp(prefix="spec-diff.")
    os.makedirs(out, exist_ok=True)
    # one scratch directory, the same path for both sides: the api case
    # writes the n-gram caches the ngram-cache-files case loads
    tmp = os.path.join(out, "tmp")
    os.makedirs(tmp, exist_ok=True)

    fxdir = os.path.join(out, "fx")
    os.makedirs(fxdir, exist_ok=True)
    for name in FX_SOURCES:
        run(["zig-out/spec-diff/spec_fixtures", f"{F}/{name}.gguf", f"{fxdir}/{name}.gguf"], f"could not rewrite {name}")
    run(["zig-out/spec-diff/spec_fixtures", "--gemma4", fxdir], "could not write the Gemma 4 pair")

    t0 = time.time()
    failed = []
    lines = 0
    ref_text = []
    for name, mode, args, env in CASES:
        if picks and not any(p in name for p in picks):
            continue
        res = {}
        for side, exe in (("ref", "spec_ref"), ("port", "spec_diff")):
            e = dict(os.environ)
            e["SPEC_TMP"] = tmp
            for k, v in env.items():
                e[k] = v.replace("@TMP", tmp)
            args = [a.replace("@FX", fxdir) for a in args]
            if mode == "api":
                # the same files on both sides
                for f in os.listdir(tmp):
                    os.unlink(os.path.join(tmp, f))
            cmd = ["perl", "-e", "alarm shift; exec @ARGV", "300", f"zig-out/spec-diff/{exe}", mode] + args
            r = subprocess.run(cmd, capture_output=True, env=e)
            o = r.stdout.decode("utf-8", "replace")
            er = r.stderr.decode("utf-8", "replace")
            with open(os.path.join(out, f"{name}.{side}.out"), "w") as fh:
                fh.write(o)
            with open(os.path.join(out, f"{name}.{side}.err"), "w") as fh:
                fh.write(er)
            res[side] = (r.returncode, [l for l in o.splitlines() if not GDB_LINE.match(l)], mask(er))
        (rc_r, o_r, e_r), (rc_p, o_p, e_p) = res["ref"], res["port"]
        ref_text.append("\n".join(o_r) + "\n" + "\n".join(e_r))
        lines += len(o_r) + len(e_r)
        bad = []
        if rc_r != rc_p:
            bad.append(f"exit {rc_r} vs {rc_p}")
        if o_r != o_p:
            bad.append("stdout differs")
        if e_r != e_p:
            bad.append("stderr differs")
        if rc_r == 142 or (rc_r < 0 and name not in EXPECT_ABORT):
            bad.append(f"reference timed out or died ({rc_r})")
        status = "ok  " if not bad else "FAIL"
        print(f"{status} {name}: rc {rc_r}, {len(o_r)} + {len(e_r)} lines" + (f" -- {', '.join(bad)}" if bad else ""))
        if bad:
            failed.append(name)
            import difflib
            for a, b, label in ((o_r, o_p, "stdout"), (e_r, e_p, "stderr")):
                if a != b:
                    for i, d in enumerate(difflib.unified_diff(a, b, f"ref {label}", f"port {label}", lineterm="", n=1)):
                        print("    " + d[:240])
                        if i > 24:
                            break

    if not picks:
        everything = "\n".join(ref_text)
        missing = [p for p in PHRASES if p not in everything]
        for p in missing:
            print(f"FAIL: no reference transcript reaches: {p}")
        if missing:
            failed.append("phrases")
    dt = time.time() - t0
    if failed:
        print(f"FAIL: spec-diff: {len(failed)} failing ({', '.join(failed)}); transcripts in {out}")
        sys.exit(1)
    print(f"ok: spec-diff: {sum(1 for c in CASES if not picks or any(p in c[0] for p in picks))} cases, "
          f"{lines} lines identical, {len(PHRASES)} phrases reached, {dt:.0f} s")
    if not os.environ.get("SPEC_DIFF_OUT"):
        shutil.rmtree(out, ignore_errors=True)


if __name__ == "__main__":
    main()
