#!/bin/bash
# `ops-diff` for x86_64, on the Windows laptop (PLAN.md, Stage 5 step 6;
# Decision 57).
#
# Cross-builds the reference (`llama.cpp.zmake`) and the port for
# `x86_64-windows-gnu` at X86_CPU, links `harness/ops_dump.c` against each
# through `harness/win_ops_dump.c`, and runs scripts/ops-diff's comparison
# on the laptop's Haswell: the reference writes the quantized blocks, the
# port replays them, one thread then three, each in its own process. The
# outputs never leave the laptop; `harness/win_lines_diff.c` compares them
# there and its verdict is what comes back.
#
# It is the oracle `tinyBLAS_Q0_AVX` has: every quantized `mul_mat` against
# `q8_0` goes through `llamafile_sgemm` first.
#
# Usage: scripts/x86-ops-diff
#   X86_CPU=x86_64_v3            the level; x86_64_v4 and tigerlake need
#                                an AVX-512 agent, X86_AGENT=JWHLPTOP
#   X86_AGENT, ZUPDATER   as scripts/win-run takes them
#   X86_BUILD_ONLY=1             stop after building the three .exe files
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

X86_CPU="${X86_CPU:-x86_64_v3}"
TARGET=x86_64-windows-gnu

. "$ROOT/scripts/check-reference-pin"

out="$ROOT/zig-out/x86-ops/$X86_CPU"
mkdir -p "$out"

(cd llama.cpp.zmake && zig build lib --release=fast -Dtarget="$TARGET" -Dcpu="$X86_CPU" -p "$out/ref") \
    || { echo "FAIL: could not build the x86 reference" >&2; exit 1; }
zig build reference --release=fast -Dtarget="$TARGET" -Dcpu="$X86_CPU" -p "$out/port" \
    || { echo "FAIL: could not build the x86 port" >&2; exit 1; }

CC=(zig cc -target "$TARGET" -mcpu="$X86_CPU" -std=c11 -w -O2 -I harness -I llama.cpp/ggml/include -I llama.cpp/ggml/src)
"${CC[@]}" harness/win_ops_dump.c "$out/ref/lib/ggml.lib" -o "$out/ops_ref.exe" -lc++ \
    || { echo "FAIL: could not link against the x86 reference" >&2; exit 1; }
"${CC[@]}" harness/win_ops_dump.c "$out/port/lib/ggml.lib" -o "$out/ops_port.exe" -lc++ \
    || { echo "FAIL: could not link against the x86 port" >&2; exit 1; }
"${CC[@]}" harness/win_lines_diff.c -o "$out/lines_diff.exe" \
    || { echo "FAIL: could not build harness/win_lines_diff.c" >&2; exit 1; }
[ -n "${X86_BUILD_ONLY:-}" ] && { echo "built $out/ops_ref.exe, ops_port.exe, lines_diff.exe"; exit 0; }

RUN="$ROOT/scripts/win-run"
for nt in 1 3; do
    "$RUN" "$out/ops_ref.exe" llamazig-ops-ref "$nt" "ops_ref.$nt.txt" write-q "q.$nt.bin" > "$out/ref.$nt.log" || exit 2
    grep -aq 'ops_dump rc=0' "$out/ref.$nt.log" || { echo "FAIL: reference run failed at $nt thread(s)"; tail -5 "$out/ref.$nt.log"; exit 1; }
    "$RUN" "$out/ops_port.exe" llamazig-ops-port "$nt" "ops_port.$nt.txt" read-q "q.$nt.bin" > "$out/port.$nt.log" || exit 2
    grep -aq 'ops_dump rc=0' "$out/port.$nt.log" || { echo "FAIL: ported run failed at $nt thread(s)"; tail -5 "$out/port.$nt.log"; exit 1; }
done
"$RUN" "$out/lines_diff.exe" llamazig-lines-diff ops_ref.1.txt ops_port.1.txt ops_ref.3.txt ops_port.3.txt | tee "$out/result.txt"
grep -aq '^PASS: ' "$out/result.txt" && exit 0
grep -aq '^FAIL: ' "$out/result.txt" && exit 1
echo "FAIL: no verdict -- see $out/lines_diff.exe.log" >&2
exit 2
