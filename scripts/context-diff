#!/bin/bash
# Compare src/llama/context.zig, and everything a decode reaches, with
# llama.cpp's llama-context.cpp and its callees, in one process.
#
# libllama swaps once, at llama.h (PLAN.md, Decision 42), so until then
# nothing downstream can see the ported context, batch splitter, memory
# modules or graph. This loads one Qwen3.5 model through the C++ in
# libllama-ref.a and through the port, runs the same decode script through
# llama.h and through the port's api functions of the same names, and
# compares the two transcripts: everything logged, every graph node computed
# (op, shape, strides, op_params, sources and a hash of its data), every
# return value and every output row's bits. See harness/context_diff.zig.
#
# Usage: scripts/context-diff [model.gguf] [--quick] [--case substring]
#   [--model moe-cache|host-experts|...] [--hadamard|--hadamard-tied]
#   [--section-order zyxt] [--target model.gguf]   (see harness/context_diff.zig)
#   Requires: zig build reference --release=fast
#   The model defaults to the first Qwen3.5 model in the repository root.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

for lib in zig-out/lib/libllama-ref.a zig-out/lib/libggml.a; do
    [ -f "$lib" ] || { echo "missing $lib -- run 'zig build reference --release=fast'" >&2; exit 2; }
done

model=""
explicit_model=0
if [ $# -gt 0 ] && [ "${1%.gguf}" != "$1" ]; then
    model="$1"
    explicit_model=1
    shift
fi
if [ -z "$model" ]; then
    for m in Qwen3.5-*.gguf; do
        [ -f "$m" ] && { model="$m"; break; }
    done
fi
[ -n "$model" ] || { echo "no Qwen3.5 model -- run 'make qwen35'" >&2; exit 2; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# The system libraries the harness links beside libggml.a: the Metal
# frameworks on macOS, the CUDA libraries on Linux (scripts/platform-libs).
# Until v0.5.0 this named the Metal frameworks itself and ran on macOS only.
. scripts/platform-libs
platform_libs exe

zig translate-c -lc -I llama.cpp/include -I llama.cpp/ggml/include \
    src/llama/c_import.h >"$tmp/llama_c.zig" 2>"$tmp/terr" \
    || { echo "FAIL: cannot translate llama.h" >&2; head -10 "$tmp/terr" >&2; exit 1; }

zig cc -mcpu=baseline -c harness/proxy_dev.c -o "$tmp/proxy_dev.o" -O2 \
    -I llama.cpp/ggml/include -I llama.cpp/ggml/src 2>"$tmp/perr" \
    || { echo "FAIL: cannot compile harness/proxy_dev.c" >&2; head -20 "$tmp/perr" >&2; exit 1; }

zig c++ -mcpu=baseline -c harness/context_ref.cpp -o "$tmp/context_ref.o" -std=c++17 -O2 -w \
    -I llama.cpp/src -I llama.cpp/include -I llama.cpp/ggml/include 2>"$tmp/cerr" \
    || { echo "FAIL: cannot compile harness/context_ref.cpp" >&2; head -20 "$tmp/cerr" >&2; exit 1; }

zig build-exe -mcpu baseline -femit-bin="$tmp/context_diff" -Ofast -lc \
    --dep harness_root -Mroot=harness/context_diff.zig \
    --dep llama_c -Mharness_root=src/llama/harness_root.zig -Mllama_c="$tmp/llama_c.zig" \
    "$tmp/proxy_dev.o" "$tmp/context_ref.o" zig-out/lib/libllama-ref.a zig-out/lib/libggml.a -lc++ \
    "${PLATFORM_LIBS[@]}" 2>"$tmp/berr" \
    || { echo "FAIL: could not build the harness" >&2; head -40 "$tmp/berr" >&2; exit 1; }

# Without a model named, the default run also covers v0.7.0's features on
# fixtures from scripts/gen-arch-fixtures, each required: the MoE cache and
# host-resident experts on deepseek2's 64 experts, prism.hadamard (latent and
# tied) on a hybrid MoE and a dense model, the GDN grouped-head permutation
# under it (the gdnrep2 variant), the M-RoPE section order on the
# Qwen3.5 model, and a DFlash draft that reads its head from a target.
extra=0
if [ $explicit_model = 0 ] && [ $# = 0 ]; then
    FIXTURES="${ARCH_FIXTURES:-zig-out/arch-fixtures}"
    for f in deepseek2-moe qwen3moe-moe qwen35moe-moe qwen35moe-gdnrep2-moe llama-dense dflash-gemma qwen3-dense; do
        [ -f "$FIXTURES/$f.gguf" ] || { echo "FAIL: no $FIXTURES/$f.gguf -- run 'make arch-fixtures'" >&2; exit 2; }
    done
    extra=1
fi

status=0
# The MoE cache's eviction policy, which no node hash can see.
if [ $explicit_model = 0 ] && [ $# = 0 ]; then
    ./scripts/moe-slru-diff || status=1
fi
CONTEXT_DIFF_TMP="$tmp" "$tmp/context_diff" "$model" "$@" || status=1
if [ $extra = 1 ]; then
    run() { echo "== context_diff $*"; CONTEXT_DIFF_TMP="$tmp" MOE_CACHE_SIZE="${MOE_CACHE_SIZE:-2000000}" "$tmp/context_diff" "$@" || status=1; }
    run "$FIXTURES/deepseek2-moe.gguf" --model moe-cache
    run "$FIXTURES/deepseek2-moe.gguf" --model host-experts
    MOE_CACHE_SIZE=4000000 run "$FIXTURES/qwen3moe-moe.gguf" --hadamard --model moe-cache --case-exact default
    run "$FIXTURES/qwen35moe-moe.gguf" --hadamard --model gpu
    run "$FIXTURES/qwen35moe-moe.gguf" --hadamard --model cpu --case-exact default
    # The GDN grouped-head permutation is built only with two or more value
    # heads per key head (gdn_v_grouped, perm_rep > 1): the recipe's fixtures
    # have one, so only the gdnrep2 variant reaches it.
    run "$FIXTURES/qwen35moe-gdnrep2-moe.gguf" --hadamard --model gpu
    run "$FIXTURES/llama-dense.gguf" --hadamard-tied --model gpu
    run "$model" --section-order zyxt --model gpu --case-exact default
    run "$FIXTURES/dflash-gemma.gguf" --target "$FIXTURES/qwen3-dense.gguf" --model gpu --case-exact default
    # v0.8.0: `no_alloc` is a parameter of every memory, not a hparam, so each
    # kind of memory builds with dummy buffers and reports the same breakdown.
    for f in qwen3-dense gemma3-dense mamba-dense qwen35moe-moe jamba-dense glm-dsa-moe deepseek32-moe deepseek4-moe minimax-m3-moe glm5-next-moe; do
        run "$FIXTURES/$f.gguf" --model no-alloc --case-exact default
    done
    run "$FIXTURES/deepseek2-moe.gguf" --model no-alloc-moe-cache --case-exact default
    # DeepSeek-V4.1's cross-layer KV across devices (the mirrors), and tokens
    # shared by sequences whose Engram n-gram histories differ.
    run "$FIXTURES/deepseek41-moe.gguf" --model partial-2 --case-exact default
    run "$FIXTURES/deepseek41-moe.gguf" --model gpu --case-exact "shared history"
fi
exit $status
