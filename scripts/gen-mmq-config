#!/usr/bin/env python3
"""Generate the CUDA MMQ kernel configuration tables.

`mmq.cuh` picks a matrix-multiplication kernel's thread count, occupancy,
tile sizes, shared-memory layout and stream-k use from one table per GPU
family, each a function of `CASE(type, nthreads, occupancy, I, J,
sram_layout, K_vram, stream_k, fallback)` lines tried in order, falling
back to a final default. The host code and the kernels read the same table,
so a transcription error would make the host launch a kernel with a
configuration it was not compiled for -- a wrong grid or shared-memory size,
silently. So the tables are generated from the headers, not typed.

Only the NVIDIA families are emitted: pascal_older, pascal_dp4a, ampere
and blackwell (`ggml_cuda_mmq_get_config` reaches the AMD ones only for AMD
devices). A family's file is its name with `_` spelled `-`:
`ggml_cuda_mmq_get_config_pascal_dp4a` is in `mmq-config-pascal-dp4a.cuh`.

Writes:
  src/ggml/cuda/mmq_config_table.zig

Run after moving the upstream pin.
"""
import re

DIR = "llama.cpp/ggml/src/ggml-cuda"
from upstream_pin import COMMIT, TAG
FAMILIES = ["pascal_older", "pascal_dp4a", "ampere", "blackwell"]
OUT = "src/ggml/cuda/mmq_config_table.zig"

K_VRAM = {"MMQ_ITER_K": 256, "MMQ_ITER_K_FP4": 512}

CASE = re.compile(r"\s*CASE\((GGML_TYPE_\w+),\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+),\s*(GGML_CUDA_MMQ_SRAM_LAYOUT_\w+),\s*(\w+),\s*(true|false),\s*(true|false)\);")
DEFAULT = re.compile(r"\s*return ggml_cuda_mmq_config\((GGML_TYPE_\w+),\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+),\s*(GGML_CUDA_MMQ_SRAM_LAYOUT_\w+),\s*(\w+),\s*(true|false),\s*(true|false)\);")
FALLTHROUGH = re.compile(r"\s*return ggml_cuda_mmq_get_config_(\w+)\(type, J, fallback\);")


def kv(s):
    return K_VRAM[s] if s in K_VRAM else int(s)


def entry(m):
    t, nthreads, occ, I, J, layout, k, sk, fb = m.groups()
    layout = layout[len("GGML_CUDA_MMQ_SRAM_LAYOUT_"):].lower()
    return f".{{ .type = c.{t}, .nthreads = {nthreads}, .occupancy = {occ}, .I = {I}, .J = {J}, .sram_layout = .{layout}, .K_vram = {kv(k)}, .stream_k = {sk}, .fallback = {fb} }}"


def stem(family):
    return "mmq-config-" + family.replace("_", "-")


def parse(family):
    path = f"{DIR}/{stem(family)}.cuh"
    lines = open(path).read().split("\n")
    first = next(i for i, l in enumerate(lines) if "ggml_cuda_mmq_get_config_" + family + "(" in l) + 1
    cases, default, fallthrough = [], None, None
    for l in lines:
        if m := CASE.match(l):
            cases.append(entry(m))
        elif m := DEFAULT.match(l):
            default = entry(m)
        elif m := FALLTHROUGH.match(l):
            fallthrough = m.group(1)
    assert default or fallthrough, family
    return first, cases, default, fallthrough


out = [
    "//! The NVIDIA MMQ kernel configuration tables.",
    "//!",
    "//! # Provenance",
    "//!",
    "//! **Generated by `scripts/gen-mmq-config`; do not edit.** Ported from",
]
parsed = {f: parse(f) for f in FAMILIES}
for f in FAMILIES:
    out.append(f"//! `llama.cpp/ggml/src/ggml-cuda/{stem(f)}.cuh`,")
out += [
    f"//! at {TAG} (`{COMMIT}`). Each table is a function's `CASE` lines in",
    "//! order; the first entry matching (type, J, fallback) wins, else the",
    "//! function's last line: a default entry, or another family's table.",
    "",
    'const impl = @import("../impl.zig");',
    'const Config = @import("mmq.zig").Config;',
    "",
    "const c = impl.c;",
    "",
    "pub const Table = struct {",
    "    cases: []const Config,",
    "    /// The config returned when no case matches; null when the family",
    "    /// falls through to `fallthrough`.",
    "    default: ?Config,",
    "    fallthrough: ?*const Table,",
    "};",
    "",
]
for f in FAMILIES:
    first, cases, default, fallthrough = parsed[f]
    out.append(f"/// Ports `ggml_cuda_mmq_get_config_{f}` ({stem(f)}.cuh:{first} @{COMMIT}).")
    out.append(f"pub const {f}: Table = .{{")
    out.append("    .cases = &.{")
    for e in cases:
        out.append(f"        {e},")
    out.append("    },")
    out.append(f"    .default = {default if default else 'null'},")
    out.append(f"    .fallthrough = {('&' + fallthrough) if fallthrough else 'null'},")
    out.append("};")
    out.append("")

open(OUT, "w").write("\n".join(out))
print(f"wrote {OUT}: " + ", ".join(f"{f} {len(parsed[f][1])}" for f in FAMILIES))
