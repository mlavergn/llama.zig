#!/bin/bash
# Report how much of a C translation unit has been ported, by symbol.
#
# The port swaps whole translation units: a file cannot be linked beside the C
# it replaces until every symbol is present, because the linker pulls the C
# object in for the ones still missing and then finds duplicates for the rest.
# So "how many symbols" is the real progress measure, and "which names" is the
# real completeness check -- a typo in an exported name is otherwise invisible
# until the swap fails to link.
#
# The contract comes from compiling the C file itself, so this needs only the
# llama.cpp checkout: no CMake build, no reference libraries.
#
# Usage: scripts/port-coverage [--list] [--target <zig triple>]
#
# `--target` measures another platform's contract by cross-compiling both
# sides, so the Mac can measure Linux's: an ELF target drops the Metal and
# Accelerate defines the build drops there, keeps every symbol's name as
# written -- ELF has no C prefix to strip -- and skips the Metal units,
# which a Linux build does not compile. Native is the default.
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

PORTED_DIR=src/ggml

[ -d llama.cpp/ggml/src ] || { echo "missing llama.cpp -- run 'make clone'" >&2; exit 2; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Zig 0.17 has no `@cImport`: `src/ggml/impl.zig` imports ggml's headers as
# the module `ggml_c`, translated from `src/ggml/c_import.h` as
# build/llamacpp.zig does.
zig translate-c -lc -I llama.cpp/ggml/include -I llama.cpp/ggml/src -I llama.cpp/ggml/src/ggml-cpu \
    src/ggml/c_import.h >"$tmp/ggml_c.zig" 2>"$tmp/terr" \
    || { echo "FAIL: cannot translate the ggml headers" >&2; head -10 "$tmp/terr" >&2; exit 1; }
# `src/llama/impl.zig` likewise imports llama.h as `llama_c`.
zig translate-c -lc -I llama.cpp/include -I llama.cpp/ggml/include \
    src/llama/c_import.h >"$tmp/llama_c.zig" 2>"$tmp/terr" \
    || { echo "FAIL: cannot translate llama.h" >&2; head -10 "$tmp/terr" >&2; exit 1; }

LIST=0
TARGET_ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --list) LIST=1 ;;
        --target) TARGET_ARGS=(-target "$2"); shift ;;
        *) echo "usage: scripts/port-coverage [--list] [--target <triple>]" >&2; exit 2 ;;
    esac
    shift
done

# Mach-O prefixes every C symbol with one underscore and builds Metal;
# ELF does neither. Read off the target, or the host when there is none.
if [ ${#TARGET_ARGS[@]} -gt 0 ]; then
    case "${TARGET_ARGS[1]}" in *macos*|*ios*) MACHO=1 ;; *) MACHO=0 ;; esac
else
    [ "$(uname -s)" = Darwin ] && MACHO=1 || MACHO=0
fi

# Since v0.4.0 the version strings come from `ggml-version.h` and
# `llama-version.h`, which CMake configures from their `.in` templates; both
# are configured here from build/upstream.zig, as the build does.
VERSION_DIR="$(mktemp -d)"
_pin() { sed -n "s/^pub const $1 = \"\{0,1\}\([^\";]*\)\"\{0,1\};$/\1/p" build/upstream.zig; }
sed -e "s/@GGML_VERSION@/$(_pin ggml_version)/" -e "s/@GGML_BUILD_COMMIT@/$(_pin commit)/" \
    llama.cpp/ggml/src/ggml-version.h.in > "$VERSION_DIR/ggml-version.h"
sed -e "s/@LLAMA_VERSION@/$(_pin version)/" -e "s/@LLAMA_BUILD_COMMIT@/$(_pin commit)/" \
    llama.cpp/src/llama-version.h.in > "$VERSION_DIR/llama-version.h"

INCLUDES=(-I llama.cpp/ggml/include -I llama.cpp/ggml/src -I llama.cpp/ggml/src/ggml-cpu -I "$VERSION_DIR")
DEFINES=(-DGGML_USE_CPU -DGGML_SCHED_MAX_COPIES=4 -DGGML_USE_LLAMAFILE)
if [ "$MACHO" = 1 ]; then
    DEFINES+=(-DGGML_USE_METAL -DGGML_USE_ACCELERATE)
    USE_METAL=true
else
    # The reference's Linux define, llama.cpp.zmake's `linux_defines` from
    # upstream's ggml/src/CMakeLists.txt:154. Without it glibc hides `M_PI`
    # from `-std=c11` and ggml.c does not compile.
    DEFINES+=(-D_GNU_SOURCE)
    USE_METAL=false
fi

# `src/ggml/varargs.c` defines ggml's three C variadics where Zig cannot: on
# aarch64 outside Apple and Windows. It is the build's `needsVarargsShim`
# rule, and the object joins the Zig ones on the side being measured.
if [ ${#TARGET_ARGS[@]} -gt 0 ]; then
    triple="${TARGET_ARGS[1]}"
else
    triple="$(uname -m)-$(uname -s | tr '[:upper:]' '[:lower:]')"
fi
case "$triple" in
    aarch64*macos*|aarch64*ios*|aarch64*windows*|arm64*darwin*) VARARGS_SHIM=0 ;;
    aarch64*|arm64*) VARARGS_SHIM=1 ;;
    *) VARARGS_SHIM=0 ;;
esac
if [ "$VARARGS_SHIM" = 1 ]; then
    zig cc ${TARGET_ARGS[@]+"${TARGET_ARGS[@]}"} -mcpu=baseline -c src/ggml/varargs.c -o "$tmp/varargs.o" -std=c11 -w \
        -I llama.cpp/ggml/include 2>"$tmp/varargs.log" \
        || { echo "failed to compile src/ggml/varargs.c:" >&2; tail -5 "$tmp/varargs.log" >&2; exit 1; }
fi

# The C symbol prefix: one leading underscore on Mach-O, none on ELF. A
# second underscore, before `Z`, marks an Itanium-mangled C++ name.
strip_prefix() {
    if [ "$MACHO" = 1 ]; then sed 's/^_//'; else cat; fi
}

todo_total=0

# Reports one translation unit: compile the reference source for its symbol
# contract, compile the Zig that replaces it, and compare the exported names.
#
# `LANG_` selects the compiler and the contract filter, and defaults to C:
#
#   c    -- `zig cc`, and every exported symbol is part of the contract.
#   cxx  -- `zig c++`, and the contract is the *unmangled* exports only.
#
# The C++ filter is not a shortcut. A C++ translation unit exports thousands of
# mangled symbols -- `gguf.cpp` alone exports 2,002 -- but they are template
# instantiations and inline functions, emitted weakly into every object that
# needs them. Measured against the undefined symbols of every other object in
# `libggml.a` and `libllama.a`: across all 24 C++ units in ggml, the only
# mangled symbols reached from outside their own file belong to four of them
# (`ggml-backend-dl`, `traits`, `ggml-cpu`, `ggml-metal-tuning`). Those four
# carry a note in PLAN.md and must be ported together with the units that need
# their vtables; for every other file the real contract is its C ABI.
#
# Args: <label> <source> <swapped: yes|no> <zig file>...
report_unit() {
    local label="$1" src="$2" swapped="$3"; shift 3
    local files=("$@")
    local d="$tmp/$label"
    local lang="${LANG_:-c}"
    mkdir -p "$d"

    if [ "$lang" = "cxx" ]; then
        if ! zig c++ ${TARGET_ARGS[@]+"${TARGET_ARGS[@]}"} -mcpu=baseline -c "$src" -o "$d/ref.o" -std=c++17 -w "${INCLUDES[@]}" "${DEFINES[@]}" 2>"$d/cc.log"; then
            echo "failed to compile $src:" >&2
            tail -5 "$d/cc.log" >&2
            exit 1
        fi
    elif ! zig cc ${TARGET_ARGS[@]+"${TARGET_ARGS[@]}"} -mcpu=baseline -c "$src" -o "$d/ref.o" -std=c11 -w "${INCLUDES[@]}" "${DEFINES[@]}" 2>"$d/cc.log"; then
        echo "failed to compile $src:" >&2
        tail -5 "$d/cc.log" >&2
        exit 1
    fi
    # Strip exactly the C prefix, then filter; see `strip_prefix`.
    nm -g --defined-only "$d/ref.o" | awk '{print $3}' | strip_prefix | grep . | sort -u > "$d/want-all.txt"
    if [ "$lang" = "cxx" ]; then
        # `__clang_call_terminate` is a compiler-emitted landing-pad helper for
        # the C++ exception path, coalesced across every object that needs one.
        # It belongs to the runtime, not to the translation unit, and no Zig
        # port produces it. `DW.ref.__gxx_personality_v0` is ELF's
        # counterpart: the weak reference to the personality routine that
        # every object with an exception table carries.
        grep -v '^_Z' "$d/want-all.txt" | grep -v '^__clang_call_terminate$' \
            | grep -v '^DW\.ref\.__gxx_personality_v0$' > "$d/want.txt" || :
        # `MANGLED_` names the exceptional file whose contract *is* mangled.
        # `ggml-metal-tuning.cpp` has **zero** unmangled exports, so the
        # filter above leaves an empty contract and this script would read
        # `0 / 0 symbols (100%)` for a file nobody had touched -- the same
        # trap `repack.cpp` sprang, in its purest form. Listing the mangled
        # names makes the count real.
        if [ -n "${MANGLED_:-}" ]; then
            printf '%s\n' $MANGLED_ | sort -u > "$d/want.txt"
        fi
        # `EXTRA_MANGLED_` adds C++-linkage names another translation unit
        # calls to a contract that is otherwise C -- `llama-sampler.cpp`'s
        # two `llama_sampler_backend_*`, which `llama-context.cpp` reaches
        # under their mangled names.
        if [ -n "${EXTRA_MANGLED_:-}" ]; then
            { cat "$d/want.txt"; printf '%s\n' $EXTRA_MANGLED_; } | sort -u > "$d/want2.txt"
            mv "$d/want2.txt" "$d/want.txt"
        fi
    else
        cp "$d/want-all.txt" "$d/want.txt"
    fi

    : > "$d/objs.txt"
    local f
    for f in "${files[@]}"; do
        [ -f "$f" ] || continue
        local base
        base="$(basename "$f" .zig)"
        # alloc.zig and cpu/forward.zig read their probe flags from the
        # `config` module the build graph supplies; a bare build-obj has to
        # stand one in. Every flag build.zig defines has to appear here, or the
        # compile fails and this script reports nothing at all.
        # The Vulkan shader-extension flags are read from build/llamacpp.zig's
        # own table, so adding one there cannot break this silently again.
        {
            printf 'pub const probe_ported = false;\npub const probe_cpu = false;\npub const use_metal = %s;\npub const use_cuda = false;\npub const cuda_port = false;\npub const cuda_arch = "";\n' "$USE_METAL"
            printf 'pub const use_vulkan = false;\npub const vulkan_port = false;\npub const use_blas = false;\npub const blas_port = false;\n'
            grep -oE '\.option = "vk_[a-z0-9_]+"' build/llamacpp.zig | sed -E 's/.*"(vk_[a-z0-9_]+)"/pub const \1 = false;/'
        } > "$d/config.zig"
        if ! zig build-obj ${TARGET_ARGS[@]+"${TARGET_ARGS[@]}"} -mcpu baseline -femit-bin="$d/$base.o" "${INCLUDES[@]}" -lc \
                --dep config --dep ggml_c --dep llama_c -Mroot="$f" -Mconfig="$d/config.zig" \
                -Mggml_c="$tmp/ggml_c.zig" -Mllama_c="$tmp/llama_c.zig" 2>"$d/$base.log"; then
            echo "failed to compile $f:" >&2
            grep error "$d/$base.log" | head -5 >&2
            exit 1
        fi
        echo "$d/$base.o" >> "$d/objs.txt"
    done

    [ "$VARARGS_SHIM" = 1 ] && echo "$tmp/varargs.o" >> "$d/objs.txt"

    # shellcheck disable=SC2046
    nm -g --defined-only $(cat "$d/objs.txt") 2>/dev/null \
        | awk '{print $3}' | strip_prefix | sort -u > "$d/have.txt"

    comm -12 "$d/have.txt" "$d/want.txt" > "$d/done.txt"
    comm -13 "$d/have.txt" "$d/want.txt" > "$d/todo.txt"

    local total done_n todo_n
    total=$(wc -l < "$d/want.txt" | tr -d ' ')
    done_n=$(wc -l < "$d/done.txt" | tr -d ' ')
    todo_n=$(wc -l < "$d/todo.txt" | tr -d ' ')
    todo_total=$((todo_total + todo_n))

    if [ "$todo_n" -eq 0 ]; then
        if [ "$swapped" = "yes" ]; then
            printf '  %-22s%s / %s symbols (100%%), complete and swapped into the build\n' "$label" "$done_n" "$total"
        else
            printf '  %-22s%s / %s symbols (100%%), complete -- NOT swapped in yet\n' "$label" "$done_n" "$total"
        fi
    else
        printf '  %-22s%s / %s symbols (%s%%), %s remaining\n' \
            "$label" "$done_n" "$total" "$((done_n * 100 / total))" "$todo_n"
    fi

    if [ "$LIST" = "1" ] && [ "$todo_n" -gt 0 ]; then
        printf '\n  %s remaining:\n' "$label"
        sed 's/^/    /' "$d/todo.txt"
        printf '\n'
    fi
}

# Both units compile through `ported.zig`: it imports every ported file, and a
# Zig module may not import above its root, so the quants cannot be compiled on
# their own. Each unit's contract still comes from its own C file, so the
# comparison stays per-translation-unit.
report_unit "ggml.c" llama.cpp/ggml/src/ggml.c yes "$PORTED_DIR/ported.zig"

printf '  %-22scomplete and swapped into the build\n' "ggml-alloc.c"

report_unit "ggml-quants.c" llama.cpp/ggml/src/ggml-quants.c yes "$PORTED_DIR/ported.zig"

report_unit "ggml-cpu.c" llama.cpp/ggml/src/ggml-cpu/ggml-cpu.c yes "$PORTED_DIR/ported.zig"

report_unit "ggml-cpu/quants.c" llama.cpp/ggml/src/ggml-cpu/quants.c yes "$PORTED_DIR/ported.zig"

report_unit "arch/arm/quants.c" llama.cpp/ggml/src/ggml-cpu/arch/arm/quants.c yes "$PORTED_DIR/ported.zig"

# Stage 4: the C++ translation units. The contract is the unmangled exports --
# see the note on `LANG_` above.
LANG_=cxx report_unit "ggml-threading.cpp" llama.cpp/ggml/src/ggml-threading.cpp yes "$PORTED_DIR/ported.zig"

# ggml-backend-dl.cpp has no unmangled exports at all -- its three functions
# have C++ linkage -- so there is nothing for this to compare. It left the
# build with the registry, which was its only caller.
LANG_=cxx report_unit "ggml-backend-reg.cpp" llama.cpp/ggml/src/ggml-backend-reg.cpp yes "$PORTED_DIR/ported.zig"

# gguf.cpp exports 2,002 symbols and 61 of them are the contract. The two the
# C++ has beyond those -- `gguf_type_size` and `gguf_write_to_buf` -- are
# declared in ggml-impl.h inside `#ifdef __cplusplus` under the comment "expose
# GGUF internals for test code", which gives them C++ linkage. Their only caller
# anywhere is tests/test-gguf.cpp, which this project does not build, so the
# `_Z` filter drops them and the port does not reproduce them.
LANG_=cxx report_unit "gguf.cpp" llama.cpp/ggml/src/gguf.cpp yes "$PORTED_DIR/ported.zig"

# ggml-backend.cpp is split across two Zig files: the vtable dispatch and the
# graph scheduler. 102 C-ABI symbols of 243 exports; the mangled remainder is
# template and inline noise that no other object references.
LANG_=cxx report_unit "ggml-backend.cpp" llama.cpp/ggml/src/ggml-backend.cpp yes \
    "$PORTED_DIR/backend.zig" "$PORTED_DIR/backend_sched.zig"

# The ggml-cpu/ C++, taken in order of size. These are on the hot path and
# covered by backend-ops, parity-cli and graph-diff -- unlike the two files
# Decision 40 deferred.
# Rooted at `ported.zig`, not the file itself: anything under `cpu/` imports
# `../impl.zig`, which a per-file module root cannot see.
LANG_=cxx report_unit "binary-ops.cpp" llama.cpp/ggml/src/ggml-cpu/binary-ops.cpp yes \
    "$PORTED_DIR/ported.zig"
LANG_=cxx report_unit "unary-ops.cpp" llama.cpp/ggml/src/ggml-cpu/unary-ops.cpp yes \
    "$PORTED_DIR/ported.zig"
LANG_=cxx report_unit "vec.cpp" llama.cpp/ggml/src/ggml-cpu/vec.cpp yes \
    "$PORTED_DIR/ported.zig"
# ops.cpp, split by op family across cpu/ops/. Its value-level gate is
# `make ops-diff`, which backend-ops and parity cannot stand in for.
LANG_=cxx report_unit "ops.cpp" llama.cpp/ggml/src/ggml-cpu/ops.cpp yes \
    "$PORTED_DIR/ported.zig"
# The IQ panel GEMM (v0.4.0): live only where `ggml_cpu_has_avx2()`, so on
# ARM its six exports are compiled and never reached; x86-ops-diff gates them.
LANG_=cxx report_unit "iqp.cpp" llama.cpp/ggml/src/ggml-cpu/iqp.cpp yes \
    "$PORTED_DIR/ported.zig"
LANG_=cxx report_unit "llamafile/sgemm.cpp" llama.cpp/ggml/src/ggml-cpu/llamafile/sgemm.cpp yes \
    "$PORTED_DIR/ported.zig"
# The vtable cluster. These four move as one unit -- repack.cpp derives
# from the two abstract bases traits.cpp declares -- and for repack.cpp the
# unmangled count below is NOT the whole contract: its buffer type,
# `extra_buffer_type` and `tensor_traits` instantiations all have C++
# linkage. `scripts/cluster-check` is what covers that half, by asserting a
# flag the port has to flip; `make node-diff` is what proves it works.
LANG_=cxx report_unit "ggml-cpu/traits.cpp" llama.cpp/ggml/src/ggml-cpu/traits.cpp yes \
    "$PORTED_DIR/ported.zig"
LANG_=cxx report_unit "ggml-cpu.cpp" llama.cpp/ggml/src/ggml-cpu/ggml-cpu.cpp yes \
    "$PORTED_DIR/ported.zig"
LANG_=cxx report_unit "repack.cpp" llama.cpp/ggml/src/ggml-cpu/repack.cpp yes \
    "$PORTED_DIR/ported.zig"
LANG_=cxx report_unit "arch/arm/repack.cpp" llama.cpp/ggml/src/ggml-cpu/arch/arm/repack.cpp yes \
    "$PORTED_DIR/ported.zig"
# The Metal host layer. The two .m files are never ported (Decision 13);
# the boundary with them is a pure C ABI, measured. Not compiled off Apple.
if [ "$MACHO" = 1 ]; then
LANG_=cxx report_unit "ggml-metal-common.cpp" llama.cpp/ggml/src/ggml-metal/ggml-metal-common.cpp yes \
    "$PORTED_DIR/ported.zig"
# ggml-metal-tuning.cpp has no unmangled exports at all: its whole contract
# is seven C++-linkage functions in `namespace ggml_metal_tuning`, which the
# Zig exports under their mangled names. Without MANGLED_ this line would
# read `0 / 0 symbols (100%)` for an untouched file.
LANG_=cxx report_unit "ggml-metal.cpp" llama.cpp/ggml/src/ggml-metal/ggml-metal.cpp yes \
    "$PORTED_DIR/ported.zig"
MANGLED_="_ZN17ggml_metal_tuning11fa_vec_pickE20ggml_metal_device_idiiiixx
_ZN17ggml_metal_tuning18fa_vec_baseline_neEii
_ZN17ggml_metal_tuning18fa_vec_ne01_bucketEx
_ZN17ggml_metal_tuning18fa_vec_ne11_bucketEx
_ZN17ggml_metal_tuning19fa_vec_baseline_cfgEii
_ZN17ggml_metal_tuning19fa_vec_set_overrideENS_12fa_vec_cfg_tE
_ZN17ggml_metal_tuning21fa_vec_clear_overrideEv" \
LANG_=cxx report_unit "ggml-metal-tuning.cpp" llama.cpp/ggml/src/ggml-metal/ggml-metal-tuning.cpp yes \
    "$PORTED_DIR/ported.zig"
LANG_=cxx report_unit "ggml-metal-device.cpp" llama.cpp/ggml/src/ggml-metal/ggml-metal-device.cpp yes \
    "$PORTED_DIR/ported.zig"
LANG_=cxx report_unit "ggml-metal-ops.cpp" llama.cpp/ggml/src/ggml-metal/ggml-metal-ops.cpp yes \
    "$PORTED_DIR/ported.zig"
else
    printf '  %-22snot part of this target\n' "ggml-metal/*.cpp"
fi
# ggml-opt.cpp: 37 C-ABI symbols, not the 9 PLAN.md's survey recorded.
# src/ggml/opt.zig, gated by scripts/opt-diff.
LANG_=cxx report_unit "ggml-opt.cpp" llama.cpp/ggml/src/ggml-opt.cpp yes \
    "$PORTED_DIR/ported.zig"
# ggml-backend-meta.cpp: 8 C-ABI symbols. src/ggml/backend_meta.zig, gated by
# scripts/meta-diff.
LANG_=cxx report_unit "ggml-backend-meta.cpp" llama.cpp/ggml/src/ggml-backend-meta.cpp yes \
    "$PORTED_DIR/ported.zig"

# libllama. It swaps once, at llama.h (PLAN.md, Decision 42), except for the
# sampler and grammar, which swap ahead of the rest.
INCLUDES=(-I llama.cpp/include -I llama.cpp/src -I llama.cpp/ggml/include -I llama.cpp/ggml/src -I "$VERSION_DIR")
EXTRA_MANGLED_="_Z27llama_sampler_backend_beginP13llama_sampler
_Z29llama_sampler_backend_n_nodesPK13llama_sampler" \
LANG_=cxx report_unit "llama-sampler.cpp" llama.cpp/src/llama-sampler.cpp yes src/llama/module.zig
# llama-grammar.cpp exports nothing with C linkage, and its five
# `llama_grammar_*_impl` functions have one caller, the sampler, which is
# now Zig too: the grammar's contract went with it.
printf '  %-22scomplete and swapped into the build, with llama-sampler.cpp\n' "llama-grammar.cpp"

exit 0

