#!/bin/bash
# Compare tools/server/http.zig and tools/server/httplib/ -- the port of
# llama-server's server-http.cpp and of cpp-httplib's server half -- with
# upstream's, on the wire.
#
# harness/http_ref.cpp runs upstream's server_http_context (server-http.cpp,
# server-common.cpp and httplib.cpp compiled unmodified, with
# llama.cpp.zmake's httplib_defines and ui-stub); harness/http_diff.zig runs
# the port's with the same routes. harness/http_driver.py starts each under
# fifteen configurations -- API keys, a path prefix, CORS settings, thread
# counts, not ready, the Vertex AI routes, a Unix socket, several listeners,
# and five that fail to start -- sends both the same raw bytes, and requires every response's
# bytes, how each connection ended, every log line and the exit code to be
# identical. Only the port, the socket path and cpp-httplib's random
# multipart/byteranges boundary are masked.
#
# Usage: scripts/http-diff [--only CONFIG[,CONFIG]] [--case SUBSTR] [--keep DIR]
#   HTTP_DIFF_NO_BUILD=1  use the harnesses already in zig-out/http-diff
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2

if [ -z "${HTTP_DIFF_NO_BUILD:-}" ]; then
    zig build http-diff-bins --release=fast || { echo "FAIL: could not build the harnesses" >&2; exit 1; }
fi
for b in http_ref http_port; do
    [ -x "zig-out/http-diff/$b" ] || { echo "FAIL: zig-out/http-diff/$b is missing" >&2; exit 1; }
done

exec python3 -I harness/http_driver.py zig-out/http-diff/http_ref zig-out/http-diff/http_port "$@"
