#!/bin/bash
# src/mtmd/audio.zig against upstream's tools/mtmd/mtmd-audio.cpp, compiled
# unmodified beside it, in one process: every preprocessor and the streaming
# inverse STFT, compared on bits (harness/mtmd_audio_diff.zig).
#
# Usage: scripts/mtmd-audio-diff [--quick] [config-name-substring]
#   MTMD_AUDIO_O=fast|safe   the build mode, ReleaseFast by default; the bits
#                            are calibrated there, ReleaseSafe looks for UB
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 2
# -Dcuda=false: these preprocessors run on the CPU alone, and a CUDA build
# imports the port's `llama` module, whose CUDA link carries `libstdc++.so`
# (llama-cli needs it for cuBLAS and the CUB shim). libstdc++'s
# `__gxx_personality_v0` then wins over Zig's libc++abi and aborts on every
# exception the reference throws, which the harness means to catch: on the
# GB10, v0.8.0's torch-resize cases ended in `terminate` (NOTES.md, "Upstream
# sync v0.7.0 → v0.8.0"). A no-op on macOS, where CUDA is off anyway.
zig build mtmd-audio-diff --release="${MTMD_AUDIO_O:-fast}" -Dcuda=false >/dev/null 2>&1 \
    || { echo "FAIL: could not build mtmd-audio-diff (zig build mtmd-audio-diff)" >&2; exit 2; }
exec zig-out/bin/mtmd-audio-diff "$@"
