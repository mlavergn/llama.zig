#!/usr/bin/env python3
"""Generate the CUDA flash-attention kernel configuration tables.

`fattn-mma-f16.cuh` and `fattn-tile.cuh` pick a kernel's thread count,
occupancy and batch sizes from one table per GPU family, each a function of
`GGML_CUDA_FATTN_{MMA,TILE}_CONFIG_CASE(DKQ, DV, ncols, ...)` lines tried in
order, ending in a default or another family's table. The host code and
the kernels read the same table (the kernels at compile time), so a
transcription error would make the host launch a kernel with a block size
or shared-memory size it was not compiled for -- silently, as far as the
grid goes. So the tables are generated from the headers, not typed.

Only the NVIDIA families are emitted: mma's ampere, turing and volta, and
tile's nvidia_fp16 and nvidia_fp32. The host getters reach the AMD tables
(mma's cdna and rdna, tile's amd and amd_rdna) only for an AMD compute
capability, which a CUDA device never has.

Writes:
  src/ggml/cuda/fattn_config_table.zig

Run after moving the upstream pin.
"""
import re

DIR = "llama.cpp/ggml/src/ggml-cuda"
COMMIT = "c1d0e7a00"
OUT = "src/ggml/cuda/fattn_config_table.zig"

MMA_FAMILIES = ["ampere", "turing", "volta"]
TILE_FAMILIES = ["nvidia_fp16", "nvidia_fp32"]

NUM = r"\s*(\d+)\s*"
MMA_CASE = re.compile(r"\s*GGML_CUDA_FATTN_MMA_CONFIG_CASE\(" + ",".join([NUM] * 10) + r",\s*(true|false)\s*\);")
MMA_DEFAULT = re.compile(r"\s*return fattn_mma_config\(" + ",".join([NUM] * 7) + r",\s*(true|false)\s*\);")
MMA_FALLTHROUGH = re.compile(r"\s*return ggml_cuda_fattn_mma_get_config_(\w+)\(DKQ, DV, ncols\);")
TILE_CASE = re.compile(r"\s*GGML_CUDA_FATTN_TILE_CONFIG_CASE\(" + ",".join([NUM] * 7) + r"\)")
TILE_DEFAULT = re.compile(r"\s*return 0;")


def function_body(lines, name):
    """The function's first line (1-based) and its body lines."""
    first = next(i for i, l in enumerate(lines) if name + "(" in l and "static" in l)
    body = []
    for l in lines[first + 1:]:
        if l.startswith("}"):
            break
        body.append(l)
    return first + 1, body


def mma_entry(g):
    dkq, dv, ncols, nthreads, occ, fa, k2, v2, comb, nst, qreg = g
    return (f".{{ .DKQ = {dkq}, .DV = {dv}, .ncols = {ncols}, .config = .{{ .nthreads = {nthreads}, .occupancy = {occ}, "
            f".nbatch_fa = {fa}, .nbatch_K2 = {k2}, .nbatch_V2 = {v2}, .nbatch_combine = {comb}, "
            f".nstages_target = {nst}, .Q_in_reg = {qreg} }} }}")


def mma_config(g):
    nthreads, occ, fa, k2, v2, comb, nst, qreg = g
    return (f".{{ .nthreads = {nthreads}, .occupancy = {occ}, .nbatch_fa = {fa}, .nbatch_K2 = {k2}, "
            f".nbatch_V2 = {v2}, .nbatch_combine = {comb}, .nstages_target = {nst}, .Q_in_reg = {qreg} }}")


def parse_mma(lines, family):
    first, body = function_body(lines, "ggml_cuda_fattn_mma_get_config_" + family)
    cases, default, fallthrough = [], None, None
    for l in body:
        if m := MMA_CASE.match(l):
            cases.append(mma_entry(m.groups()))
        elif m := MMA_DEFAULT.match(l):
            default = mma_config(m.groups())
        elif m := MMA_FALLTHROUGH.match(l):
            fallthrough = m.group(1)
    assert (default is None) != (fallthrough is None), family
    return first, cases, default, fallthrough


def parse_tile(lines, family):
    first, body = function_body(lines, "ggml_cuda_fattn_tile_get_config_" + family)
    cases, default = [], False
    for l in body:
        if m := TILE_CASE.match(l):
            dkq, dv, ncols, nthreads, occ, fa, k = m.groups()
            cases.append(f".{{ .DKQ = {dkq}, .DV = {dv}, .ncols = {ncols}, .nthreads = {nthreads}, .occupancy = {occ}, .nbatch_fa = {fa}, .nbatch_K = {k} }}")
        elif TILE_DEFAULT.match(l):
            default = True
    assert default, family
    return first, cases


mma_lines = open(f"{DIR}/fattn-mma-f16.cuh").read().split("\n")
tile_lines = open(f"{DIR}/fattn-tile.cuh").read().split("\n")
mma = {f: parse_mma(mma_lines, f) for f in MMA_FAMILIES}
tile = {f: parse_tile(tile_lines, f) for f in TILE_FAMILIES}

out = [
    "//! The NVIDIA flash-attention kernel configuration tables.",
    "//!",
    "//! # Provenance",
    "//!",
    "//! **Generated by `scripts/gen-fattn-config`; do not edit.** Ported from",
    "//! `llama.cpp/ggml/src/ggml-cuda/fattn-mma-f16.cuh` and",
    f"//! `llama.cpp/ggml/src/ggml-cuda/fattn-tile.cuh` at v0.3.0 (`{COMMIT}`).",
    "//! Each table is a function's `GGML_CUDA_FATTN_*_CONFIG_CASE` lines in",
    "//! order; the first entry matching (DKQ, DV, ncols) wins, else the",
    "//! function's last line: a default, or another family's table. The AMD",
    "//! tables are not emitted: the host getters reach them only for an AMD",
    "//! compute capability.",
    "",
    'const MmaConfig = @import("fattn_mma.zig").Config;',
    "",
    "/// One `GGML_CUDA_FATTN_MMA_CONFIG_CASE`.",
    "pub const MmaCase = struct { DKQ: c_int, DV: c_int, ncols: c_int, config: MmaConfig };",
    "",
    "pub const MmaTable = struct {",
    "    cases: []const MmaCase,",
    "    /// The config returned when no case matches; null when the family",
    "    /// falls through to `fallthrough`.",
    "    default: ?MmaConfig,",
    "    fallthrough: ?*const MmaTable,",
    "};",
    "",
    "/// One `GGML_CUDA_FATTN_TILE_CONFIG_CASE`, before the C packs it into a",
    "/// `uint32_t`.",
    "pub const TileCase = struct { DKQ: c_int, DV: c_int, ncols: c_int, nthreads: u32, occupancy: u32, nbatch_fa: u32, nbatch_K: u32 };",
    "",
]
for f in MMA_FAMILIES:
    first, cases, default, fallthrough = mma[f]
    out.append(f"/// Ports `ggml_cuda_fattn_mma_get_config_{f}` (fattn-mma-f16.cuh:{first} @{COMMIT}).")
    out.append(f"pub const mma_{f}: MmaTable = .{{")
    out.append("    .cases = &.{")
    for e in cases:
        out.append(f"        {e},")
    out.append("    },")
    out.append(f"    .default = {default if default else 'null'},")
    out.append(f"    .fallthrough = {('&mma_' + fallthrough) if fallthrough else 'null'},")
    out.append("};")
    out.append("")
for f in TILE_FAMILIES:
    first, cases = tile[f]
    out.append(f"/// Ports `ggml_cuda_fattn_tile_get_config_{f}` (fattn-tile.cuh:{first} @{COMMIT}); no match")
    out.append("/// is the C's `return 0`.")
    out.append(f"pub const tile_{f} = [_]TileCase{{")
    for e in cases:
        out.append(f"    {e},")
    out.append("};")
    out.append("")

open(OUT, "w").write("\n".join(out))
print(f"wrote {OUT}: " + ", ".join([f"mma {f} {len(mma[f][1])}" for f in MMA_FAMILIES] + [f"tile {f} {len(tile[f][1])}" for f in TILE_FAMILIES]))
