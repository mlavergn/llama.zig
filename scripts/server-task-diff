def png(w, h, seed):
    r = random.Random(seed)
    raw = b"".join(b"\x00" + bytes(r.randrange(256) for _ in range(w * 3)) for _ in range(h))
    def chunk(t, d):
        c = struct.pack(">I", len(d)) + t + d
        return c + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))


IMG1 = png(64, 64, 1)
IMG2 = png(100, 60, 2)
B64_1 = __import__("base64").b64encode(IMG1).decode()
B64_2 = __import__("base64").b64encode(IMG2).decode()

WORDS = ["hello", "world", " Paris", "", " ", "\n", "é", "日本", "😀", "<|im_start|>", "<|endoftext|>", "<s>", "</s>",
         "\\", "\"q\"", "{\"a\":1}", "a" * 40, "tab\tchar", "def f():", "<think>", "ÿ", "x\u0000y"]
JUNK = [None, 0, -1, 1, 2, 7, -7, 2.5, -0.5, 1e10, -1e10, 2147483648, -2147483649, 4294967296, 9007199254740993,
        True, False, [], {}, "s", "", "-1", [1], ["a", "b"], [[1, 2]], {"k": "v"}, {"id": 0, "scale": 0.5}]


def word():
    return rng.choice(WORDS) + (rng.choice(WORDS) if rng.random() < 0.3 else "")


def junk():
    return rng.choice(JUNK)


def test_payloads():
    """Every `data=` / `json=` dict literal in upstream's server tests, as far
    as it is literal: non-literal members are dropped, not guessed."""
    out = []
    d = "llama.cpp/tools/server/tests/unit"
    for name in sorted(os.listdir(d)):
        if not name.endswith(".py"):
            continue
        try:
            tree = ast.parse(open(os.path.join(d, name), encoding="utf-8").read())
        except SyntaxError:
            continue
        for node in ast.walk(tree):
            if isinstance(node, ast.Call):
                for kw in node.keywords:
                    if kw.arg in ("data", "json") and isinstance(kw.value, ast.Dict):
                        out.append(literal_dict(kw.value))
    return [p for p in out if p]


def literal_dict(node):
    res = {}
    for k, v in zip(node.keys, node.values):
        try:
            key = ast.literal_eval(k)
        except Exception:
            continue
        if not isinstance(key, str):
            continue
        try:
            res[key] = ast.literal_eval(v)
        except Exception:
            if isinstance(v, ast.Dict):
                res[key] = literal_dict(v)
    return res


