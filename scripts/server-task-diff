    # the /tts request fields: limits, aliases, defaults over params_base
    for b in ({}, {"top_k": 5}, {"top_k": -3}, {"top_p": 0.5}, {"top_p": 7}, {"seed": 7}, {"seed": -1}, {"n_predict": 4},
