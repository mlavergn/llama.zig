    "'Output text' requires 'text'", "'Refusal' requires 'refusal'", "'type' must be one of 'output_text' or 'refusal'",
    "Output of tool call should be 'Input text' or 'Input image'", "Output of tool call missing 'type' field",
    "video input is not supported", "item['content'] is not an array", "item['content'] is empty",
    "item['content']['text'] is not a string", "Cannot determine type of 'item'", "'input' must be a string or array",
    "'tools' must be an array of objects", "No input file found for transcription",
    "Only 'json' response_format is supported", "stoul: no conversion", "stof: no conversion", "out of range",
    "__metadata_user_id", "thinking_budget_tokens", "Perform ASR", "Transcribe audio to text", "cch=fffff",
    "\"tool_calls\":[{", "reasoning_content", "Cannot use custom grammar constraints with tools",
    "logprobs is not supported with tools + stream", "Unable to generate parser", "reasoning_budget_end_tags",
    # v0.7.0: the chat session (#30210), its format applied to the task,
    # its sampling, tokenized chunks
    "sp.grammar_lazy\":true", "\"has_template\":false", "\"format\":\"peg-native\"",
    "chat_format_int\":2", "chat_format_int\":3", "chat_format_int\":4", "\"chat_format\":\"peg-gemma4\"", "ctoks ",
    "does not match the expected", "response.function_call_arguments.delta", "tool_use",
]
LOG_COVERAGE = [
    "Wrong type supplied for parameter", "prompt is already in the cache",
    "making room for prompt cache entry", "removing obsolete cached prompt", "exceeds cache size limit",
    "cache token limit", "found better prompt", "unable to match sampler by name",
    "unable to match sampler by char", "Converted grammar", "JSON schema:", "reasoning budget: tokens=",
    "No parser definition detected", "Parsed message", "Grammar (tool_calls)", "Grammar (", "n_prefix_take",
    "loading image from local file", "cache state:",
    "unsupported Responses tool type", "anthropic string not as expected", "Forcing pure content template",
]


LABELLED = re.compile(r"^(\w+)\(\d+\):")


def same_jinja(ref, port):
    """A port line holding the Jinja engine's failure (`jinja: `) matches a
    reference line equal up to there, the length labels aside: the engine's
    own text is not reproduced (NOTES.md, "Stage 9 step 4")."""
    if "jinja: " not in port:
        return False
    r = LABELLED.sub(r"\1:", ref)
    p = LABELLED.sub(r"\1:", port)
    at = p.find("jinja: ")
    return r[:at] == p[:at]


def align_jinja(a, b):
    """`b` with each line `same_jinja` accepts replaced by the reference's,
    and a multi-line engine message in `a` -- the reference logs it whole --
    taken as one: its continuation lines run up to the port's next line."""
    out = []
    i = j = 0
    while j < len(b):
        if i < len(a) and a[i] == b[j]:
            out.append(a[i])
            i += 1
            j += 1
        elif i < len(a) and same_jinja(a[i], b[j]):
            nxt = b[j + 1] if j + 1 < len(b) else None
            k = i + 1
            while k < len(a) and a[k] != nxt and not (nxt is not None and same_jinja(a[k], nxt)):
                k += 1
            out.extend(a[i:k])
            i = k
            j += 1
        else:
            out.append(b[j])
            i += 1
            j += 1
    return out


def mask(s):
    s = re.sub(r'"(created|created_at|completed_at)":-?\d+', r'"\1":0', s)
    s = re.sub(r'(resp_|rs_|msg_|chatcmpl-|fc_|call_)[0-9A-Za-z]{32}', r'\1*', s)
    # a tool call's id, gen_tool_call_id's 32 random characters; before the
    # pointers, whose mask would break one that happens to hold "0x" and a hex digit
    s = re.sub(r'"id":"[0-9A-Za-z]{32}"', '"id":"*"', s)
    s = re.sub(r'0x[0-9a-f]+', '0x*', s)
    return s


def main():
    global MEDIA_DIR
    out = os.environ.get("SERVER_TASK_OUT") or tempfile.mkdtemp(prefix="server-task-diff.")
    os.makedirs(out, exist_ok=True)
    MEDIA_DIR = os.path.join(os.path.abspath(out), "media") + "/"
    os.makedirs(MEDIA_DIR + "sub", exist_ok=True)
    open(MEDIA_DIR + "img1.png", "wb").write(IMG1)
    open(MEDIA_DIR + "sub/img2.png", "wb").write(IMG2)

    # the decision models (harness/server/decision.setup)
    dec_data = os.path.join(out, "decision")
    os.makedirs(dec_data, exist_ok=True)
    if subprocess.run(["harness/server/decision.setup"], env=dict(os.environ, DATA=dec_data)).returncode != 0:
        print("FAIL: harness/server/decision.setup", file=sys.stderr)
        sys.exit(2)
    dec_env = dict(l.strip().split("=", 1) for l in open(os.path.join(dec_data, "setup.env")) if "=" in l)
    DEC_FIXTURES[:] = [dec_env[f"DEC{n}"] for n in DEC_NAMES]

    recs = list(records())
    inp = os.path.join(out, "input.txt")
    with open(inp, "w", encoding="utf-8", errors="surrogatepass") as f:
        for op, payload in recs:
            f.write(f"{op} {json.dumps(payload, ensure_ascii=True)}\n")

    def run(cmd, what, **kw):
        r = subprocess.run(cmd, capture_output=True, **kw)
        if r.returncode != 0:
            print(f"FAIL: {what} (rc {r.returncode})\n{r.stderr.decode(errors='replace')[-3000:]}", file=sys.stderr)
            sys.exit(2)
        return r

    ref = os.path.join(out, "server_task_ref")
    port = os.environ.get("SERVER_TASK_PORT_BIN") or "zig-out/server-task-diff/server_task_port"
    if not os.environ.get("SERVER_TASK_NOBUILD"):
        run(["zig", "build", "reference", "tools-ref", "mtmd-ref", "--release=fast"],
            "could not build the reference libraries (zig build reference tools-ref mtmd-ref)")
        run(["zig", "build-exe", "-OReleaseFast", f"-femit-bin={ref}",
             "-I", "llama.cpp/tools/server", "-I", "llama.cpp/common", "-I", "llama.cpp/include",
             "-I", "llama.cpp/ggml/include", "-I", "llama.cpp/vendor", "-I", "llama.cpp/tools/mtmd",
             "-cflags", "-std=c++17", "-w", "--", "harness/server_task_ref.cpp",
             "llama.cpp/tools/server/server-common.cpp", "llama.cpp/tools/server/server-task.cpp",
             "llama.cpp/tools/server/server-schema.cpp", "llama.cpp/tools/server/server-chat.cpp",
             "llama.cpp/tools/server/server-decision.cpp",
             "zig-out/lib/libllama-common-ref.a", "zig-out/lib/libmtmd-ref.a", "zig-out/lib/libllama-ref.a",
             "zig-out/lib/libggml.a", "-lc++", "-lc"] + platform_libs("exe"),
            "could not build harness/server_task_ref.cpp")
        run(["zig", "build", "server-task-diff-bins", "--release=fast"], "could not build harness/server_task_diff.zig")

    env = dict(os.environ, LLAMA_MEDIA_MARKER=MARKER)
    failures = 0
    total = 0
    ref_all = ""
    log_all = ""
    for pi, (text_model, mmproj, only) in enumerate(PASSES):
        pinp = os.path.join(out, f"input{pi}.txt")
        with open(pinp, "w", encoding="utf-8") as f:
            for op, payload in recs:
                if only(op, payload if isinstance(payload, dict) else {}):
                    f.write(f"{op} {json.dumps(payload, ensure_ascii=True)}\n")
        sides = {}
        for name, exe in (("ref", ref), ("port", port)):
            t = os.path.join(out, f"{name}{pi}.txt")
            r = run([exe, pinp, t, text_model, mmproj] + VOCABS + DEC_FIXTURES, f"the {name} failed (or leaked) on pass {pi}", env=env)
            sides[name] = (mask(open(t, encoding="utf-8", errors="replace").read()), mask(r.stderr.decode(errors="replace")))
            open(os.path.join(out, f"{name}{pi}.log"), "w").write(r.stderr.decode(errors="replace"))
        ref_all += sides["ref"][0]
        log_all += sides["ref"][1]
        for kind, idx in (("transcript", 0), ("log", 1)):
            a = sides["ref"][idx].splitlines()
            b = sides["port"][idx].splitlines()
            total += len(a)
            # a Jinja engine's own message is not reproduced (NOTES.md, "Stage
            # 9 step 4"): where the port's reads `jinja: `, the class alone
            b = align_jinja(a, b)
            if a != b:
                failures += 1
                import difflib
                print(f"FAIL: server-task-diff: pass {pi} {kind}s differ; in {out}")
                for i, d in enumerate(difflib.unified_diff(a, b, "ref", "port", lineterm="", n=2)):
                    print("    " + d[:300])
                    if i > 40:
                        break
    missing = [p for p in COVERAGE if p not in ref_all] + [p for p in LOG_COVERAGE if p not in log_all]
    if missing:
        print("FAIL: server-task-diff: the reference never reached:")
        for m in missing:
            print("    " + m)
        failures += 1
    if failures:
        sys.exit(1)
    errors = sum(1 for l in ref_all.splitlines() if l.startswith(("runtime_error", "invalid_argument", "json_error")))
    print(f"ok: server-task-diff: {len(recs)} records, {total} transcript and log lines identical "
          f"({errors} exceptions, {len(COVERAGE) + len(LOG_COVERAGE)} coverage phrases)")


if __name__ == "__main__":
    main()
