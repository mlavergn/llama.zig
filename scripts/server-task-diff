              {"input": "hi", "extra_params": 5}, {"input": "hi", "extra_params": []}, {"input": "hi", "extra_params": None},
              {"input": "hi", "extra_params": {}}, {"input": "hi", "extra_params": {"extra_params": {"a": 1}}}):
        yield "RC", b
    for _ in range(N):
        yield "RC", responses_body()
    for tools in ([], [{"type": "function", "name": "f"}], [{"type": "function", "name": "f", "strict": False}],
                  [{"type": "web_search"}, {"type": "function", "name": "g", "parameters": {"type": "object"}}],
                  [{"name": "f"}], [5], "x", 3, None, {"a": 1}):
