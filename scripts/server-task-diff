def platform_libs(mode):
    """The system libraries a link beside zig-out/lib/libggml.a needs on this
    OS, from scripts/platform-libs -- the SDK's frameworks on macOS; on Linux
    the CUDA libraries when the toolkit is there, libgcc and libm. `mode` is
    "cc" for a `zig c++` link and "exe" for `zig build-exe`, which spell an
    rpath differently."""
    r = subprocess.run(["bash", "-c", 'source scripts/platform-libs && platform_libs "$1" zig-out/lib/libggml.a'
                        ' && printf "%s\\0" ${PLATFORM_LIBS[@]+"${PLATFORM_LIBS[@]}"}', "_", mode],
                       capture_output=True, text=True)
    if r.returncode != 0:
        print(f"FAIL: scripts/platform-libs\n{r.stderr}", file=sys.stderr)
        sys.exit(2)
    return [x for x in r.stdout.split("\0") if x]

N = int(os.environ.get("SERVER_TASK_N", "300"))
rng = random.Random(int(os.environ.get("SERVER_TASK_SEED", "1")))
MARKER = "<__media__>"

