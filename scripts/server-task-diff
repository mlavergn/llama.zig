    ("zig-out/mmproj-fixtures/text-qwen3.gguf", "zig-out/mmproj-fixtures/gemma3.gguf",
     lambda op, p: not (op == "G" and p.get("real"))),
    ("zig-out/mmproj-fixtures/text-qwen2vl.gguf", "zig-out/mmproj-fixtures/qwen2vl_merger.gguf",
     lambda op, p: op in ("M", "T")),
    # a real byte-level BPE vocabulary for the token-probability records, whose
    # single-byte pieces reach tokens_to_output_formatted_string's `byte:` arm
    ("Qwen3-0.6B-Q8_0.gguf", "-", lambda op, p: op == "G" and p.get("real")),
]

