    yield C({"messages": [{"role": "user", "content": [{"type": "image_url", "image_url": {"url": "file://img1.png"}}]}]}, media_path="")
    yield C({"messages": [u]}, kwargs={"enable_thinking": "\"yes\""})
    yield C({"messages": [u]}, reasoning_budget=5, reasoning_budget_message="m")
    yield ("C", {"v": 0, "tmpl": "bogus-template-name", "opt": {"allow_image": True}, "body": {"messages": [u]}})
    for tmpl in ("llama2", "llama3", "gemma", "phi3", "zephyr", "vicuna", "mistral-v7", "deepseek3", ""):
        yield ("C", {"v": 0, "tmpl": tmpl, "opt": {}, "body": {"messages": [{"role": "system", "content": "s"}, u, a, u]}})
    yield "ST", {"tokens": [5, 6, 7], "ops": [["serialize", 1000], ["serialize", 6], ["serialize", 7, 1, 2], ["serialize", 7, 0, 7]]}
    probs = [{"tok": 5, "prob": 0.5, "text": "h\u00e9", "probs": [{"tok": 6, "txt": "x\u00e9", "prob": 0.25}]}]
    # v0.7.0: a state's chat session parses each final once (feed() or
    # finish() after finish() is a GGML_ASSERT), so every final gets a fresh one
    for post in (False, True):
        yield "S", {"id": 999, "parser": {"format": 0}}
        yield "R", {"kind": "partial", "state": 999, "f": {"content": "a", "n_decoded": 1, "post_sampling_probs": post, "probs": probs}}
        yield "R", {"kind": "final", "state": 999, "f": {"content": "ab", "post_sampling_probs": post, "probs": probs}}
    for rt in (0, 1, 2, 3, 4, 6):
        for stop in range(4):
            for stream in (False, True):
                yield "S", {"id": 999, "parser": {"format": 0}}
                yield "R", {"kind": "final", "state": 999, "f": {"content": "c", "res_type": rt, "stop": stop, "stream": stream,
                                                                 "stopping_word": "###" if stop == 2 else "", "verbose": stop == 0}}
    MiB = 1 << 20
    yield "PC", {"limit_mib": 1, "limit_tokens": 0, "ops": [
        ["alloc", [1, 2, 3], 100, 0, []], ["alloc", [1, 2], 100, 0, []], ["alloc", [1, 2, 3, 4], 100, 20, [10]],
        ["alloc", [5], 2 * MiB, 0, []], ["alloc", [6], 600000, 0, []], ["alloc", [7], 600000, 0, []], ["update"],
        ["cur", [1, 2]], ["load", [1, 2, 3, 4, 9]], ["load", [7, 7]], ["cur", []], ["load", [6]]]}
    yield "PC", {"limit_mib": 0, "limit_tokens": 4, "ops": [
        ["alloc", [1, 2, 3], 10, 0, []], ["alloc", [4, 5, 6], 10, 0, []], ["update"], ["alloc", [7, 8, 9, 9, 9], 10, 0, []], ["update"]]}
    yield "PC", {"limit_mib": 1, "limit_tokens": 2, "ops": [
        ["alloc", [1, 2, 3], 1000, 0, []], ["alloc", [4, 5, 6], 1000, 0, []], ["update"]]}


def records():
    yield "RND", {}
    for r in targeted():
        yield r
    payloads = test_payloads()
    for p in payloads:
        yield "P", {"v": 0, "data": p}
        yield "O", p
        if "messages" in p:
            yield "C", {"v": 0, "tmpl": "chatml", "opt": chat_opt(), "body": p}
    for k, vals in FIELDS.items():
        for v in vals:
            yield "P", {"v": rng.randrange(len(VOCABS)), "data": {k: v}}
        yield "P", {"v": 0, "data": {k: None}}
    for _ in range(N):
        yield "P", {"v": rng.randrange(len(VOCABS)), "eog": rng.random() < 0.7, "data": rand_params()}
    # the log-gated throws: at a lower verbosity the dumps are not evaluated
    yield "P", {"v": 0, "data": {"json_schema": {"enum": ["\udcff"]}, "chat_format": 9}}
    for b in ({"verbosity": 10, "antiprompt": ["###", "User:"], "n_predict": 64, "n_keep": 4, "seed": 7,
               "samplers": "kt", "spec_types": [0, 6], "reasoning_format": 2, "dry_base": 2.5, "temp": 0.2,
               "cache_prompt": False, "sse_ping_interval": 5, "n_cache_reuse": 16},
              {"n_parallel": 1, "verbosity": 3, "antiprompt": [], "reasoning_format": 3}):
        yield "B", b
        for stop in ([], {}, [None, []], "", 5, ["x"]):
            yield "P", {"v": 0, "data": {"stop": stop}}
        for _ in range(N // 6):
            yield "P", {"v": rng.randrange(len(VOCABS)), "data": rand_params()}
    yield "B", {"n_parallel": 4, "verbosity": 3, "antiprompt": [], "seed": 4294967295, "reasoning_format": 3, "dry_base": 1.75,
                "temp": 0.8, "samplers": "edskypmxt", "spec_types": [0], "n_predict": -1, "n_keep": 0, "cache_prompt": True,
                "sse_ping_interval": 30, "n_cache_reuse": 0}
    for _ in range(N):
        b = {"prompt": rng.choice([word(), [1, 2], [word(), 5], None, 3])} if rng.random() < 0.9 else {}
        for _ in range(rng.randint(0, 3)):
            k = rng.choice(["stop", "echo", "best_of", "suffix", "n_predict", "max_tokens", "temperature", "x"])
            b[k] = rng.choice(["s", ["a"], True, False, 3, None])
        yield "O", b
    for _ in range(N):
        yield "C", {"v": rng.choice([0, 0, 1, 5]), "tmpl": rng.choice(["chatml", "chatml", "llama2", "llama3", "gemma", "phi3", "zephyr", "vicuna", "bogus-tmpl"]),
                    "opt": chat_opt(), "body": chat_body()}
    prompts = lambda: rng.choice([word(), [1, 2, 3], [word(), 5, word()], [word(), word()], [[1, 2], word()],
                                  {"prompt_string": word()}, {"prompt_string": [5, word()]}, {"x": 1}, [], [[]],
                                  [1.5], [True, "a"], [{"prompt_string": "p"}, 4], 5, None, [None],
                                  {"prompt_string": "a " + MARKER + " b", "multimodal_data": [B64_1]},
                                  {"prompt_string": "x", "multimodal_data": "!!"}])
    for _ in range(N):
        yield "T", {"v": rng.randrange(len(VOCABS)), "prompt": prompts(), "add_special": rng.random() < 0.6,
                    "parse_special": rng.random() < 0.6, "mtmd": rng.random() < 0.3, "ops": tokens_ops(5)}
    for prompt in ("describe " + MARKER, MARKER + " and " + MARKER + " end", "no media", MARKER):
        n_img = prompt.count(MARKER)
        for files in ([IMG1, IMG2][:n_img], [IMG2, IMG1][:n_img], [b"garbage"] * n_img, [IMG1] * (n_img + 1)):
            ops = tokens_ops(80, True) + [["prefix_edit", k, 7] for k in range(0, 40, 3)]
            yield "M", {"prompt": prompt, "files": [f.hex() for f in files], "ph": rng.random() < 0.3, "ops": ops}
    yield "T", {"v": 0, "mtmd": True, "prompt": {"prompt_string": "a " + MARKER, "multimodal_data": [B64_1]},
                "ops": [["keep_first", 3], ["pos_next", -1], ["serialize"]]}
    for _ in range(N // 3):
        toks = [rng.randint(-2, 160000) for _ in range(rng.randint(0, 10))]
        yield "ST", {"tokens": toks, "ops": tokens_ops(len(toks))}
    # utf-8: every 1- and 2-byte string, and 3/4-byte strings over the bytes that matter
    alph = [0x00, 0x41, 0x7f, 0x80, 0xbf, 0xc0, 0xc2, 0xdf, 0xe0, 0xef, 0xf0, 0xf4, 0xf7, 0xf8, 0xff]
    strs = [bytes([a]) for a in range(256)] + [bytes([a, b]) for a in range(256) for b in range(256)]
    strs += [bytes([a, b, c]) for a in alph for b in alph for c in alph]
    strs += [bytes([a, b, c, d]) for a in alph for b in alph for c in alph for d in alph]
    strs += [b"", b"abc\xe2\x82", b"x\xf0\x9f\x98", b"\xf0\x9f\x98\x80\xc3"]
    for i in range(0, len(strs), 512):
        yield "U", [s.hex() for s in strs[i:i + 512]]
    for t in [0, 1, 2, 3, 4, 5, 6, 7]:
        yield "E", {"type": t, "msg": word()}
    for gt in [{"type": 0, "value": "x", "token": 5}, {"type": 1, "value": "w"}, {"type": 3, "value": "p"},
               {"type": 0, "value": "x"}, {"type": "1", "value": "w"}, {"value": "w"}, {"type": 2, "value": 4}, [], "x"]:
        yield "GT", gt
    for kind, ops in results():
        yield kind, ops
    # on a generator state of their own, so the records after them stay as they were
    saved = rng.getstate()
    rng.seed(int(os.environ.get("SERVER_TASK_SEED", "1")) * 7919 + 4)
    for kind, ops in chat_step4():
        yield kind, ops
    rng.setstate(saved)
    for _ in range(N // 4):
        emb = [{"embedding": [rng.uniform(-2, 2) for _ in range(rng.randint(0, 4))], "tokens_evaluated": rng.randint(0, 9)}
               for _ in range(rng.randint(0, 3))]
        if rng.random() < 0.2:
            emb.append(rng.choice([{"embedding": "x"}, {"tokens_evaluated": "x"}, 5, {}]))
        yield "F", {"req": rng.choice([{}, {"model": "mm"}, {"model": 3}]), "model": "base", "emb": emb, "b64": rng.random() < 0.5}
    for _ in range(N // 4):
        n = rng.randint(0, 5)
        ranks = [{"index": rng.randint(0, max(n - 1, 0)), "score": rng.choice([0.5, -1.0, 0.5, 2.0, rng.random()]),
                  "tokens_evaluated": rng.randint(0, 9)} for _ in range(n)]
        yield "K", {"req": rng.choice([{}, {"return_text": True}, {"model": "x", "return_text": True}]), "model": "base",
                    "ranks": ranks, "tei": rng.random() < 0.5, "texts": [word() for _ in range(max(n, 1))],
                    "top_n": rng.randint(0, 6)}
    for v in range(len(VOCABS)):
        for _ in range(6):
            yield "I", {"v": v, "prefix": rng.choice([word(), [word(), 5], "def f():\n    "]),
                        "suffix": rng.choice([word(), "\nreturn x"]),
                        "extra": rng.choice([[], [{"text": word(), "filename": "a.py"}, {"text": "x"}], [{"filename": 3}]]),
                        "n_batch": rng.choice([0, 4, 16, 512]), "n_predict": rng.choice([-1, 8, 100000]),
                        "n_ctx": rng.choice([0, 64, 4096]), "spm": rng.random() < 0.5,
                        "prompt": [rng.randint(0, 100) for _ in range(rng.randint(0, 3))]}
        yield "Q", {"v": v, "query": word(), "doc": word()}
        # media without an mmproj, and without a rerank template
        yield "Q", {"v": v, "query": word(), "doc": word(), "n_qf": 1, "media": B64_1}
        yield "Q", {"v": v, "query": word(), "doc": word(), "n_df": 2, "media": B64_1, "mtmd": True}
    # one pass over the template: a placeholder written in the query stays text
    for _ in range(N):
        ph = lambda: rng.choice(["{query}", "{document}", "{query", "document}", "{", "}", word(), ""])
        yield "RT", {"tmpl": "".join(ph() for _ in range(rng.randint(0, 6))),
                     "query": "".join(ph() for _ in range(rng.randint(0, 3))),
                     "doc": "".join(ph() for _ in range(rng.randint(0, 3)))}
    for _ in range(6):
        # ASCII only on the fixture vocabulary: its byte tokens are not all there, and libllama throws on them
        yield "G", {"prompt": rng.choice(["hello", " Paris", "def f():", "the cat", "x y z"]) + " the", "n_top": [0, 1, 5, 100000]}
    yield "G", {"real": True, "prompt": "Bonjour \u00e9\u00e8 \U0001F600 \u65e5\u672c", "n_top": [0, 3, 100000000]}
    # rare characters, which byte-level BPE leaves as single bytes
    yield "G", {"real": True, "prompt": "\U00010348\U00013000\U0001F732\ua66e\U0001D4CD", "n_top": [2]}
    for _ in range(N // 10):
        ops = []
        for _ in range(rng.randint(1, 10)):
            k = rng.random()
            toks = [rng.randint(1, 6) for _ in range(rng.randint(1, 8))]
            if k < 0.5:
                ops.append(["alloc", toks, rng.choice([0, 100, 1 << 20, 3 << 20]), rng.choice([0, 0, 50]),
                            [rng.choice([10, 1 << 19]) for _ in range(rng.randint(0, 2))]])
            elif k < 0.7:
                ops.append(["update"])
            elif k < 0.85:
                ops.append(["cur", toks])
            else:
                ops.append(["load", toks])
        yield "PC", {"limit_mib": rng.choice([-1, 0, 1, 2]), "limit_tokens": rng.choice([0, 4, 10]), "ops": ops}
    yield "PIPE", {"max_size": 0, "ops": [["w", 1], ["r"], ["cw"], ["r"]]}
    yield "PIPE", {"max_size": 1, "ops": [["w", 1], ["w", 2], ["r"], ["r"]]}
    yield "PIPE", {"max_size": 2, "ops": [["w", 1], ["w", 2], ["w", 3], ["r"], ["r"], ["r"]]}
    for _ in range(20):
        ops = [rng.choice([["w", rng.randint(0, 9)], ["r"], ["r", False], ["cw"], ["cr"]]) for _ in range(rng.randint(1, 8))]
        yield "PIPE", {"max_size": rng.choice([0, 1, 2]), "ops": ops}
    for req in ([{"id": 0, "scale": 0.5}, {"id": 0, "scale": 0.25}, {"id": -3}], [], {"a": 1}, [{"id": "x"}], [1],
                [{"id": 2, "scale": "s"}, {"scale": 2}]):
        yield "L", {"req": req, "a": [0.5, 0.0, 1.0], "b": [rng.choice([0.5, 0.25]), 0.0, 1.0]}
    yield "L", {"req": [], "a": [], "b": [0.0]}
    for _ in range(40):
        js = rng.choice([{"a": {"b": [1, 2]}, "c": 3, "": {"": 1}}, [1, 2, "x"], [1, 2], ["x"], [], 5, None, {"a/b": 1}])
        yield "J", {"paths": [rng.choice(["a", "a/b", "c", "a/x", "", "/", "a/b/c", "a/b"]) for _ in range(rng.randint(0, 4))], "js": js}
    for v in ([{"event": "e", "data": {"x": 1}}, {"data": 1}], {"event": "e", "data": "é"}, {"x": "\udcff"}, [], 5, None,
              [{"event": 3, "data": 1}], {"event": "only"}):
        yield "SSE", v
    for t in range(15):
        yield "TK", {"type": t, "seed": rng.choice([4294967295, 7, 4294967294]), "children": rng.randint(0, 3)}
    # on a generator state of their own, so the records before them stay as they were
    saved = rng.getstate()
    rng.seed(int(os.environ.get("SERVER_TASK_SEED", "1")) * 7919 + 11)
    for kind, payload in decision_records():
        yield kind, payload
    rng.setstate(saved)


