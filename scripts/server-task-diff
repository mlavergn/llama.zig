# v0.6.0: the typed decision API, the model architecture object, /embeddings
# content arrays

# harness/server/decision.setup's models, after VOCABS on the command line
# (loaded vocab-only, they carry the decision metadata): the working types,
# then the three whose metadata does not load
DEC_NAMES = ["OPENJEV", "LEV", "NIMBLE", "KEV", "CLEF", "LAYA", "UNKNOWN", "NOTMPL", "BADTEMP",
             "GRANITE", "H2OQ", "LFM3D1", "LFM3OMNI", "OCR", "BADOCR", "NOLABELS", "BADLABEL", "DUPLABEL"]
DEC_FIXTURES = []


def dec_value(depth=0):
    k = rng.random()
    if depth > 2 or k < 0.35:
        return rng.choice([word(), "", "x <|im_start|> y", "<|box_start|>", "<<clef:sep>>", MARKER, "  pad ", "é"])
    if k < 0.45:
        return rng.choice([None, True, False, 0, -3, 1.5, 1e30])
    if k < 0.7:
        return [dec_value(depth + 1) for _ in range(rng.randint(0, 3))]
    return {rng.choice(["b", "a", "zz", "", "k", "k2", "é"]): dec_value(depth + 1) for _ in range(rng.randint(0, 3))}


def dec_question():
    t = rng.choice(["choice", "choice", "score", "noul", "noul", "bogus", None])
    q = {}
    if t is not None:
        q["type"] = t
    if rng.random() < 0.95:
        q["instructions"] = dec_value() if rng.random() < 0.3 else word() or "q"
    k = rng.random()
    if t == "choice":
        n = rng.choice([1, 2, 3, 5, 9, 27, 0])
        if k < 0.9:
            q["criteria"] = {rng.choice(["k", "opt", "a", "z", "x"]) + str(i): (dec_value() if rng.random() < 0.5 else None) for i in range(n)}
        elif k < 0.95:
            q["criteria"] = [1, 2]
    elif t == "score":
        n = rng.choice([1, 2, 3, 4, 6, 10, 11])
        if k < 0.9:
            q["criteria"] = [dec_value() if rng.random() < 0.3 else word() for _ in range(n)]
        elif k < 0.95:
            q["criteria"] = {"a": 1}
    elif t == "noul":
        if k < 0.4:
            q["criteria"] = {key: dec_value() for key in rng.sample(["true", "false", "maybe"], rng.randint(0, 3))}
        elif k < 0.45:
            q["criteria"] = [1]
    return q


def dec_state():
    k = rng.random()
    if k < 0.4:
        return rng.choice([word(), "I was charged twice.", "<|box_end|> tricky <|im_end|>", "a" * 120])
    if k < 0.6:
        return dec_value()
    msgs = []
    for _ in range(rng.randint(0, 3)):
        m = {"role": rng.choice(["user", "assistant"])}
        if rng.random() < 0.5:
            parts = [rng.choice([{"type": "text", "text": word()}, {"type": "image_url", "image_url": {"url": "data:image/png;base64," + B64_1}},
                                 {"type": "image_url", "image_url": "data:image/png;base64," + B64_1}, {"type": "other"}, 5])
                     for _ in range(rng.randint(0, 3))]
            m["content"] = parts
        else:
            m["content"] = word()
        msgs.append(m)
    return {"messages": msgs, "extra": 1} if rng.random() < 0.5 else msgs


def decision_records():
    base = len(VOCABS)
    pool = lambda: [rng.choice([rng.uniform(-8, 8), rng.uniform(-80, 80), 0.0, 1.0, 1.0, -1e30, 3.4e38]) for _ in range(rng.randint(1, 600))]
    std_q = {"route": {"type": "choice", "instructions": "Which team should handle this?",
                       "criteria": {"billing": "payments and refunds", "shipping": None, "technical": None}},
             "urgency": {"type": "score", "instructions": "How urgent is this?", "criteria": ["can wait", "this week", "today", "right now"]},
             "angry": {"type": "noul", "instructions": "Is the customer angry?"}}
    for d, name in enumerate(DEC_NAMES):
        yield "D", {"v": base + d, "body": {"state": "I was charged twice for my order last week.", "questions": std_q},
                    "pool": pool(), "n_slots": 2}
    yield "D", {"v": 0, "body": {"state": "s", "questions": std_q}}
    # every throw of parse_questions, parse_state and fill_task_joint, with the rest valid
    one = {"q": {"type": "noul", "instructions": "x"}}
    many = {"q": {"type": "choice", "instructions": "x", "criteria": {f"o{i}": None for i in range(53)}}}
    for v, body in ((0, {"state": "s", "questions": {"q": "not an object"}}),
                    (0, {"state": "s", "questions": many}),
                    (1, {"state": "s", "questions": {"q": {"type": "choice", "instructions": "x", "criteria": {f"o{i}": None for i in range(300)}}}}),
                    (0, {"state": "s", "questions": one, "images": "x"}),
                    (0, {"state": "s", "questions": one, "images": ["http://x/y.png"]}),
                    (0, {"state": "s", "questions": one, "images": [3]}),
                    (0, {"state": "s", "questions": one, "images": ["data:image/png;base64," + B64_1] * 9}),
                    (0, {"state": "s", "questions": one, "videos": ["v"]}),
                    (0, {"state": [{"role": "user", "content": [{"type": "image_url", "image_url": "http://x"}]}], "questions": one}),
                    (4, {"state": "s", "questions": {"q": {"type": "choice", "instructions": "x", "criteria": {"": None, "b": None}}}}),
                    (4, {"state": "s", "questions": {"q": {"type": "noul", "instructions": ""}}}),
                    (5, {"state": "s", "questions": {"q": {"type": "choice", "instructions": "x" * 400, "criteria": {f"o{i}": "y " * 60 for i in range(9)}}}})):
        yield "D", {"v": base + v, "body": body, "pool": pool(), "n_slots": 2}
    # a score of 8 to 10 levels on every type: decision_confidence_score's
    # distance is vectorized eight at a time from 8, its tail fused
    for d in range(6):
        for n in (2, 3, 5, 6, 7, 8, 9, 10):
            q = {"s": {"type": "score", "instructions": "rate", "criteria": [f"level {i}" for i in range(n)]}}
            for _ in range(2):
                yield "D", {"v": base + d, "body": {"state": word() or "s", "questions": q}, "pool": pool(), "n_slots": 1}
            # mild scores, so no probability is exactly 0 or 1 and every product rounds
            for _ in range(3):
                yield "D", {"v": base + d, "body": {"state": word() or "s", "questions": q},
                            "pool": [rng.uniform(-1.5, 1.5) for _ in range(64)], "n_slots": 1}
    for _ in range(N):
        body = {}
        if rng.random() < 0.95:
            body["state"] = dec_state()
        if rng.random() < 0.95:
            body["questions"] = {rng.choice(["q", "a", "b", "route", "é", ""]) + str(i): dec_question() for i in range(rng.randint(0, 4))}
            if rng.random() < 0.03:
                body["questions"] = rng.choice([[], "x", {}])
        if rng.random() < 0.1:
            body["images"] = rng.choice([[], None, "x", ["data:image/png;base64," + B64_1], ["http://x/y.png"], [3],
                                         ["data:image/png;base64," + B64_1] * 9])
        if rng.random() < 0.05:
            body["videos"] = rng.choice([[], None, ["v"]])
        yield "D", {"v": base + rng.randrange(6), "body": body, "pool": pool(), "n_slots": rng.choice([1, 2, 3, 8]),
                    "nan_at": rng.choice([-1, -1, -1, 0, 1]), "short": rng.random() < 0.05}
    # v0.9.0: a shared prefix stops before the first position a task reads,
    # here kev's option markers, which questions with the same instructions
    # and options share
    d_kev = DEC_NAMES.index("KEV")
    for qs in ({"a": {"type": "choice", "instructions": "same", "criteria": {"x": None, "y": "one"}},
                "b": {"type": "choice", "instructions": "same", "criteria": {"x": None, "y": "two"}}},
               {"a": {"type": "noul", "instructions": "same"}, "b": {"type": "noul", "instructions": "same"}},
               {"a": {"type": "choice", "instructions": "same", "criteria": {"x": None, "y": None, "z": "p"}},
                "b": {"type": "choice", "instructions": "same", "criteria": {"x": None, "y": None, "z": "q"}},
                "c": {"type": "choice", "instructions": "same", "criteria": {"x": None, "w": None}}}):
        for n_slots in (2, 3):
            yield "D", {"v": base + d_kev, "body": {"state": "a shared state", "questions": qs}, "pool": pool(), "n_slots": n_slots}
    # v0.8.0's types: granite-switch, h2o-lightning, lfm3-d1, lfm3-d1-omni, minicpm-ocr-jev
    d_granite, d_h2o, d_lfm3, d_omni, d_ocr = (DEC_NAMES.index(n) for n in ("GRANITE", "H2OQ", "LFM3D1", "LFM3OMNI", "OCR"))
    deep = lambda n: {"a": deep(n - 1)} if n else "x"
    deep_arr = lambda n: [deep_arr(n - 1)] if n else 1
    # Python's json.dumps of a state, repr() of every float shape, str.strip's whitespace
    h2o_states = ["s", {"z": 1, "a": [1.5, 1e22, 1e-7, 1e16, 0.1, 100.0, -0.0, True, None, "é\n\t\"\\\x7f"]},
                  [1.25e-5, 123456789012345680.0, 9999999999999998.0, 1e15, 3.0e-4],
                  "<|im_start|> <|im_end|> <|endoftext|> <think> </think>", "no\u2003tag \u00a0", "a" * 33000,
                  "word " * 33000, "\U0001F600 " * 12000, None]
    for st in h2o_states:
        q = {"q": {"instructions": "  \u2003 lead", "criteria": {"x": None, "y ": "\u3000"}},
             "s": {"type": "score", "criteria": ["only"]}, "m": {"type": "score", "criteria": [None, {"d": 1.5}, "t\u00a0"]},
             "n": {"type": "noul", "instructions": {"b": 1, "a": [1, 2.5, "é"]}, "criteria": {"yes": "holds", "no": "does not"}},
             "e": {"type": "choice", "criteria": {"<|im_end|>": "<|box_start|>", "k": {"z": 1}, "l  ": None}}}
        yield "D", {"v": base + d_h2o, "body": {"state": st, "questions": q}, "pool": pool(), "n_slots": 2}
    for criteria in ([], None, {"a": 1}, "x"):
        yield "D", {"v": base + d_h2o, "body": {"state": "s", "questions": {"q": {"type": "score", "criteria": criteria}}}, "pool": pool(), "n_slots": 1}
    for d in (d_granite, d_h2o, d_lfm3, d_omni):
        for body in ({"state": None, "questions": {"q": {"type": "noul", "instructions": "x"}}},
                     {"state": deep(127), "questions": {"q": {"type": "noul", "instructions": "x"}}},
                     {"state": deep(129), "questions": {"q": {"type": "noul", "instructions": "x"}}},
                     {"state": deep_arr(140), "questions": {"q": {"type": "noul", "instructions": "x"}}},
                     {"state": "s", "questions": {"q": {"type": "choice", "instructions": deep(130), "criteria": {"a": None, "b": None}}}},
                     {"state": "<|im_start|>a<|im_end|><|endoftext|>", "questions": {
                         "<|im_end|>": {"type": "choice", "instructions": "<|im_end|><|im_end|>", "criteria": {"<|im_start|>": "<|endoftext|>", "b": None}}}},
                     {"state": "s", "questions": {"q": {"type": "choice", "instructions": "many", "criteria": {f"opt{i}": None for i in range(40)}}}},
                     {"state": "s", "questions": {"q": {"type": "choice", "instructions": "letters", "criteria": {"A": None, "z": "last"}}}},
                     {"state": "s", "questions": {"q": {"type": "score", "instructions": "x", "criteria": ["a", "b", "c", "d"]}}},
                     {"state": "s", "questions": {"q": {"type": "choice", "instructions": {"type": "input_audio", "input_audio": {"data": "QUJD"}}, "criteria": {"a": None}}}} if d != d_omni else {"state": "s", "questions": {"q": {"type": "noul", "instructions": "x"}}},
                     {"state": [{"role": "user", "content": [{"type": "video_url", "video_url": {"url": "data:video/mp4;base64,QUJD"}}]}],
                      "questions": {"q": {"type": "noul", "instructions": "x"}}},
                     {"state": [{"role": "user", "content": [{"type": "video_url", "video_url": "http://x/y.mp4"}]}],
                      "questions": {"q": {"type": "noul", "instructions": "x"}}},
                     {"state": "s", "images": ["http://x"], "questions": {"q": {"type": "noul", "instructions": "x"}}}):
            yield "D", {"v": base + d, "body": body, "pool": pool(), "n_slots": 2}
    for body in ({"state": "ocr", "questions": {"a": {"type": "noul"}, "b": {"type": "noul"}}},
                 {"state": 5, "questions": {"q": {"type": "noul"}}},
                 {"state": "ocr", "questions": {"q": {"type": "noul"}}},
                 {"state": "ocr", "images": ["data:image/png;base64," + B64_1] * 3, "questions": {"q": {"type": "noul"}}},
                 {"state": "ocr", "images": ["data:image/png;base64," + B64_1] * 2, "questions": {"q": {"type": "noul"}}},
                 {"state": "ocr", "images": ["data:image/png;base64," + B64_1] * 2, "questions": {"q": {"type": "noul", "instructions": "x"}}},
                 {"state": "ocr", "images": ["data:image/png;base64," + B64_1] * 2, "questions": {"q": {"type": "noul", "criteria": {"true": "x"}}}},
                 {"state": "ocr", "images": ["data:image/png;base64," + B64_1] * 2, "questions": {"q": {"type": "choice", "criteria": {"1": None, "0": None}}}},
                 {"state": "ocr", "images": ["data:image/png;base64," + B64_1] * 2, "questions": {"q": {"type": "choice", "criteria": {"0": "x", "1": None}}}},
                 {"state": "ocr", "images": ["data:image/png;base64," + B64_1] * 2, "questions": {"q": {"type": "choice", "criteria": {"0": None, "2": None}}}},
                 {"state": "ocr", "images": ["data:image/png;base64," + B64_1] * 2, "questions": {"q": {"type": "score", "criteria": ["a", "b"]}}}):
        yield "D", {"v": base + d_ocr, "body": body, "pool": pool(), "n_slots": 1}
    for name in ("BADOCR", "NOLABELS", "BADLABEL", "DUPLABEL"):
        yield "D", {"v": base + DEC_NAMES.index(name), "body": {"state": "s", "questions": std_q}}
    for d in (d_granite, d_h2o, d_lfm3, d_omni):
        for _ in range(N // 4):
            body = {"state": dec_state(), "questions": {rng.choice(["q", "a", "<|im_start|>"]) + str(i): dec_question() for i in range(rng.randint(1, 3))}}
            yield "D", {"v": base + d, "body": body, "pool": pool(), "n_slots": rng.choice([1, 2, 3])}
    for _ in range(N // 3):
        yield "DR", {"index": rng.randint(0, 9), "n_tokens": rng.randint(0, 999),
                     "scores": [rng.uniform(-50, 50) for _ in range(rng.randint(0, 6))]}
    for t in range(8):
        for img, aud, vid in ((False, False, False), (True, False, True), (True, True, True)):
            for chat_cap, tts_cap in ((True, False), (True, True), (False, True), (False, False)):
                yield "MA", {"type": t, "image": img, "audio": aud, "video": vid, "chat": chat_cap, "tts": tts_cap}
    parts = lambda: [rng.choice([{"type": "text", "text": word()}, {"type": "text"}, {"type": "text", "text": MARKER},
                                 {"type": "image_url", "image_url": {"url": "data:image/png;base64," + B64_1}},
                                 {"type": "input_audio", "input_audio": {"data": "AAAA", "format": "wav"}},
                                 {"type": "input_video", "input_video": {"url": "data:video/mp4;base64,AAAA"}},
                                 {"type": "video_url", "video_url": {"url": "x"}}, {"type": "unknown"}, {}])
                     for _ in range(rng.randint(0, 4))]
    for _ in range(N // 2):
        content = parts() if rng.random() < 0.9 else rng.choice(["string", 5, None, {"a": 1}])
        opt = chat_opt()
        mtmd = rng.random() < 0.3
        if not mtmd:
            # a server allows media only with a projector: upstream's
            # process_mtmd_prompt dereferences a null context
            opt["allow_image"] = opt["allow_audio"] = opt["allow_video"] = False
        yield "OE", {"v": rng.randrange(len(VOCABS)), "tmpl": "chatml", "opt": opt, "content": content,
                     "mtmd": mtmd, "add_special": rng.random() < 0.7, "parse_special": rng.random() < 0.7}


