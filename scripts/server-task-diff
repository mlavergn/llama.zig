def rand_params():
    d = {}
    for _ in range(rng.randint(0, 6)):
        k = rng.choice(FIELD_NAMES)
        d[k] = rng.choice(FIELDS[k]) if rng.random() < 0.8 else junk()
    return d


def chat_message(p):
    role = rng.choice(["system", "user", "assistant", "tool", "user", "user"])
    m = {"role": role}
    r = rng.random()
    if r < 0.5:
        m["content"] = word()
    elif r < 0.85:
        parts = []
        for _ in range(rng.randint(0, 3)):
            t = rng.random()
            if t < 0.6:
                parts.append({"type": "text", "text": word()})
            elif t < 0.75:
                parts.append({"type": "image_url", "image_url": {"url": rng.choice([
                    "data:image/png;base64," + B64_1, B64_2, "data:image/png;base64,", "data:text/plain;base64,QQ==",
                    "data:image/png," + B64_1, "data:image/png;base64,a,b", "file://img1.png", "file://../x.png",
                    "file://missing.png", "file://sub/img2.png", "!!!", "file://", "QUJD-REVG", "-QUJD"])}})
            elif t < 0.85:
                parts.append({"type": "input_audio", "input_audio": {"data": "UklGRg==", "format": "wav"}})
            elif t < 0.87:
                parts.append({"type": "input_video", "input_video": {"url": B64_1}})
            elif t < 0.9:
                # v0.5.0: "video_url" is an alias of "input_video", under its own key
                parts.append(rng.choice([{"type": "video_url", "video_url": {"url": B64_1}},
                                         {"type": "video_url", "video_url": {"data": B64_1}, "input_video": {"url": "x"}},
                                         {"type": "video_url", "input_video": {"url": B64_1}}]))
            else:
                parts.append({"type": rng.choice(["bogus", "media_marker", 3]), "text": "x"})
        m["content"] = parts
    elif r < 0.92:
        m["content"] = None
    if role == "assistant" and rng.random() < 0.3:
        m["tool_calls"] = [{"type": "function", "id": "c1", "function": {"name": "f", "arguments": "{}"}}]
    if rng.random() < p:
        rng.choice([lambda: m.pop("content", None), lambda: m.__setitem__("content", junk()),
                    lambda: m.__setitem__("role", junk())])()
    return m


def chat_body():
    msgs = [chat_message(0.15) for _ in range(rng.randint(0, 4))]
    b = {"messages": msgs if rng.random() > 0.05 else junk()}
    if rng.random() < 0.05:
        b.pop("messages")
    for _ in range(rng.randint(0, 4)):
        k = rng.choice(["stop", "response_format", "json_schema", "grammar", "chat_template_kwargs",
                        "reasoning_effort", "logprobs", "top_logprobs", "continue_final_message",
                        "add_generation_prompt", "tools", "tool_choice", "stream", "reasoning_format",
                        "reasoning_budget_tokens", "thinking_budget_tokens", "parallel_tool_calls", "n_predict",
                        "max_tokens", "temperature", "model"])
        b[k] = rng.choice({
            "stop": ["x", ["a", "b"], None, 5],
            "response_format": [{"type": "json_object"}, {"type": "json_object", "schema": {"type": "string"}},
                                {"type": "json_schema", "json_schema": {"schema": {"type": "integer"}}},
                                {"type": "text"}, {"type": "xml"}, {"type": 3}, "x", {}],
            "json_schema": [{"type": "object"}, {}, None, "x"],
            "grammar": ["root ::= \"x\"", ""],
            "chat_template_kwargs": [{"enable_thinking": True}, {"enable_thinking": "false"}, {"enable_thinking": False},
                                     {"a": [1, 2]}, [1, 2], "x"],
            "reasoning_effort": ["none", "high", "", 3],
            "logprobs": [True, False, "x"], "top_logprobs": [3, None, "x"],
            "continue_final_message": [True, "content", False],
            "add_generation_prompt": [False, True, "x"],
            "tools": [[{"type": "function", "function": {"name": "f"}}], [], {"a": 1}, "x"],
            "tool_choice": ["auto", "none", "required", 3],
            "stream": [True, False], "reasoning_format": ["none", "deepseek", "bogus", 3],
            "reasoning_budget_tokens": [10, "x"], "thinking_budget_tokens": [5, "y"],
            "parallel_tool_calls": [True, "x"], "n_predict": [3], "max_tokens": [7],
            "temperature": [0.1], "model": ["m", 3],
        }[k])
    return b


def chat_opt():
    o = {"prefill_assistant": rng.random() < 0.7, "reasoning_format": rng.randint(0, 3),
         "allow_image": rng.random() < 0.7, "allow_audio": rng.random() < 0.3, "allow_video": rng.random() < 0.2}
    if rng.random() < 0.5:
        o["media_path"] = MEDIA_DIR
    if rng.random() < 0.3:
        o["kwargs"] = rng.choice([{"enable_thinking": "true"}, {"enable_thinking": "\"yes\""}, {"x": "1"}])
    if rng.random() < 0.3:
        o["reasoning_budget"] = rng.choice([-1, 5])
        o["reasoning_budget_message"] = "msg"
    if rng.random() < 0.2:
        o["enable_thinking"] = False
    return o


def results():
    """S states and R results: streams of partials then a final, in every
    response format; then one of every other result type."""
    sid = 0
    for res_type in (0, 1, 2, 3, 4, 6):  # 5, OAI_EMBD, is GGML_ASSERT for a completion
        for stream in (False, True):
            for gp in ("", "<think>"):
                cont = rng.random() < 0.3
                yield "S", {"id": sid, "parser": {"format": 0, "generation_prompt": gp, "is_continuation": cont,
                                                   "echo": rng.random() < 0.5, "reasoning_format": rng.randint(0, 3)}}
                text = ""
                for k in range(rng.randint(0, 4)):
                    piece = word()
                    text += piece
                    f = {"content": piece, "tokens": [rng.randint(0, 99)], "n_decoded": k + 1, "n_prompt_tokens": 7,
                         "n_prompt_tokens_cache": 2, "res_type": res_type, "model": "m", "cmpl_id": "chatcmpl-x",
                         "is_progress": rng.random() < 0.2, "is_begin": k == 0 and rng.random() < 0.2,
                         "post_sampling_probs": rng.random() < 0.5, "verbose": rng.random() < 0.3}
                    if rng.random() < 0.4:
                        f["probs"] = [{"tok": 5, "prob": rng.choice([0.0, 0.5, 1.0]), "text": rng.choice(["a", "\xc3", "é"]),
                                       "probs": [{"tok": 6, "txt": "b\xe2\x82", "prob": 0.25}, {"tok": 7, "txt": "", "prob": 0.0}]}]
                    if rng.random() < 0.4:
                        f["stats"] = {"cached": 2, "processed": 5, "gen": k + 1, "t_start": 1000, "t_prompt": 3000,
                                      "t_gen": 3000 + 500 * k, "draft": rng.choice([0, 1, 3]), "accepted": 1}
                    if f["is_progress"]:
                        f["progress"] = {"total": 10, "cache": 2, "processed": 5, "time_ms": 12}
                    yield "R", {"kind": "partial", "state": sid, "index": 1, "id_slot": 0, "f": f}
                f = {"content": text if rng.random() < 0.8 else word(), "tokens": [1, 2], "stream": stream,
                     "include_usage": rng.random() < 0.5, "prompt": "p", "truncated": rng.random() < 0.2,
                     "n_decoded": 4, "n_prompt_tokens": 9, "n_prompt_tokens_cache": 3, "n_tokens_cached": 12,
                     "has_new_line": True, "stopping_word": rng.choice(["", "###"]), "stop": rng.randint(0, 3),
                     "post_sampling_probs": rng.random() < 0.5, "res_type": res_type, "model": "m",
                     "cmpl_id": "chatcmpl-x", "verbose": rng.random() < 0.3,
                     "response_fields": rng.choice([[], ["content", "generation_settings/seed", "timings/x"]])}
                if rng.random() < 0.5:
                    f["probs"] = [{"tok": 5, "prob": 0.5, "text": "hi", "probs": [{"tok": 6, "txt": "x", "prob": 0.5}]},
                                  {"tok": 9, "prob": 0.0, "text": "\xf0\x9f", "probs": []}]
                if rng.random() < 0.6:
                    f["stats"] = {"cached": 3, "processed": 6, "gen": 4, "t_start": 1000, "t_prompt": 2500,
                                  "t_gen": rng.choice([0, 2500, 9000]), "draft": rng.choice([0, 2]), "accepted": 1}
                yield "R", {"kind": "final", "state": sid, "index": 2, "id_slot": 1, "f": f,
                            "gp": {"v": 0, "data": rand_params()}}
                sid += 1
    for t in range(8):
        yield "R", {"kind": "error", "f": {"type": t, "msg": word(), "n_prompt_tokens": 100, "n_ctx": 64}}
    for rt in (0, 5):
        yield "R", {"kind": "embd", "index": 3, "f": {"embedding": [[0.5, -1.25, 1e-7], [2.0]], "n_tokens": 4, "res_type": rt}}
    yield "R", {"kind": "realtime", "index": 1, "f": {"text": "hi", "audio": [0.5, -0.25], "n_decoded": 2}}
    yield "R", {"kind": "realtime", "f": {"response_done": True, "cancelled": True, "n_decoded": 7}}
    yield "R", {"kind": "tts", "f": {"audio": "RIFF", "sample_rate": 24000}}
    yield "R", {"kind": "tts", "index": 3, "f": {"audio": "", "sample_rate": 16000, "final": True}}
    yield "R", {"kind": "rerank", "index": 1, "f": {"score": 0.125, "n_tokens": 5}}
    yield "R", {"kind": "rerank", "index": 2, "f": {"n_tokens": 5}}
    for m in ({}, {"processing": 2, "deferred": 1, "prompt": [1234567, 1234567, 2500000], "predict": [42, 41, 1000000],
                   "prompt_bucket": [100, 100, 50000], "predict_bucket": [20, 19, 400000], "n_prompt_cached": 7,
                   "n_tokens_max": 2048, "n_decode": 33, "n_busy_slots": 50, "n_draft_tokens": 9,
                   "n_draft_accepted": 4, "n_draft_verif_steps": 3, "per_pos": [4, 0, 12345678901]}):
        yield "R", {"kind": "metrics", "f": m}
    yield "R", {"kind": "slots", "f": {"data": [{"id": 0, "is_processing": False}]}}
    for s in (True, False):
        yield "R", {"kind": "save", "id_slot": 2, "f": {"filename": "a.bin", "is_save": s, "n_tokens": 10, "n_bytes": 4096, "t_ms": 1.5}}
    yield "R", {"kind": "erase", "id_slot": 3, "f": {"n_erased": 17}}
    yield "R", {"kind": "control", "f": {"success": True}}
    yield "R", {"kind": "control", "f": {"success": False, "message": "no such completion"}}
    yield "R", {"kind": "get_lora", "f": {"loras": [{"path": "a.gguf", "scale": 0.5, "task_name": "t", "prompt_prefix": "p"},
                                                     {"path": "b.gguf", "scale": 1.0, "inv": "<x>", "inv_tokens": [1, 2]}]}}
    yield "R", {"kind": "apply_lora"}
    yield "R", {"kind": "router", "f": {"data": {"a": [1, "b"]}}}


def tokens_ops(n, media=False):
    ops = [["pos_next", -1], ["pos_next", 0], ["pos_next", min(n, 3)], ["pos_next", n],
           ["size_up_to_pos", 0], ["size_up_to_pos", 2], ["size_up_to_pos", 5], ["size_up_to_pos", 1000],
           ["size_up_to_pos", -1], ["validate"], ["text"], ["detok", True], ["detok", False], ["clone"],
           ["serialize"], ["serialize", rng.randint(0, 12), rng.randint(0, 10), rng.choice([-1, 0, 2, 7, 1000])],
           ["serialize", 3], ["serialize", 0], ["prefix", [rng.randint(0, 50) for _ in range(rng.randint(0, 6))]],
           ["prefix_self"], ["prefix_self", rng.randint(0, max(n, 1))], ["next_media", 0], ["next_media", 3],
           ["spans", [["user", "<|im_start|>user"], ["assistant", "<|im_start|>assistant"]]],
           ["push_back"], ["push_token", 5], ["push_token", -1], ["insert", [7, 8]],
           ["find_chunk", 0], ["find_chunk", rng.randint(0, max(n, 1))]]
    for _ in range(4):
        ops.append(["keep_first", rng.randint(0, n)])
    if not media:
        ops.append(["set_token", 0 if n else 0, 9] if n else ["text"])
    return ops


def targeted():
    """One record per arm the random ones reach too rarely to count on."""
    P = lambda d, v=0: ("P", {"v": v, "data": d})
    yield P({"preserved_tokens": ["<|im_start|>"], "grammar_triggers": [{"type": 1, "value": "<|im_start|>"}]})
    yield P({"grammar_triggers": [{"type": 1, "value": "<|im_start|>"}]})
    yield P({"grammar_triggers": [{"type": 1, "value": "hello world again"}], "grammar_lazy": True})
    yield P({"grammar_lazy": True, "grammar_triggers": []})
    yield P({"grammar": "root ::= \"a\"", "grammar_type": "tool_calls"})
    yield P({"grammar": "root ::= \"a\"", "json_schema": {"type": "string"}})
    yield P({"json_schema": {"type": "string"}, "grammar": None})
    yield P({"reasoning_budget_end_tags": None, "reasoning_budget_end_tag": "</think>", "reasoning_budget_message": "stop"})
    yield P({"reasoning_budget_end_tags": ["</think>", "x"], "reasoning_budget_message": "Stop thinking now.", "reasoning_budget_start_tag": "<think>"})
    yield P({"reasoning_budget_message": "m"})
    yield P({"stream": True, "reasoning_format": "deepseek-legacy"})
    yield P({"stream": True}, 1)
    yield P({"dry_sequence_breakers": "x"})
    # at most 64 distinct breakers, counted after dropping the duplicates
    yield P({"dry_sequence_breakers": ["b%d" % i for i in range(64)]})
    yield P({"dry_sequence_breakers": ["b%d" % i for i in range(65)]})
    yield P({"dry_sequence_breakers": ["b%d" % (i % 64) for i in range(200)]})
    yield P({"dry_sequence_breakers": ["z", "a", "z", "m", "a"]})
    yield P({"lora": {"id": 1}})
    yield P({"chat_format": 7})
    yield P({"samplers": ["bogus"], "seed": -1})
    yield P({"ignore_eos": True, "logit_bias": [[1, 0.5]]})
    O = lambda b: ("O", b)
    yield O({})
    yield O({"prompt": "x", "echo": True})
    yield O({"prompt": "x", "best_of": 2})
    yield O({"prompt": "x", "suffix": "y"})
    yield O({"prompt": "x", "stop": "s", "max_tokens": 3, "n_predict": 9})

    def C(body, **opt):
        o = {"prefill_assistant": True, "reasoning_format": 0, "allow_image": True, "media_path": MEDIA_DIR}
        o.update(opt)
        return ("C", {"v": 0, "tmpl": "chatml", "opt": o, "body": body})
    u = {"role": "user", "content": "hi"}
    a = {"role": "assistant", "content": "yo"}
    yield C({"messages": [u], "tools": [{"type": "function", "function": {"name": "f"}}]})
    yield C({"messages": [u], "tool_choice": "none"})
    yield C({"messages": [u], "json_schema": {"type": "object"}, "grammar": "root ::= \"x\""})
    yield C({"messages": [u], "response_format": {"type": "xml"}})
    yield C({"messages": [u], "response_format": {"type": "json_schema", "json_schema": {"schema": {"type": "integer"}}}})
    yield C({"messages": [u], "response_format": {"type": "json_object"}, "json_schema": {"type": "string"}})
    yield C({"messages": [u], "response_format": {"type": "json_object", "schema": {"type": "boolean"}}})
    yield C({})
    yield C({"messages": {"a": 1}})
    yield C({"messages": [{"role": "user"}]})
    yield C({"messages": [{"role": "assistant"}]})
    yield C({"messages": [u, {"role": "assistant", "tool_calls": []}]})
    yield C({"messages": [{"role": "user", "content": 5}]})
    yield C({"messages": [{"role": "user", "content": [{"type": "image_url", "image_url": {"url": B64_1}}]}]}, allow_image=False)
    yield C({"messages": [{"role": "user", "content": [{"type": "input_audio", "input_audio": {"data": "UklGRg=="}}]}]})
    yield C({"messages": [{"role": "user", "content": [{"type": "input_video", "input_video": {"data": B64_1}}]}]})
    yield C({"messages": [{"role": "user", "content": [{"type": "video_url", "video_url": {"url": B64_1}}]}]}, allow_video=True)
    yield C({"messages": [{"role": "user", "content": [{"type": "video_url", "video_url": {"data": B64_1}, "input_video": {"url": "x"}}]}]}, allow_video=True)
    yield C({"messages": [{"role": "user", "content": [{"type": "video_url", "video_url": {"url": B64_1}}]}]}, allow_video=False)
    yield C({"messages": [{"role": "user", "content": [{"type": "bogus"}]}]})
    yield C({"messages": [u, a, a]})
    yield C({"messages": [u, a]})
    yield C({"messages": [u, a]}, prefill_assistant=False)
    yield C({"messages": [u], "continue_final_message": True})
    yield C({"messages": [u, {"role": "assistant", "content": "x", "tool_calls": [{"type": "function", "id": "1", "function": {"name": "f", "arguments": "{}"}}]}],
             "continue_final_message": True, "add_generation_prompt": False})
    yield C({"messages": [u], "chat_template_kwargs": {"enable_thinking": "x"}})
    yield C({"messages": [u], "chat_template_kwargs": {"enable_thinking": False}, "reasoning_effort": "none"})
    yield C({"messages": [u], "reasoning_effort": "high"})
