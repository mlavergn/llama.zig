def chat_body_jinja():
    b = chat_body()
    if rng.random() < 0.5:
        b["messages"] = [{"role": "system", "content": "Be brief."}, {"role": "user", "content": word() or "hi"}]
    if rng.random() < 0.5:
        b["tools"] = rng.choice([[TOOL_W], [TOOL_W, TOOL_T], [TOOL_T]])
        b["tool_choice"] = rng.choice(["auto", "required", "none", "auto"])
    if rng.random() < 0.2:
        b["parallel_tool_calls"] = rng.choice([True, False])
    return b


def chat_opt_jinja():
    o = chat_opt()
    o["jinja"] = True
    o.pop("media_path", None)
    if rng.random() < 0.1:
        o["force_pure_content"] = True
    return o


def response_items():
    """Random Responses API input items, valid more often than not."""
    items = []
    for _ in range(rng.randint(0, 5)):
        k = rng.random()
        if k < 0.25:
            it = {"role": rng.choice(["user", "system", "developer", "user"]),
                  "content": rng.choice([word(), [{"type": "input_text", "text": word()}],
                                         [{"type": "input_image", "image_url": B64_1}, {"type": "input_text", "text": "x"}],
                                         [{"type": "input_file"}], [{"type": "input_text"}], [{"type": "bogus"}],
                                         [{"type": "input_image"}], [5]])}
            if rng.random() < 0.3:
                it["type"] = "message"
            if rng.random() < 0.2:
                it["status"] = "completed"
        elif k < 0.45:
            it = {"role": "assistant", "type": "message",
                  "content": rng.choice([word(), [{"type": "output_text", "text": word()}], [{"type": "refusal", "refusal": "no"}],
                                         [{"type": "output_text"}], [{"type": "refusal"}], [{"type": "x"}], 5])}
            if rng.random() < 0.5:
                it["status"] = "completed"
            if rng.random() < 0.3:
                it["id"] = "msg_1"
        elif k < 0.65:
            it = {"type": "function_call", "call_id": "call_" + str(rng.randint(0, 9)), "name": "get_weather",
                  "arguments": rng.choice(["{\"city\":\"Paris\"}", "{}"])}
            if rng.random() < 0.15:
                it.pop(rng.choice(["call_id", "name", "arguments"]))
        elif k < 0.8:
            it = {"type": "function_call_output", "call_id": "call_1",
                  "output": rng.choice(["sunny", [{"type": "input_text", "text": "x"}], [{"type": "text", "text": "y"}], [{}], 5,
                                        # v0.5.0: an image is a tool output too
                                        [{"type": "input_image", "image_url": B64_1}],
                                        [{"type": "input_image", "image_url": "data:image/png;base64," + B64_1, "detail": "auto"},
                                         {"type": "input_text", "text": "z"}],
                                        [{"type": "input_image"}], [{"type": "input_image", "image_url": {"url": "u"}}],
                                        [{"type": 7}]])}
        elif k < 0.92:
            it = {"type": "reasoning", "summary": [],
                  "content": rng.choice([[{"type": "reasoning_text", "text": "thought"}], [], [{"text": 5}], "x", [5]])}
            if rng.random() < 0.1:
                it.pop("content")
        else:
            it = rng.choice([{"type": "bogus"}, 5, "x", {}, {"role": 3, "content": []}])
        items.append(it)
    return items


def responses_body():
    b = {"input": rng.choice([word(), response_items(), response_items(), 5, None, {"a": 1}])}
    if rng.random() < 0.05:
        b.pop("input")
    for _ in range(rng.randint(0, 4)):
        k = rng.choice(["instructions", "previous_response_id", "tools", "max_output_tokens", "reasoning", "model",
                        "stream", "temperature", "max_tokens", "messages", "extra_params"])
        b[k] = rng.choice({
            "instructions": ["Be brief.", 5, None, ""],
            "previous_response_id": ["", "resp_1", None, 3],
            "tools": [[{"type": "function", "name": "f", "parameters": {"type": "object"}}],
                      [{"type": "web_search"}, {"type": "function", "name": "g", "strict": False}], [5], "x", []],
            "max_output_tokens": [16, "x", None],
            "reasoning": [{"effort": "low"}, {"effort": None}, {}, "x", {"summary": "auto"}],
            "model": ["m"], "stream": [True, False], "temperature": [0.5], "max_tokens": [3], "messages": [[]],
            "extra_params": [{"seed": 3}, {"max_tokens": 5, "top_k": 2}, {}, 5, None],
        }[k])
    return b


def anthropic_content():
    blocks = []
    for _ in range(rng.randint(0, 4)):
        blocks.append(rng.choice([
            {"type": "text", "text": word()},
            {"type": "thinking", "thinking": "hmm", "signature": "s"},
            {"type": "thinking"},
            {"type": "image", "source": {"type": "base64", "media_type": "image/png", "data": B64_1}},
            {"type": "image", "source": {"type": "base64", "data": "QUJD"}},
            {"type": "image", "source": {"type": "url", "url": "http://x/y.png"}},
            {"type": "image", "source": {"type": "file"}},
            {"type": "image"},
            {"type": "tool_use", "id": "toolu_1", "name": "get_weather", "input": {"city": "Paris"}},
            {"type": "tool_use", "name": "f"},
            {"type": "tool_result", "tool_use_id": "toolu_1", "content": "sunny"},
            {"type": "tool_result", "tool_use_id": "toolu_1", "content": [{"type": "text", "text": "a"}, {"type": "text", "text": "b"}]},
            {"type": "tool_result", "tool_use_id": "toolu_2", "content": [{"type": "text", "text": "a"},
                                                                          {"type": "image", "source": {"type": "url", "url": "u"}}]},
            {"type": "tool_result", "tool_use_id": "toolu_3", "content": [{"type": "image", "source": {"type": "base64", "data": "QQ=="}}]},
            {"type": "tool_result", "tool_use_id": "toolu_4"},
            {"type": "tool_result", "content": 5},
            {"type": "bogus"}, 5,
        ]))
    return blocks


def anthropic_body():
    msgs = []
    for _ in range(rng.randint(0, 4)):
        m = {"role": rng.choice(["user", "assistant", "user"])}
        r = rng.random()
        if r < 0.3:
            m["content"] = word()
        elif r < 0.85:
            m["content"] = anthropic_content()
        elif r < 0.92:
            m["content"] = rng.choice([5, None, {"a": 1}])
        msgs.append(m)
    b = {"messages": msgs if rng.random() > 0.05 else rng.choice([5, "x", {}])}
    if rng.random() < 0.05:
        b.pop("messages")
    for _ in range(rng.randint(0, 5)):
        k = rng.choice(["system", "tools", "tool_choice", "stop_sequences", "max_tokens", "temperature", "top_p", "top_k",
                        "stream", "chat_template_kwargs", "thinking", "metadata", "model"])
        b[k] = rng.choice({
            "system": ["You are helpful.", [{"type": "text", "text": "A"}, {"type": "text", "text": "B"}, {"type": "image"}],
                       "x-anthropic-billing-header: cc_version=2.1; cc_entrypoint=cli; cch=a5145;You are Claude",
                       "x-anthropic-billing-header: cch=a51", "x-anthropic-billing-header: no stamp",
                       [{"type": "text", "text": "x-anthropic-billing-header: cch=12345;rest"}], 5, None, {}],
            "tools": [[{"name": "get_weather", "description": "w", "input_schema": {"type": "object"}}], [{"name": "f"}], [5], "x"],
            "tool_choice": [{"type": "auto"}, {"type": "any"}, {"type": "tool", "name": "f"}, {"type": "none"}, "auto", {}],
            "stop_sequences": [["\n\n"], "x", []], "max_tokens": [10, None, "x"], "temperature": [0.2], "top_p": [0.9],
            "top_k": [5], "stream": [True, False], "chat_template_kwargs": [{"enable_thinking": False}],
            "thinking": [{"type": "enabled", "budget_tokens": 50}, {"type": "enabled"}, {"type": "disabled"},
                         {"type": "enabled", "budget_tokens": "x"}, "x"],
            "metadata": [{"user_id": "u1"}, {"user_id": ""}, {}, 5], "model": ["claude"],
        }[k])
    return b


def chat_step4():
    u = {"role": "user", "content": "What is the weather in Paris?"}
    # Jinja over every template: tools, choice, schemas, reasoning, kwargs
    for t in TEMPLATES:
        path = os.path.join(TEMPLATES_DIR, t)
        for k in range(3):
            body = {"messages": [{"role": "system", "content": "Be brief."}, u]} if k == 0 else chat_body_jinja()
            if k == 0:
                body["tools"] = [TOOL_W]
            yield "C", {"v": 0, "tmpl_file": path, "opt": chat_opt_jinja(), "body": body}
    for _ in range(N // 2):
        yield "C", {"v": rng.choice([0, 0, 1]), "tmpl_file": os.path.join(TEMPLATES_DIR, rng.choice(TEMPLATES)),
                    "opt": chat_opt_jinja(), "body": chat_body_jinja()}
    q3 = os.path.join(TEMPLATES_DIR, "Qwen-Qwen3-0.6B.jinja")
    J = lambda **o: dict({"jinja": True, "prefill_assistant": True}, **o)
    for body, opt in (
        ({"messages": [u], "tools": [TOOL_W], "grammar": "root ::= \"x\""}, J()),
        ({"messages": [u], "tools": [TOOL_W], "tool_choice": "required", "parallel_tool_calls": True}, J()),
        ({"messages": [u], "tools": [TOOL_W], "logprobs": True, "stream": True}, J()),
        ({"messages": [u], "response_format": {"type": "json_schema", "json_schema": {"schema": {"type": "object", "properties": {"a": {"type": "integer"}}}}}}, J()),
        ({"messages": [u], "reasoning_format": "deepseek"}, J()),
        ({"messages": [u], "reasoning_format": "none", "chat_template_kwargs": {"enable_thinking": False}}, J()),
        ({"messages": [u], "reasoning_budget_tokens": 5, "reasoning_control": True}, J(reasoning_budget=3, reasoning_budget_message="enough")),
        ({"messages": [u], "thinking_budget_tokens": 7}, J()),
        ({"messages": [u, {"role": "assistant", "content": "It is"}]}, J()),
        ({"messages": [u, {"role": "assistant", "content": "<think>x"}], "continue_final_message": "reasoning_content", "add_generation_prompt": False}, J()),
        ({"messages": [u], "chat_template_kwargs": {"enable_thinking": "no"}}, J()),
        ({"messages": [u]}, J(kwargs={"enable_thinking": "false"})),
        ({"messages": [u]}, J(enable_thinking=False)),
        ({"messages": [u], "tools": [TOOL_W]}, J(force_pure_content=True)),
        ({"messages": [u], "tools": [{"type": "function", "function": {"name": "f", "parameters": {"type": "object", "properties": {"x": {"type": "bogus"}}}}}]}, J()),
    ):
        yield "C", {"v": 0, "tmpl_file": q3, "opt": opt, "body": body}
    # kwargs a template reads: gpt-oss's reasoning_effort, and one no
    # template knows (it must still reach the context)
    oss = os.path.join(TEMPLATES_DIR, "openai-gpt-oss-120b.jinja")
    for body, opt in (({"messages": [u], "reasoning_effort": "high"}, J()),
                      ({"messages": [u], "chat_template_kwargs": {"reasoning_effort": "low"}}, J()),
                      ({"messages": [u]}, J(kwargs={"reasoning_effort": "\"medium\""})),
                      ({"messages": [u], "chat_template_kwargs": {"builtin_tools": ["browser"]}}, J())):
        yield "C", {"v": 0, "tmpl_file": oss, "opt": opt, "body": body}
    # parsed streams: a chat request's state fed a reply in pieces
    sid = 1000
    for t in CS_TEMPLATES:
        path = os.path.join(TEMPLATES_DIR, t)
        for _ in range(3):
            body = {"messages": [u], "tools": rng.choice([[TOOL_W, TOOL_T], [TOOL_W], []])}
            if rng.random() < 0.3:
                body["tool_choice"] = "required"
            if rng.random() < 0.3:
                body["reasoning_format"] = rng.choice(["none", "deepseek", "auto", "deepseek-legacy"])
            if rng.random() < 0.3:
                body["stream"] = True
            if rng.random() < 0.2:
                body["messages"] = [u, {"role": "assistant", "content": "Well"}]
            yield "CS", {"v": 0, "tmpl_file": path, "opt": J(reasoning_format=rng.randint(0, 3)), "body": body, "id": sid}
            reply = rng.choice(REPLIES)
            res_type = rng.choice([1, 1, 3, 6, 0])
            stream = rng.random() < 0.6
            # v0.7.0: the session parses text and tokens; a tokenized
            # chunk carries the tokens common_chat_input_tokenize gives
            tok = rng.random() < 0.5
            pos = 0
            k = 0
            while pos < len(reply):
                n = rng.randint(1, 12)
                piece = reply[pos:pos + n]
                pos += n
                k += 1
                yield "R", {"kind": "partial", "state": sid, "index": 0, "v": 0, "f": {"content": piece, "n_decoded": k, "res_type": res_type,
                                                                                      "model": "m", "cmpl_id": "chatcmpl-x", "tokenize": tok}}
            yield "R", {"kind": "final", "state": sid, "index": 0, "v": 0, "f": {"content": "" if stream and tok else reply, "stream": stream, "res_type": res_type,
                                                                                "stop": rng.choice([1, 1, 2, 3]), "model": "m",
                                                                                "cmpl_id": "chatcmpl-x", "n_decoded": k, "tokenize": tok}}
            sid += 1
    # each family's own syntax, so its mapper reads tool calls
    own = {"google-gemma-4-31B-it.jinja": REPLIES[13], "MiniMax-M3.jinja": REPLIES[14], "Qwen-Qwen3-0.6B.jinja": REPLIES[4]}
    for t, reply in own.items():
        for stream in (False, True):
            yield "CS", {"v": 0, "tmpl_file": os.path.join(TEMPLATES_DIR, t), "opt": J(reasoning_format=3),
                         "body": {"messages": [u], "tools": [TOOL_W, TOOL_T], "parallel_tool_calls": True}, "id": sid}
            for k, pos in enumerate(range(0, len(reply), 5)):
                yield "R", {"kind": "partial", "state": sid, "index": 0, "v": 0, "f": {"content": reply[pos:pos + 5], "n_decoded": k + 1,
                                                                                      "res_type": 1, "model": "m", "cmpl_id": "chatcmpl-x", "tokenize": stream}}
            yield "R", {"kind": "final", "state": sid, "index": 0, "v": 0, "f": {"content": "" if stream else reply, "stream": stream, "res_type": 1,
                                                                                "stop": 1, "model": "m", "cmpl_id": "chatcmpl-x", "tokenize": stream}}
            sid += 1
    # an explicit continuation: the state's first parse, of nothing, through
    # the request's own parser, so the prefill is not sent again
    for t in ("Qwen-Qwen3-0.6B.jinja", "Qwen3.5-4B.jinja", "google-gemma-4-31B-it.jinja", "openai-gpt-oss-120b.jinja"):
        for cont, last, echo in (("content", {"role": "assistant", "content": "The weather"}, False),
                                 (True, {"role": "assistant", "content": "The weather"}, True),
                                 ("reasoning_content", {"role": "assistant", "content": "", "reasoning_content": "I think"}, False)):
            yield "CS", {"v": 0, "tmpl_file": os.path.join(TEMPLATES_DIR, t), "opt": J(reasoning_format=3),
                         "body": {"messages": [u, last], "continue_final_message": cont, "add_generation_prompt": False, "echo": echo},
                         "id": sid}
            for k, piece in enumerate([" is", " sunny</think>", "\n\nYes."]):
                yield "R", {"kind": "partial", "state": sid, "index": 0, "f": {"content": piece, "n_decoded": k + 1, "res_type": 1,
                                                                              "model": "m", "cmpl_id": "chatcmpl-x"}}
            yield "R", {"kind": "final", "state": sid, "index": 0, "f": {"content": " is sunny</think>\n\nYes.", "stream": True,
                                                                        "res_type": 1, "stop": 1, "model": "m", "cmpl_id": "chatcmpl-x"}}
            sid += 1
    # v0.7.0: the session's additional stops reach the task's antiprompt
    # (server_task::apply_chat_session), and the request's own sampler keys
    # the session owns are dropped from the parameters
    for t in ("inclusionai-ling-3.0-flash.jinja", "ibm-granite-granite-4.1.jinja", "poolside-Laguna-XS-2.1.jinja"):
        yield "CS", {"v": 0, "tmpl_file": os.path.join(TEMPLATES_DIR, t), "opt": J(reasoning_format=3),
                     "body": {"messages": [u], "tools": [TOOL_W], "stop": ["###"]}, "id": sid}
        yield "R", {"kind": "final", "state": sid, "index": 0, "v": 0, "f": {"content": "Sure.", "res_type": 1, "stop": 1,
                                                                            "model": "m", "cmpl_id": "chatcmpl-x"}}
        sid += 1
    for extra in ({"preserved_tokens": ["<|im_start|>"]}, {"grammar_triggers": [{"type": 1, "value": "hello"}], "grammar_lazy": True},
                  {"grammar_lazy": True}, {"grammar": "root ::= \"a\""}, {"json_schema": {"type": "string"}},
                  {"preserved_tokens": ["<|im_start|>"], "grammar_triggers": [{"type": 1, "value": "<|im_start|>"}]}):
        for tools in ([], [TOOL_W]):
            body = {"messages": [u], **extra}
            if tools:
                if "grammar" in extra:
                    continue
                body["tools"] = tools
            yield "CS", {"v": 0, "tmpl_file": q3, "opt": J(reasoning_format=3), "body": body, "id": sid}
            sid += 1
    # every response format over a reply with reasoning and two tool calls
    for res_type in (0, 1, 3, 6):
        for stream in (False, True):
            yield "CS", {"v": 0, "tmpl_file": q3, "opt": J(reasoning_format=3), "body": {"messages": [u], "tools": [TOOL_W, TOOL_T]}, "id": sid}
            reply = REPLIES[4]
            k = 0
            for pos in range(0, len(reply), 7):
                k += 1
                yield "R", {"kind": "partial", "state": sid, "index": 0, "f": {"content": reply[pos:pos + 7], "n_decoded": k,
                                                                              "res_type": res_type, "model": "m", "cmpl_id": "chatcmpl-x"}}
            yield "R", {"kind": "final", "state": sid, "index": 0, "f": {"content": reply, "stream": stream, "res_type": res_type,
                                                                        "stop": 1, "model": "m", "cmpl_id": "chatcmpl-x", "n_decoded": k}}
            sid += 1
    # the Responses API
    for b in ({}, {"input": "hi"}, {"input": "hi", "previous_response_id": "resp_1"}, {"input": "hi", "previous_response_id": ""},
              {"input": 5}, {"input": None}, {"input": "hi", "instructions": "Be brief.", "max_output_tokens": 8, "reasoning": {"effort": "high"}},
              {"input": [{"role": "user", "content": "a"}, {"role": "assistant", "type": "message", "content": [{"type": "output_text", "text": "b"}]},
                         {"type": "function_call", "call_id": "c1", "name": "f", "arguments": "{}"},
                         {"type": "reasoning", "summary": [], "content": [{"type": "reasoning_text", "text": "r"}]},
                         {"type": "function_call_output", "call_id": "c1", "output": "ok"}]},
              {"input": [{"type": "function_call", "call_id": "c1", "name": "f", "arguments": "{}"},
                         {"role": "assistant", "type": "message", "content": "plain"}]},
              {"input": "x", "tools": [{"type": "function", "name": "f"}, {"type": "web_search"}, {"type": 3}]},
              {"input": "x", "tools": {"a": 1}}, {"input": "x", "tools": []}, [1, 2], "x",
              # v0.9.0: the members of extra_params merged into the converted body, over what it set
              {"input": "hi", "extra_params": {"seed": 7, "min_p": 0.5, "model": "x"}},
              {"input": "hi", "max_output_tokens": 8, "reasoning": {"effort": "low"},
