#!/usr/bin/env python3
"""Regenerate the flag list in `cli/upstream_flags.zig` from `common/arg.cpp`.

**Not a port.** Every string in every `common_arg` constructor's flag list,
sorted and deduplicated, exactly as the recipe in that file's header lists
them -- the spaces inside the braces matter, or `{ "-fit", "--fit" }` and its
fifteen siblings are missed. The provenance line is stamped with the pin.

Usage: scripts/gen-upstream-flags
"""
import os
import re

from upstream_pin import COMMIT, TAG

ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
ARG = os.path.join(ROOT, "llama.cpp/common/arg.cpp")
OUT = os.path.join(ROOT, "cli/upstream_flags.zig")

flags = set()
for group in re.findall(r'\{ *"[-a-zA-Z0-9_]+"(?: *, *"[^"]+")* *\}', open(ARG).read()):
    for f in re.findall(r'"([^"]+)"', group):
        if f.startswith("-"):
            flags.add(f)
# `sort -u` in the C locale: byte order
flags = sorted(flags)

z = open(OUT).read()
start = z.index("pub const all = [_][]const u8{\n") + len("pub const all = [_][]const u8{\n")
end = z.index("\n};", start)
rows = []
for i in range(0, len(flags), 4):
    rows.append("    " + " ".join('"%s",' % f for f in flags[i:i + 4]))
z = z[:start] + "\n".join(rows) + z[end:]
z = re.sub(r"`llama\.cpp/common/arg\.cpp` \(v[\d.]+,\n//! `\w+`\)", "`llama.cpp/common/arg.cpp` (%s,\n//! `%s`)" % (TAG, COMMIT), z)
open(OUT, "w").write(z)
print("%d flags -> %s" % (len(flags), OUT))
